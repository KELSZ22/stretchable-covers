<div class="image-row" style="--section-background: {{ section.settings.background }};">
    <div class="image-row-grid">
        {% for block in section.blocks %}
            <div class="image-row__block">
                <img src="{{ block.settings.image | image_url}}" width="512" height="512">
                <div>
                    <strong>{{ block.settings.heading }}</strong>
                    <p>{{ block.settings.description }}</p>
                </div>
            </div>
        {% endfor %}
    </div>
</div>

{% style %}
.image-row {
    margin: 2rem auto;
    padding: 5rem 2rem;
}
@media screen and (min-width: 590px) {
    .image-row {
        background: var(--section-background);
    }
}
.image-row-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    text-align: center;
    gap: 20px;
}
.image-row img {
    width: 40px;
    height: auto;
    margin: auto;
    margin-bottom: 5px;
}
.image-row__block > *,
.image-row__block > div > * {
    margin: auto;
    margin-bottom: 5px;
    max-width: 260px;
}
@media screen and (max-width: 589px) {
    .image-row-grid {
        grid-template-columns: 1fr;
        text-align: left;
    }
    .image-row__block {
        display: grid;
        gap: 20px;
        grid-template-columns: auto 1fr;
        background: var(--section-background);
        padding: 20px 10px;
        border-radius: 14px;
    }
    .image-row__block > *,
    .image-row__block > div > * {
        max-width: unset;
        margin: unset;
    }
}
{% endstyle %}

{% schema %}
{
    "name": "Image row",
    "settings": [
        {
            "type": "color",
            "id": "background",
            "label": "Background",
            "default": "#F6F6F6",
        }
    ],
    "blocks": [
        {
            "type": "block",
            "name": "Block",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "Image",
                },
                {
                    "type": "text",
                    "id": "heading",
                    "label": "Heading",
                    "default": "Heading"
                },
                {
                    "type": "text",
                    "id": "description",
                    "label": "Description",
                    "default": "Description"
                },
            ]   
        }
    ],
    "presets": [
        {
            "name": "Image row",
            "category": "Custom section by AJ"
        }
    ]   
}
{% endschema %}