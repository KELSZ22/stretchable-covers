                      </svg>
                      <span>{{ block.settings.feature_1 }}</span>
                    </div>
                  {% endif %}
                  {% if block.settings.feature_2 != blank %}
                    <div class="cc-slide__feature">
                      <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 34 34" fill="none">
                        <path d="M17 2.83331C8.84143 2.83331 2.29415 9.72949 2.86931 18.0099C3.38923 25.5027 9.92467 31.1666 17.4344 31.1666H19.8333C21.3988 31.1666 22.6667 29.8987 22.6667 28.3333V24.0833C22.6667 23.3013 23.3013 22.6666 24.0833 22.6666H28.3333C29.8988 22.6666 31.1667 21.3987 31.1667 19.8333V17.4344C31.1667 9.92322 25.5027 3.38643 18.0099 2.86652C17.6714 2.84385 17.3343 2.83331 17 2.83331ZM17 4.95831C17.2862 4.95831 17.5729 4.96892 17.8633 4.98875C24.1306 5.42367 29.0417 10.8894 29.0417 17.4344V19.8333C29.0417 20.2243 28.7243 20.5416 28.3333 20.5416H24.0833C22.1298 20.5416 20.5417 22.1311 20.5417 24.0833V28.3333C20.5417 28.7243 20.2243 29.0416 19.8333 29.0416H17.4344C10.8894 29.0416 5.4237 24.132 4.98878 17.8633C4.75361 14.4774 5.89221 11.2528 8.19288 8.78497C10.4978 6.31714 13.6255 4.95831 17 4.95831ZM15.5833 8.85415C15.3015 8.85415 15.0313 8.96609 14.832 9.16535C14.6328 9.3646 14.5208 9.63485 14.5208 9.91665C14.5208 10.1984 14.6328 10.4687 14.832 10.6679C15.0313 10.8672 15.3015 10.9791 15.5833 10.9791C15.8651 10.9791 16.1354 10.8672 16.3346 10.6679C16.5339 10.4687 16.6458 10.1984 16.6458 9.91665C16.6458 9.63485 16.5339 9.3646 16.3346 9.16535C16.1354 8.96609 15.8651 8.85415 15.5833 8.85415ZM21.25 10.2708C20.9682 10.2708 20.698 10.3828 20.4987 10.582C20.2995 10.7813 20.1875 11.0515 20.1875 11.3333C20.1875 11.6151 20.2995 11.8854 20.4987 12.0846C20.698 12.2839 20.9682 12.3958 21.25 12.3958C21.5318 12.3958 21.8021 12.2839 22.0013 12.0846C22.2006 11.8854 22.3125 11.6151 22.3125 11.3333C22.3125 11.0515 22.2006 10.7813 22.0013 10.582C21.8021 10.3828 21.5318 10.2708 21.25 10.2708ZM11.3333 11.6875C11.0515 11.6875 10.7813 11.7994 10.582 11.9987C10.3828 12.1979 10.2708 12.4682 10.2708 12.75C10.2708 13.0318 10.3828 13.302 10.582 13.5013C10.7813 13.7005 11.0515 13.8125 11.3333 13.8125C11.6151 13.8125 11.8854 13.7005 12.0846 13.5013C12.2839 13.302 12.3958 13.0318 12.3958 12.75C12.3958 12.4682 12.2839 12.1979 12.0846 11.9987C11.8854 11.7994 11.6151 11.6875 11.333