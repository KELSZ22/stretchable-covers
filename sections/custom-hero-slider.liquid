                      </svg>
                      <span>{{ block.settings.feature_2 }}</span>
                    </div>
                  {% endif %}
                  {% if block.settings.feature_3 != blank %}
                    <div class="cc-slide__feature">
                      <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 34 34" fill="none">
                        <path d="M3.90967 2.84717C3.62788 2.8472 3.35765 2.95915 3.1584 3.1584C2.95915 3.35765 2.8472 3.62788 2.84717 3.90967V14.5153C2.8472 14.7971 2.95915 15.0673 3.1584 15.2666C3.35765 15.4658 3.62788 15.5778 3.90967 15.5778H10.0467C9.75165 17.8292 10.1471 20.1004 11.2448 22.2959C11.3482 22.5009 11.5151 22.6669 11.7207 22.769C13.4501 23.6331 15.2257 24.0555 17.0028 24.0584C17.0027 24.0669 17 24.0748 17 24.0833C17 27.9826 20.1841 31.1667 24.0833 31.1667C27.9826 31.1667 31.1667 27.9826 31.1667 24.0833C31.1667 20.1841 27.9826 17 24.0833 17C24.0729 17 24.0633 17.0027 24.0529 17.0028C24.0507 15.2256 23.6323 13.4512 22.769 11.7235C22.6662 11.5175 22.4991 11.3504 22.2931 11.2476C20.5628 10.3824 18.7862 9.94987 17.0083 9.94987C16.5315 9.94987 16.0538 9.98449 15.5778 10.0467V3.90967C15.5778 3.62788 15.4658 3.35765 15.2666 3.1584C15.0673 2.95915 14.7971 2.8472 14.5153 2.84717H3.90967ZM4.97217 4.97217H13.4528V10.5503C12.8718 10.7418 12.2928 10.9615 11.7207 11.2476C11.5147 11.3504 11.3477 11.5175 11.2448 11.7235C10.9591 12.2948 10.7389 12.8728 10.5475 13.4528H4.97217V4.97217ZM17.0277 12.1247C18.3428 12.1259 19.6577 12.4377 21.0065 13.0627C21.6711 14.5206 21.9827 15.9397 21.9307 17.3569C19.7581 18.0532 18.0537 19.7594 17.3569 21.9279C15.9382 21.977 14.5187 21.6688 13.0599 21.0037C11.8117 18.3079 11.8128 15.746 13.0488 13.0516C14.397 12.4327 15.7125 12.1234 17.0277 12.1247ZM24.0833 19.125C26.8339 19.125 29.0417 21.3328 29.0417 24.0833C29.0417 26.8339 26.8339 29.0417 24.0833 29.0417C21.3328 29.0417 19.125 26.8339 19.125 24.0833C19.125 21.6322 20.8874 19.6162 23.2062 19.2025C23.4914 19.152 23.7843 19.125 24.0833 19.125Z" fill="white"/>
                      </svg>
                      <span>{{ block.settings.feature_3 }}</span>
                    </div>
                  {% endif %}
                </div>

                {% assign testimonial_count = 0 %}
                {% if block.settings.testimonial_text != blank or block.settings.testimonial_author != blank %}
                  {% assign testimonial_count = testimonial_count | plus: 1 %}
                {% endif %}
                {% if block.settings.testimonial_text_2 != blank or block.settings.testimonial_author_2 != blank %}
                  {% assign testimonial_count = testimonial_count | plus: 1 %}
                {% endif %}
                {% if block.settings.testimonial_text_3 != blank or block.settings.testimonial_author_3 != blank %}
                  {% assign testimonial_count = testimonial_count | plus: 1 %}
                {% endif %}
                {% if block.settings.testimonial_text_4 != blank or block.settings.testimonial_author_4 != blank %}
                  {% assign testimonial_count = testimonial_count | plus: 1 %}
                {% endif %}

                {% if testimonial_count > 0 %}
                  <div class="cc-slide__testimonial" data-autoplay="true" data-speed="4">
                    <div class="cc-slide__testimonial-track">
                      {% if block.settings.testimonial_text != blank or block.settings.testimonial_author != blank %}
                        <div class="cc-slide__testimonial-item">
                          <div class="cc-slide__quote">“</div>

                          {% if block.settings.testimonial_text != blank %}
                            <div class="cc-slide__testimonial-text">{{ block.settings.testimonial_text }}</div>
                          {% endif %}

                          {% if block.settings.testimonial_author != blank %}
                            <div class="cc-slide__testimonial-author">{{ block.settings.testimonial_author }}</div>
                          {% endif %}

                          {% if block.settings.testimonial_role != blank %}
                            <div class="cc-slide__testimonial-role">{{ block.settings.testimonial_role }}</div>
                          {% endif %}

                          {% if block.settings.testimonial_verified != blank %}
                            <div class="cc-slide__testimonial-verified">{{ block.settings.testimonial_verified }} <span>★★★★★</span></div>
                          {% endif %}
                        </div>
                      {% endif %}

                      {% if block.settings.testimonial_text_2 != blank or block.settings.testimonial_author_2 != blank %}
                        <div class="cc-slide__testimonial-item">
                          <div class="cc-slide__quote">“</div>

                          {% if block.settings.testimonial_text_2 != blank %}
                            <div class="cc-slide__testimonial-text">{{ block.settings.testimonial_text_2 }}</div>
                          {% endif %}

                          {% if block.settings.testimonial_author_2 != blank %}
                            <div class="cc-slide__testimonial-author">{{ block.settings.testimonial_author_2 }}</div>
                          {% endif %}

                          {% if block.settings.testimonial_role_2 != blank %}
                            <div class="cc-slide__testimonial-role">{{ block.settings.testimonial_role_2 }}</div>
                          {% endif %}

                          {% if block.settings.testimonial_verified_2 != blank %}
                            <div class="cc-slide__testimonial-verified">{{ block.settings.testimonial_verified_2 }} <span>★★★★★</span></div>
                          {% endif %}
                        </div>
                      {% endif %}

                      {% if block.settings.testimonial_text_3 != blank or block.settings.testimonial_author_3 != blank %}
                        <div class="cc-slide__testimonial-item">
                          <div class="cc-slide__quote">“</div>

                          {% if block.settings.testimonial_text_3 != blank %}
                            <div class="cc-slide__testimonial-text">{{ block.settings.testimonial_text_3 }}</div>
                          {% endif %}

                          {% if block.settings.testimonial_author_3 != blank %}
                            <div class="cc-slide__testimonial-author">{{ block.settings.testimonial_author_3 }}</div>
                          {% endif %}

                          {% if block.settings.testimonial_role_3 != blank %}
                            <div class="cc-slide__testimonial-role">{{ block.settings.testimonial_role_3 }}</div>
                          {% endif %}

                          {% if block.settings.testimonial_verified_3 != blank %}
                            <div class="cc-slide__testimonial-verified">{{ block.settings.testimonial_verified_3 }} <span>★★★★★</span></div>
                          {% endif %}
                        </div>
                      {% endif %}

                      {% if block.settings.testimonial_text_4 != blank or block.settings.testimonial_author_4 != blank %}
                        <div class="cc-slide__testimonial-item">
                          <div class="cc-slide__quote">“</div>

                          {% if block.settings.testimonial_text_4 != blank %}
                            <div class="cc-slide__testimonial-text">{{ block.settings.testimonial_text_4 }}</div>
                          {% endif %}

                          {% if block.settings.testimonial_author_4 != blank %}
                            <div class="cc-slide__testimonial-author">{{ block.settings.testimonial_author_4 }}</div>
                          {% endif %}

                          {% if block.settings.testimonial_role_4 != blank %}
                            <div class="cc-slide__testimonial-role">{{ block.settings.testimonial_role_4 }}</div>
                          {% endif %}

                          {% if block.settings.testimonial_verified_4 != blank %}
                            <div class="cc-slide__testimonial-verified">{{ block.settings.testimonial_verified_4 }} <span>★★★★★</span></div>
                          {% endif %}
                        </div>
                      {% endif %}
                    </div>

                    {% if testimonial_count > 1 %}
                      <div class="cc-slide__testimonial-dots">
                        {% if block.settings.testimonial_text != blank or block.settings.testimonial_author != blank %}
                          <button class="cc-slide__testimonial-dot is-active" type="button" aria-label="Go to testimonial 1"></button>
                        {% endif %}
                        {% if block.settings.testimonial_text_2 != blank or block.settings.testimonial_author_2 != blank %}
                          <button class="cc-slide__testimonial-dot" type="button" aria-label="Go to testimonial 2"></button>
                        {% endif %}
                        {% if block.settings.testimonial_text_3 != blank or block.settings.testimonial_author_3 != blank %}
                          <button class="cc-slide__testimonial-dot" type="button" aria-label="Go to testimonial 3"></button>
                        {% endif %}
                        {% if block.settings.testimonial_text_4 != blank or block.settings.testimonial_author_4 != blank %}
                          <button class="cc-slide__testimonial-dot" type="button" aria-label="Go to testimonial 4"></button>
                        {% endif %}
                      </div>
                    {% endif %}
                  </div>
                {% endif %}
              </div>

              <div class="cc-slide__media">
                {% if block.settings.product_image != blank %}
                  <img
                    src="{{ block.settings.product_image | image_url: width: 1600 }}"
                    alt="{{ block.settings.heading | escape }}"
                    class="cc-slide__image"
                    loading="lazy"
                    width="{{ block.settings.product_image.width }}"
                    height="{{ block.settings.product_image.height }}"
                  >
                {% endif %}
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    {% if section.blocks.size > 1 %}
      <div class="cc-slider__dots" aria-label="Slider Pagination">
        {% for block in section.blocks %}
          <button
            class="cc-slider__dot{% if forloop.first %} is-active{% endif %}"
            type="button"
            aria-label="Go to slide {{ forloop.index }}"
            data-slide="{{ forloop.index0 }}"
          ></button>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} {
    width: 100%;
  }

  #shopify-section-{{ section.id }} .cc-slider {
    position: relative;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .cc-slider__track {
    display: flex;
    transition: transform 0.5s ease;
    will-change: transform;
  }

  #shopify-section-{{ section.id }} .cc-slide {
    min-width: 100%;
    width: 100%;
    background-size: cover;
    background-position: center right;
    background-repeat: no-repeat;
  }

  #shopify-section-{{ section.id }} .cc-slide__overlay {
    width: 100%;
  }

