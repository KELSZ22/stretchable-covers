{% comment %}
  Section: Custom Cover Hero Slider
{% endcomment %}

<div id="shopify-section-{{ section.id }}" class="cc-slider-section">
  <div class="cc-slider" data-autoplay="{{ section.settings.autoplay }}" data-speed="{{ section.settings.autoplay_speed }}">
    <div class="cc-slider__track">
      {% for block in section.blocks %}
        <div
          class="cc-slide"
          {{ block.shopify_attributes }}
          {% if block.settings.bg_image != blank %}
            style="background-image: url('{{ block.settings.bg_image | image_url: width: 2400 }}');"
          {% endif %}
        >
          <div class="cc-slide__overlay">
            <div class="cc-slide__inner page-width">
              <div class="cc-slide__content">
                {% if block.settings.rating_text != blank %}
                  <div class="cc-slide__rating-wrap">
                    <div class="cc-slide__stars">★★★★★</div>
                    <div class="cc-slide__rating-text">{{ block.settings.rating_text }}</div>
                  </div>
                {% endif %}

                {% if block.settings.heading != blank %}
                  <h1 class="cc-slide__heading">{{ block.settings.heading }}</h1>
                {% endif %}

                {% if block.settings.subheading != blank %}
                  <div class="cc-slide__subheading">{{ block.settings.subheading }}</div>
                {% endif %}

                {% if block.settings.button_label != blank %}
                  <div class="cc-slide__button-wrap">
                    <a
                      {% if block.settings.button_link != blank %}
                        href="{{ block.settings.button_link }}"
                      {% else %}
                        role="link" aria-disabled="true"
                      {% endif %}
                      class="cc-slide__button"
                    >
                      {{ block.settings.button_label }}
                    </a>
                  </div>
                {% endif %}

                <div class="cc-slide__features">
                  {% if block.settings.feature_1 != blank %}
                    <div class="cc-slide__feature">
                      <svg xmlns="http://www.w3.org/2000/svg" width="29" height="32" viewBox="0 0 29 32" fill="none">
