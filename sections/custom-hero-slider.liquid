<script>
  (function() {
    var section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;

    var slider = section.querySelector('.cc-slider');
    var bgTrack = section.querySelector('.cc-slider__bg-track');
    var bgSlides = section.querySelectorAll('.cc-slide__bg');
    var heroContent = section.querySelector('.cc-slider__content');
    var heroDots = section.querySelectorAll('.cc-slider__inside');
    var bottomItem = section.querySelector('.cc-slider__bottom-item');

    if (!slider || !bgTrack || !bgSlides.length) return;

    var isAutoplayEnabled = String(slider.getAttribute('data-autoplay')) === 'true';
    var heroSpeed = (parseInt(slider.getAttribute('data-speed'), 10) || 5) * 1000;

    var currentHeroIndex = 0;
    var heroTimeout = null;
    var testimonialTimeout = null;

    function clearTimers() {
      if (heroTimeout) {
        clearTimeout(heroTimeout);
        heroTimeout = null;
      }

      if (testimonialTimeout) {
        clearTimeout(testimonialTimeout);
        testimonialTimeout = null;
      }
    }

    function updateHeroDots() {
      heroDots.forEach(function(dot, i) {
        dot.classList.toggle('is-active', i === currentHeroIndex);
      });
    }

    function updateBgSlides() {
      bgSlides.forEach(function(slide, i) {
        slide.classList.toggle('is-active', i === currentHeroIndex);
      });
    }

    function getActiveHeroScope() {
      return heroContent || null;
    }

    function getActiveBottomItem() {
      return bottomItem || null;
    }

    function getTestimonialInstanceData(testimonialSlider) {
      if (!testimonialSlider) return null;

      var testimonialTrack = testimonialSlider.querySelector('.cc-slide__testimonial-track');
      var testimonialItems = testimonialSlider.querySelectorAll('.cc-slide__testimonial-item');
      var testimonialDots = testimonialSlider.querySelectorAll('.cc-slide__testimonial-dot');
      var testimonialSpeed = (parseInt(testimonialSlider.getAttribute('data-speed'), 10) || 4) * 1000;

      if (!testimonialTrack || !testimonialItems.length) return null;

      return {
        slider: testimonialSlider,
        track: testimonialTrack,
        items: testimonialItems,
        dots: testimonialDots,
        speed: testimonialSpeed,
        total: testimonialItems.length
      };
    }

    function getActiveTestimonialData() {
      var instances = [];
      var activeHero = getActiveHeroScope();
      var activeBottom = getActiveBottomItem();

      [activeHero, activeBottom].forEach(function(scope) {
        if (!scope) return;

        var sliders = scope.querySelectorAll('.cc-slide__testimonial');

        sliders.forEach(function(sliderEl) {
          var data = getTestimonialInstanceData(sliderEl);
          if (data) {
            instances.push(data);
          }
        });
      });

      if (!instances.length) return null;

      return {
        instances: instances,
        speed: instances[0].speed,
        total: instances[0].total,
        index: 0
      };
    }

    function setTestimonialSlide(data, index) {
      if (!data) return;

      if (index < 0) index = data.total - 1;
      if (index >= data.total) index = 0;

      data.index = index;

      data.instances.forEach(function(instance) {
        instance.track.style.transform = 'translateX(-' + (data.index * 100) + '%)';

        if (instance.dots.length) {
          instance.dots.forEach(function(dot, i) {
            dot.classList.toggle('is-active', i === data.index);
          });
        }
      });
    }

    function resetAllTestimonials() {
      var allTestimonialSliders = section.querySelectorAll('.cc-slide__testimonial');

      allTestimonialSliders.forEach(function(sliderEl) {
        var trackEl = sliderEl.querySelector('.cc-slide__testimonial-track');
        var dotsEl = sliderEl.querySelectorAll('.cc-slide__testimonial-dot');

        if (trackEl) {
          trackEl.style.transform = 'translateX(0%)';
        }

        if (dotsEl.length) {
          dotsEl.forEach(function(dot, i) {
            dot.classList.toggle('is-active', i === 0);
          });
        }
      });
    }

    function setBackgroundSlide(index) {
      if (index < 0) index = bgSlides.length - 1;
      if (index >= bgSlides.length) index = 0;

      currentHeroIndex = index;
      bgTrack.style.transform = 'translateX(-' + (currentHeroIndex * 100) + '%)';
      updateHeroDots();
      updateBgSlides();
    }

    function startBackgroundAutoplay() {
      clearTimeout(heroTimeout);

      if (!isAutoplayEnabled || bgSlides.length <= 1) return;

      heroTimeout = setTimeout(function() {
        setBackgroundSlide(currentHeroIndex + 1);
        startBackgroundAutoplay();
      }, heroSpeed);
    }

    function startTestimonialAutoplay(data) {
      clearTimeout(testimonialTimeout);

      if (!isAutoplayEnabled || !data || data.total <= 1) return;

      function advanceTestimonial() {
        setTestimonialSlide(data, data.index + 1);
        testimonialTimeout = setTimeout(advanceTestimonial, data.speed);
      }

      testimonialTimeout = setTimeout(advanceTestimonial, data.speed);
    }

    function bindTestimonialDots(data) {
      if (!data) return;

      data.instances.forEach(function(instance) {
        if (!instance.dots.length) return;

        instance.dots.forEach(function(dot, index) {
          dot.onclick = function() {
            clearTimers();
            setTestimonialSlide(data, index);
            startTestimonialAutoplay(data);
            startBackgroundAutoplay();
          };
        });
      });
    }

    function initAutoplay() {
      clearTimers();
      resetAllTestimonials();

      var testimonialData = getActiveTestimonialData();

      if (testimonialData) {
        setTestimonialSlide(testimonialData, 0);
        bindTestimonialDots(testimonialData);
        startTestimonialAutoplay(testimonialData);
      }

      startBackgroundAutoplay();
    }

    if (heroDots.length) {
      heroDots.forEach(function(dot) {
        dot.addEventListener('click', function() {
          var index = parseInt(this.getAttribute('data-slide'), 10);
          clearTimers();
          setBackgroundSlide(index);

          var testimonialData = getActiveTestimonialData();
          startTestimonialAutoplay(testimonialData);
          startBackgroundAutoplay();
        });
      });
    }

    slider.addEventListener('mouseenter', function() {
      clearTimers();
    });

    slider.addEventListener('mouseleave', function() {
      if (isAutoplayEnabled) {
        initAutoplay();
      }
    });

    window.addEventListener('resize', function() {
      updateBgSlides();
      if (isAutoplayEnabled) {
        initAutoplay();
      }
    });

    setBackgroundSlide(0);
    if (isAutoplayEnabled) {
      initAutoplay();
    }
  })();
</script>

