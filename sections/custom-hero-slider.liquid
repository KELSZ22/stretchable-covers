<script>
  (function() {
    var section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;

    var slider = section.querySelector('.cc-slider');
    var track = section.querySelector('.cc-slider__track');
    var heroSlides = section.querySelectorAll('.cc-slide');
    var heroDots = section.querySelectorAll('.cc-slider__dot');

    if (!track || !heroSlides.length) return;

    var currentHeroIndex = 0;
    var heroTimeout = null;
    var testimonialInterval = null;

    function clearTimers() {
      if (heroTimeout) {
        clearTimeout(heroTimeout);
        heroTimeout = null;
      }

      if (testimonialInterval) {
        clearInterval(testimonialInterval);
        testimonialInterval = null;
      }
    }

    function updateHeroDots() {
      heroDots.forEach(function(dot, i) {
        dot.classList.toggle('is-active', i === currentHeroIndex);
      });
    }

    function goToHeroSlide(index) {
      if (index < 0) index = heroSlides.length - 1;
      if (index >= heroSlides.length) index = 0;

      currentHeroIndex = index;
      track.style.transform = 'translateX(-' + (currentHeroIndex * 100) + '%)';
      updateHeroDots();
      runHeroCycle();
    }

    function getActiveHeroSlide() {
      return heroSlides[currentHeroIndex];
    }

    function getTestimonialData(heroSlide) {
      if (!heroSlide) return null;

      var testimonialSlider = heroSlide.querySelector('.cc-slide__testimonial');
      if (!testimonialSlider) return null;

      var testimonialTrack = testimonialSlider.querySelector('.cc-slide__testimonial-track');
      var testimonialItems = testimonialSlider.querySelectorAll('.cc-slide__testimonial-item');
      var testimonialDots = testimonialSlider.querySelectorAll('.cc-slide__testimonial-dot');
      var testimonialSpeed = (parseInt(testimonialSlider.getAttribute('data-speed'), 10) || 4) * 1000;

      if (!testimonialTrack || !testimonialItems.length) return null;

      return {
        slider: testimonialSlider,
        track: testimonialTrack,
        items: testimonialItems,
        dots: testimonialDots,
        speed: testimonialSpeed,
        index: 0,
        total: testimonialItems.length
      };
    }

    function setTestimonialSlide(data, index) {
      if (!data) return;

      if (index < 0) index = data.total - 1;
      if (index >= data.total) index = 0;

      data.index = index;
      data.track.style.transform = 'translateX(-' + (data.index * 100) + '%)';

      if (data.dots.length) {
        data.dots.forEach(function(dot, i) {
          dot.classList.toggle('is-active', i === data.index);
        });
      }
    }

    function bindTestimonialDots(data) {
      if (!data || !data.dots.length) return;

      data.dots.forEach(function(dot, index) {
        dot.onclick = function() {
          clearTimers();
          setTestimonialSlide(data, index);
          continueHeroAfterTestimonial(data);
        };
      });
    }

    function continueHeroAfterTestimonial(data) {
      clearTimers();

      if (!data) {
        heroTimeout = setTimeout(function() {
          goToHeroSlide(currentHeroIndex + 1);
        }, 4000);
        return;
      }

      if (data.total <= 1) {
        heroTimeout = setTimeout(function() {
          goToHeroSlide(currentHeroIndex + 1);
        }, data.speed);
        return;
      }

      testimonialInterval = setInterval(function() {
        if (data.index < data.total - 1) {
          setTestimonialSlide(data, data.index + 1);
        } else {
          clearTimers();
          goToHeroSlide(currentHeroIndex + 1);
        }
      }, data.speed);
    }

    function resetAllTestimonials() {
      var allTestimonialSliders = section.querySelectorAll('.cc-slide__testimonial');

      allTestimonialSliders.forEach(function(sliderEl) {
        var trackEl = sliderEl.querySelector('.cc-slide__testimonial-track');
        var dotsEl = sliderEl.querySelectorAll('.cc-slide__testimonial-dot');

        if (trackEl) {
          trackEl.style.transform = 'translateX(0%)';
        }

        if (dotsEl.length) {
          dotsEl.forEach(function(dot, i) {
            dot.classList.toggle('is-active', i === 0);
          });
        }
      });
    }

    function runHeroCycle() {
      clearTimers();
      resetAllTestimonials();

      var activeHero = getActiveHeroSlide();
      var testimonialData = getTestimonialData(activeHero);

      if (testimonialData) {
        setTestimonialSlide(testimonialData, 0);
        bindTestimonialDots(testimonialData);
      }

      continueHeroAfterTestimonial(testimonialData);
    }

    if (heroDots.length) {
      heroDots.forEach(function(dot) {
        dot.addEventListener('click', function() {
          var index = parseInt(this.getAttribute('data-slide'), 10);
          goToHeroSlide(index);
        });
      });
    }

    slider.addEventListener('mouseenter', function() {
      clearTimers();
    });

    slider.addEventListener('mouseleave', function() {
      runHeroCycle();
    });

    goToHeroSlide(0);
  })();
</script>

