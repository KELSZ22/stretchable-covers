{% liquid
  assign marquee_speed = section.settings.marquee_speed | default: 35
  assign move_direction = section.settings.move_direction | default: 'left'
  assign has_blocks = section.blocks.size
%}

<section class="marquee-image-showcase" id="marquee-image-showcase-{{ section.id }}" style="--marquee-speed: {{ marquee_speed }}s;">
  <div class="marquee-image-showcase__fullwidth-container">
    <div class="marquee-image-showcase__inner">
    {% if section.settings.heading != blank %}
      <h2 class="marquee-image-showcase__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="marquee-image-showcase__subheading">{{ section.settings.subheading }}</p>
    {% endif %}

    {% if has_blocks > 0 %}
      <div class="marquee-image-showcase__viewport">
        <div class="marquee-image-showcase__track{% if move_direction == 'right' %} marquee-image-showcase__track--right{% endif %}">
          {% for i in (1..2) %}
            {% for block in section.blocks %}
              <div class="marquee-image-showcase__item" {{ block.shopify_attributes }}>
                {% if block.settings.image != blank %}
                  {{ block.settings.image | image_url: width: 1200 | image_tag: class: 'marquee-image-showcase__image', loading: 'lazy' }}
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'marquee-image-showcase__image marquee-image-showcase__image--placeholder' }}
                {% endif %}
              </div>
            {% endfor %}
          {% endfor %}
        </div>
      </div>
    {% endif %}
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }},
  #shopify-section-{{ section.id }}.shopify-section,
  #shopify-section-{{ section.id }}.section {
    width: 100vw !important;
    max-width: 100vw !important;
    margin-left: calc(50% - 50vw) !important;
    margin-right: calc(50% - 50vw) !important;
    margin-top: 0 !important;
    margin-bottom: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    left: auto !important;
    right: auto !important;
  }

  #shopify-section-{{ section.id }} .marquee-image-showcase__fullwidth-container {
    width: 100% !important;
    max-width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
  }

  #marquee-image-showcase-{{ section.id }} {
    width: 100vw;
    max-width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    background: {{ section.settings.section_bg }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: 0;
    padding-right: 0;
    overflow: hidden;
  }

  #marquee-image-showcase-{{ section.id }} .marquee-image-showcase__inner {
    width: 100%;
    max-width: 100%;
    text-align: center;
  }

  #marquee-image-showcase-{{ section.id }} .marquee-image-showcase__heading {
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-size: clamp(28px, 3.2vw, 46px);
    font-weight: 800;
    line-height: 1.1;
  }

  #marquee-image-showcase-{{ section.id }} .marquee-image-showcase__subheading {
    margin: 14px auto 36px;
    max-width: 680px;
    color: {{ section.settings.subheading_color }};
    font-size: clamp(14px, 1.2vw, 18px);
    line-height: 1.5;
  }

  #marquee-image-showcase-{{ section.id }} .marquee-image-showcase__viewport {
    width: 100%;
    overflow: hidden;
  }

  #marquee-image-showcase-{{ section.id }} .marquee-image-showcase__track {
    display: flex;
    width: max-content;
    align-items: center;
    gap: 14px;
    animation: marquee-image-showcase-scroll-left var(--marquee-speed) linear infinite;
    will-change: transform;
  }

  #marquee-image-showcase-{{ section.id }} .marquee-image-showcase__track--right {
    animation-name: marquee-image-showcase-scroll-right;
  }

  #marquee-image-showcase-{{ section.id }} .marquee-image-showcase__item {
    flex: 0 0 auto;
    width: clamp(210px, 23vw, 330px);
  }

  #marquee-image-showcase-{{ section.id }} .marquee-image-showcase__image {
    display: block;
    width: 100%;
    height: clamp(150px, 20vw, 230px);
    object-fit: cover;
    border-radius: 20px;
    overflow: hidden;
  }

  #marquee-image-showcase-{{ section.id }} .marquee-image-showcase__image--placeholder {
    background: #d9dce1;
  }

  @keyframes marquee-image-showcase-scroll-left {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @keyframes marquee-image-showcase-scroll-right {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(0);
    }
  }

  @media screen and (max-width: 989px) {
    #marquee-image-showcase-{{ section.id }} .marquee-image-showcase__subheading {
      margin-bottom: 26px;
    }
  }

  @media screen and (max-width: 749px) {
    #marquee-image-showcase-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.7 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.7 | round: 0 }}px;
    }

    #marquee-image-showcase-{{ section.id }} .marquee-image-showcase__heading {
      font-size: clamp(24px, 8vw, 34px);
    }

    #marquee-image-showcase-{{ section.id }} .marquee-image-showcase__subheading {
      font-size: 14px;
      margin: 10px auto 22px;
      max-width: 92%;
    }

    #marquee-image-showcase-{{ section.id }} .marquee-image-showcase__track {
      gap: 10px;
    }

    #marquee-image-showcase-{{ section.id }} .marquee-image-showcase__item {
      width: clamp(180px, 62vw, 260px);
    }

    #marquee-image-showcase-{{ section.id }} .marquee-image-showcase__image {
      height: clamp(120px, 38vw, 180px);
      border-radius: 20px;
    }
  }
</style>

{% schema %}
{
  "name": "Marquee image showcase",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Strechable Covers are everywhere!"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "See how our covers fit seamlessly across industries, spaces, and events."
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "min": 10,
      "max": 120,
      "step": 2,
      "unit": "s",
      "label": "Marquee speed",
      "default": 36
    },
    {
      "type": "select",
      "id": "move_direction",
      "label": "Movement direction",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "default": "#dfe2e6"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#202124"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#4d525b"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "max_blocks": 40,
  "presets": [
    {
      "name": "Marquee image showcase"
    }
  ]
}
{% endschema %}
