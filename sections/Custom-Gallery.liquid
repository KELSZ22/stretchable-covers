<section id="collection-gallery-{{ section.id }}" class="collection-gallery-showcase">
  <div class="collection-gallery-showcase__inner page-width">
    {% if section.settings.heading != blank %}
      <h2 class="collection-gallery-showcase__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="collection-gallery-showcase__subheading">{{ section.settings.subheading }}</p>
    {% endif %}

    <div class="collection-gallery-showcase__tabs" role="tablist" aria-label="Gallery tabs">
      {% for block in section.blocks %}
        <button
          type="button"
          class="collection-gallery-showcase__tab{% if forloop.first %} is-active{% endif %}"
          data-tab-index="{{ forloop.index0 }}"
          role="tab"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          aria-controls="collection-gallery-panel-{{ section.id }}-{{ forloop.index0 }}"
          {{ block.shopify_attributes }}
        >
          {{ block.settings.tab_label }}
        </button>
      {% endfor %}
    </div>

    <div class="collection-gallery-showcase__carousel">
      <div class="collection-gallery-showcase__track" data-track>
        {% for block in section.blocks %}
          <div
            class="collection-gallery-showcase__slide{% if forloop.first %} is-active{% endif %}"
            id="collection-gallery-panel-{{ section.id }}-{{ forloop.index0 }}"
            data-slide-index="{{ forloop.index0 }}"
            role="tabpanel"
            aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
          >

            {% comment %}
            OLD GRID LAYOUT
            <div class="collection-gallery-showcase__grid">
              <div class="collection-gallery-showcase__image-wrap collection-gallery-showcase__image-wrap--large">
              </div>

              <div class="collection-gallery-showcase__right-col">
              </div>
            </div>
            {% endcomment %}

            <!-- NEW 2x2 GRID -->
            <div class="collection-gallery-showcase__grid">

              <div class="collection-gallery-showcase__image-wrap" data-mobile-slide="0">
                {% if block.settings.image_1 != blank %}
                  {{
                    block.settings.image_1
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      class: 'collection-gallery-showcase__image',
                      alt: block.settings.tab_label
                  }}
                {% else %}
                  <div class="collection-gallery-showcase__placeholder"></div>
                {% endif %}
              </div>

              <div class="collection-gallery-showcase__image-wrap" data-mobile-slide="1">
                {% if block.settings.image_2 != blank %}
                  {{
                    block.settings.image_2
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      class: 'collection-gallery-showcase__image',
                      alt: block.settings.tab_label
                  }}
                {% else %}
                  <div class="collection-gallery-showcase__placeholder"></div>
                {% endif %}
              </div>

              <div class="collection-gallery-showcase__image-wrap" data-mobile-slide="2">
                {% if block.settings.image_3 != blank %}
                  {{
                    block.settings.image_3
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      class: 'collection-gallery-showcase__image',
                      alt: block.settings.tab_label
                  }}
                {% else %}
                  <div class="collection-gallery-showcase__placeholder"></div>
                {% endif %}
              </div>

              <div class="collection-gallery-showcase__image-wrap" data-mobile-slide="3">
                {% if block.settings.image_4 != blank %}
                  {{
                    block.settings.image_4
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      class: 'collection-gallery-showcase__image',
                      alt: block.settings.tab_label
                  }}
                {% else %}
                  <div class="collection-gallery-showcase__placeholder"></div>
                {% endif %}
              </div>

            </div>
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="collection-gallery-showcase__nav">
      <button type="button" class="collection-gallery-showcase__arrow collection-gallery-showcase__arrow--prev" data-prev aria-label="Previous">
        <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="-0.5" y="0.5" width="39" height="39" rx="19.5" transform="matrix(-1 0 0 1 39 0)" fill="#F3F4F5"/>
          <rect x="-0.5" y="0.5" width="39" height="39" rx="19.5" transform="matrix(-1 0 0 1 39 0)" stroke="#C5C5C5"/>
          <path d="M23 26L17 20L23 14" stroke="#5F5F5F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <button type="button" class="collection-gallery-showcase__arrow collection-gallery-showcase__arrow--next" data-next aria-label="Next">
        <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="0.5" y="-0.5" width="39" height="39" rx="19.5" transform="matrix(1 0 0 -1 0 39)" fill="#0F2E53"/>
          <rect x="0.5" y="-0.5" width="39" height="39" rx="19.5" transform="matrix(1 0 0 -1 0 39)" stroke="#0F2E53"/>
          <path d="M18 14.5L24 20.5L18 26.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>

    <div class="collection-gallery-showcase__progress" aria-hidden="true">
      <div class="collection-gallery-showcase__progress-fill" data-progress></div>
    </div>
  </div>

  <style>
    #collection-gallery-{{ section.id }} {
      background: #fff;
      padding: 56px 20px 44px;
    }

    #collection-gallery-{{ section.id }} .collection-gallery-showcase__inner {
      max-width: 800px;
      margin: 0 auto;
      text-align: center;
    }

    #collection-gallery-{{ section.id }} .collection-gallery-showcase__heading {
      margin: 0;
      font-size: clamp(28px, 3.2vw, 44px);
      line-height: 1.2;
      font-weight: 700;
      color: #0F2E53;
    }

    #collection-gallery-{{ section.id }} .collection-gallery-showcase__subheading {
      margin: 10px auto 28px;
      max-width: 680px;
      font-size: 14px;
      line-height: 1.55;
      color: #5f6470;
    }

    #collection-gallery-{{ section.id }} .collection-gallery-showcase__tabs {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
      margin-bottom: 26px;
    }

    #collection-gallery-{{ section.id }} .collection-gallery-showcase__tab {
      border: 1px solid #0f2e53;
      color: #0f2e53;
      background: transparent;
      border-radius: 999px;
      font-size: 16px;
      line-height: 1;
      padding: 12px 18px;
      cursor: pointer;
      transition: background .2s ease, color .2s ease;
      font-family: 'Lato';
    }

    #collection-gallery-{{ section.id }} .collection-gallery-showcase__tab.is-active {
      background: #0f2e53;
      color: #ffffff;
    }

    #collection-gallery-{{ section.id }} .collection-gallery-showcase__carousel {
      position: relative;
    }

    #collection-gallery-{{ section.id }} .collection-gallery-showcase__slide {
      display: none;
    }

    #collection-gallery-{{ section.id }} .collection-gallery-showcase__slide.is-active {
      display: block;
    }

    {% comment %}
    OLD GRID CSS

    .collection-gallery-showcase__right-col {
      display: grid;
      grid-template-rows: 1fr 1fr;
    }

    .collection-gallery-showcase__image-wrap--large {
      min-height: 438px;
    }
    {% endcomment %}

    /* NEW 2x2 GRID */
    #collection-gallery-{{ section.id }} .collection-gallery-showcase__grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    #collection-gallery-{{ section.id }} .collection-gallery-showcase__image-wrap {
      border-radius: 18px;
      overflow: hidden;
      position: relative;
      aspect-ratio: 1 / 1;
    }

    #collection-gallery-{{ section.id }} .collection-gallery-showcase__image,
    #collection-gallery-{{ section.id }} .collection-gallery-showcase__placeholder {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    #collection-gallery-{{ section.id }} .collection-gallery-showcase__placeholder {
      background: #d9dde3;
    }

    #collection-gallery-{{ section.id }} .collection-gallery-showcase__nav {
      margin-top: 26px;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 12px;
    }

    #collection-gallery-{{ section.id }} .collection-gallery-showcase__arrow {
      border: 0;
      padding: 0;
      background: transparent;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    #collection-gallery-{{ section.id }} .collection-gallery-showcase__arrow svg {
      display: block;
      width: 40px;
      height: 40px;
    }

    #collection-gallery-{{ section.id }} .collection-gallery-showcase__progress {
      margin: 16px auto 0;
      width: min(260px, 80vw);
      height: 2px;
      background: #c7ccd4;
      border-radius: 999px;
      overflow: hidden;
    }

    #collection-gallery-{{ section.id }} .collection-gallery-showcase__progress-fill {
      height: 100%;
      width: 0;
      background: #0f2e53;
      transition: width .28s ease;
    }

    @media screen and (max-width: 989px) {
      #collection-gallery-{{ section.id }} {
        padding: 42px 16px 34px;
        overflow: hidden;
      }

      #collection-gallery-{{ section.id }} .collection-gallery-showcase__carousel {
        overflow: visible;
      }

      #collection-gallery-{{ section.id }} .collection-gallery-showcase__grid {
        display: flex;
        gap: 14px;
        align-items: stretch;
        overflow-x: auto;
        overflow-y: hidden;
        scroll-snap-type: x mandatory;
        scroll-behavior: smooth;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        padding: 0 16px 4px 0;
        margin-right: -16px;
      }

      #collection-gallery-{{ section.id }} .collection-gallery-showcase__grid::-webkit-scrollbar {
        display: none;
      }

      {% comment %}
      OLD MOBILE CSS

      .collection-gallery-showcase__right-col {
        display: contents;
      }

      .collection-gallery-showcase__image-wrap--large {
      }
      {% endcomment %}

      #collection-gallery-{{ section.id }} .collection-gallery-showcase__image-wrap[data-mobile-slide] {
        display: block;
        flex: 0 0 84%;
        max-width: 84%;
        height: 300px;
        min-height: 300px;
        aspect-ratio: unset;
        scroll-snap-align: start;
        scroll-snap-stop: always;
      }

      #collection-gallery-{{ section.id }} .collection-gallery-showcase__tabs {
        justify-content: flex-start;
        overflow-x: auto;
        flex-wrap: nowrap;
        padding-bottom: 2px;
        scrollbar-width: none;
      }

      #collection-gallery-{{ section.id }} .collection-gallery-showcase__tabs::-webkit-scrollbar {
        display: none;
      }

      #collection-gallery-{{ section.id }} .collection-gallery-showcase__tab {
        white-space: nowrap;
      }
    }

    @media screen and (max-width: 768px) {
      #collection-gallery-{{ section.id }} .collection-gallery-showcase__tabs {
        display: none;
      }

      #collection-gallery-{{ section.id }} .collection-gallery-showcase__nav {
        display: none;
      }

      #collection-gallery-{{ section.id }} .collection-gallery-showcase__image-wrap[data-mobile-slide] {
        flex-basis: 84%;
        max-width: 84%;
        height: 300px;
        min-height: 300px;
      }

      #collection-gallery-{{ section.id }} .collection-gallery-showcase__image {
        height: 300px !important;
      }
    }

    @media screen and (max-width: 500px) {
      #collection-gallery-{{ section.id }} .collection-gallery-showcase__image-wrap[data-mobile-slide] {
        flex-basis: 86%;
        max-width: 86%;
      }
    }
  </style>

  <script>
    (() => {
      const sectionRoot = document.getElementById('collection-gallery-{{ section.id }}');
      if (!sectionRoot) return;

      const tabs = Array.from(sectionRoot.querySelectorAll('[data-tab-index]'));
      const slides = Array.from(sectionRoot.querySelectorAll('[data-slide-index]'));
      const prevBtn = sectionRoot.querySelector('[data-prev]');
      const nextBtn = sectionRoot.querySelector('[data-next]');
      const progress = sectionRoot.querySelector('[data-progress]');

      if (!slides.length) return;

      let activeIndex = 0;

      const isMobile = () => window.innerWidth <= 989;

      const getActiveMobileScroller = () => {
        const activeSlide = slides[activeIndex];
        if (!activeSlide) return null;

        return activeSlide.querySelector('.collection-gallery-showcase__grid');
      };

      const scrollMobileImages = (direction) => {
        const scroller = getActiveMobileScroller();
        if (!scroller) return;

        scroller.scrollBy({
          left: direction * scroller.clientWidth * 0.86,
          behavior: 'smooth'
        });
      };

      const resetActiveMobileScroll = () => {
        const scroller = getActiveMobileScroller();
        if (!scroller) return;

        scroller.scrollTo({
          left: 0,
          behavior: 'auto'
        });
      };

      const setActive = (index) => {
        activeIndex = (index + slides.length) % slides.length;

        tabs.forEach((tab, tabIndex) => {
          const isActive = tabIndex === activeIndex;
          tab.classList.toggle('is-active', isActive);
          tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });

        slides.forEach((slide, slideIndex) => {
          const isActive = slideIndex === activeIndex;
          slide.classList.toggle('is-active', isActive);
          slide.setAttribute('aria-hidden', isActive ? 'false' : 'true');
        });

        const width = ((activeIndex + 1) / slides.length) * 100;
        if (progress) progress.style.width = `${width}%`;

        if (isMobile()) {
          requestAnimationFrame(resetActiveMobileScroll);
        }
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => setActive(index));
      });

      if (prevBtn) {
        prevBtn.addEventListener('click', () => {
          if (isMobile()) {
            scrollMobileImages(-1);
          } else {
            setActive(activeIndex - 1);
          }
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          if (isMobile()) {
            scrollMobileImages(1);
          } else {
            setActive(activeIndex + 1);
          }
        });
      }

      window.addEventListener('resize', () => {
        if (isMobile()) {
          resetActiveMobileScroll();
        }
      });

      setActive(0);
    })();
  </script>
</section>

{% schema %}
{
  "name": "Gallery Showcase",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See Every Collection in Action"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Browse images to find the perfect fit for your needs and use case."
    }
  ],
  "blocks": [
    {
      "type": "collection_group",
      "name": "Collection Group",
      "settings": [
        {
          "type": "text",
          "id": "tab_label",
          "label": "Tab label",
          "default": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image_1",
          "label": "Image 1"
        },
        {
          "type": "image_picker",
          "id": "image_2",
          "label": "Image 2"
        },
        {
          "type": "image_picker",
          "id": "image_3",
          "label": "Image 3"
        },
        {
          "type": "image_picker",
          "id": "image_4",
          "label": "Image 4"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Gallery Showcase",
      "blocks": [
        {
          "type": "collection_group"
        },
        {
          "type": "collection_group"
        },
        {
          "type": "collection_group"
        }
      ]
    }
  ]
}
{% endschema %}