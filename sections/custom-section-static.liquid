{% comment %}
  Section: Customer Gallery Mosaic
{% endcomment %}

<section id="shopify-section-{{ section.id }}" class="cgm-section">
  <div class="cgm-container page-width">
    <div class="cgm-header">
      {% if section.settings.stars_text != blank or section.settings.trusted_text != blank %}
        <div class="cgm-rating">
          {% if section.settings.stars_text != blank %}
            <div class="cgm-stars">{{ section.settings.stars_text }}</div>
          {% endif %}
          {% if section.settings.trusted_text != blank %}
            <div class="cgm-trusted-text">{{ section.settings.trusted_text }}</div>
          {% endif %}
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="cgm-heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="cgm-description">{{ section.settings.description }}</div>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="cgm-grid">
        {% for block in section.blocks %}
          {% assign image_alt = block.settings.alt_text | default: block.settings.image.alt | default: section.settings.heading %}
          <div
            class="cgm-item"
            style="
              --desktop-span: {{ block.settings.desktop_span }};
              --mobile-span: {{ block.settings.mobile_span }};
            "
            {{ block.shopify_attributes }}
          >
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}" class="cgm-item__link">
            {% else %}
              <div class="cgm-item__link">
            {% endif %}

              {% if block.settings.image != blank %}
                <img
                  src="{{ block.settings.image | image_url: width: 2000 }}"
                  alt="{{ image_alt | escape }}"
                  class="cgm-item__image"
                  loading="lazy"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                >
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'cgm-item__placeholder' }}
              {% endif %}

            {% if block.settings.link != blank %}
              </a>
            {% else %}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  #shopify-section-{{ section.id }}.cgm-section {
    background: {{ section.settings.section_bg }};
  }

  #shopify-section-{{ section.id }} .cgm-container {
    padding: 60px 70px;
  }

  #shopify-section-{{ section.id }} .cgm-header {
    max-width: 900px;
    margin: 0 auto 28px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .cgm-rating {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 10px;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .cgm-stars {
    font-size: 14px;
    line-height: 1;
    letter-spacing: 2px;
    color: {{ section.settings.stars_color }};
  }

  #shopify-section-{{ section.id }} .cgm-trusted-text {
    font-size: 14px;
    line-height: 18px;
    color: {{ section.settings.trusted_text_color }};
  }

  #shopify-section-{{ section.id }} .cgm-heading {
    margin: 0 0 8px;
    font-size: 32px;
    line-height: 36px;
    font-weight: 800;
    color: {{ section.settings.heading_color }};
  }

  #shopify-section-{{ section.id }} .cgm-description {
    font-size: 16px;
    line-height: 18px;
    color: {{ section.settings.description_color }};
    margin: 0 auto;
    font-weight: 400;
  }

  #shopify-section-{{ section.id }} .cgm-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: {{ section.settings.grid_gap }}px;
    align-items: stretch;
    grid-auto-rows: {{ section.settings.row_height }}px;
  }

  #shopify-section-{{ section.id }} .cgm-item {
    grid-column: span var(--desktop-span);
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .cgm-item__link {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .cgm-item__image,
  #shopify-section-{{ section.id }} .cgm-item__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: {{ section.settings.image_radius }}px;
    overflow: hidden;
    background: #e9e9e9;
  }

  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .cgm-container {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    #shopify-section-{{ section.id }} .cgm-heading {
      font-size: 18px;
      line-height: 24px;
    }

    #shopify-section-{{ section.id }} .cgm-description {
      font-size: 11px;
      line-height: 17px;
    }

    #shopify-section-{{ section.id }} .cgm-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: {{ section.settings.row_height_mobile }}px;
    }

    #shopify-section-{{ section.id }} .cgm-item {
      grid-column: span var(--mobile-span);
    }
  }
</style>

{% schema %}
{
  "name": "Customer Gallery Mosaic",
  "settings": [
    {
      "type": "text",
      "id": "stars_text",
      "label": "Stars text",
      "default": "★★★★★"
    },
    {
      "type": "text",
      "id": "trusted_text",
      "label": "Trusted text",
      "default": "Trusted by 50,000 + customers"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Thousands of customers and repeated use."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Trusted by thousands of customers and proven through years of repeated, real-world use across multiple industries."
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background color",
      "default": "#F4F4F4"
    },
    {
      "type": "color",
      "id": "stars_color",
      "label": "Stars color",
      "default": "#F5A623"
    },
    {
      "type": "color",
      "id": "trusted_text_color",
      "label": "Trusted text color",
      "default": "#555555"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1F1F1F"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description color",
      "default": "#444444"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid gap",
      "min": 4,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
  "type": "range",
  "id": "row_height",
  "label": "Desktop row height",
  "min": 120,
  "max": 320,
  "step": 5,
  "unit": "px",
  "default": 140
},
{
  "type": "range",
  "id": "row_height_mobile",
  "label": "Mobile row height",
  "min": 100,
  "max": 240,
  "step": 5,
  "unit": "px",
  "default": 150
},
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 6
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 20,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 20,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 36
    },
  ],
  "blocks": [
    {
      "type": "image_item",
      "name": "Image item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "desktop_span",
          "label": "Desktop width",
          "default": "2",
          "options": [
            {
              "value": "1",
              "label": "1 column"
            },
            {
              "value": "2",
              "label": "2 columns"
            },
            {
              "value": "3",
              "label": "3 columns"
            },
            {
              "value": "4",
              "label": "4 columns"
            },
            {
              "value": "5",
              "label": "5 columns"
            },
            {
              "value": "6",
              "label": "6 columns"
            }
          ]
        },
        {
          "type": "select",
          "id": "mobile_span",
          "label": "Mobile width",
          "default": "1",
          "options": [
            {
              "value": "1",
              "label": "Half width"
            },
            {
              "value": "2",
              "label": "Full width"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer Gallery Mosaic",
      "blocks": [
        {
          "type": "image_item",
          "settings": {
            "desktop_span": "3",
            "mobile_span": "2"
          }
        },
        {
          "type": "image_item",
          "settings": {
            "desktop_span": "2",
            "mobile_span": "1"
          }
        },
        {
          "type": "image_item",
          "settings": {
            "desktop_span": "1",
            "mobile_span": "1"
          }
        },
        {
          "type": "image_item",
          "settings": {
            "desktop_span": "1",
            "mobile_span": "1"
          }
        },
        {
          "type": "image_item",
          "settings": {
            "desktop_span": "3",
            "mobile_span": "1"
          }
        },
        {
          "type": "image_item",
          "settings": {
            "desktop_span": "2",
            "mobile_span": "2"
          }
        }
      ]
    }
  ]
}
{% endschema %}