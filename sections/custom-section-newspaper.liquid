{% comment %}
  Section: Newsletter Subscribe Bar
{% endcomment %}

<section id="shopify-section-{{ section.id }}" class="newsletter-bar">
  <div class="newsletter-bar__inner page-width">
    <div class="newsletter-bar__content">
      <div class="newsletter-bar__text">
        {% if section.settings.heading != blank %}
          <h2 class="newsletter-bar__heading">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.subheading != blank %}
          <div class="newsletter-bar__subheading">{{ section.settings.subheading }}</div>
        {% endif %}
      </div>

      <div class="newsletter-bar__form-wrap">
        {% form 'customer', class: 'newsletter-bar__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">

          <div class="newsletter-bar__field">
            <input
              type="email"
              name="contact[email]"
              class="newsletter-bar__input"
              value="{% if form.email %}{{ form.email }}{% endif %}"
              placeholder="{{ section.settings.placeholder }}"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              {% if form.errors %}aria-invalid="true"{% endif %}
              required
            >

            <button type="submit" class="newsletter-bar__button">
              {{ section.settings.button_label }}
            </button>
          </div>

          {% if form.posted_successfully? %}
            <p class="newsletter-bar__message newsletter-bar__message--success">
              {{ section.settings.success_text }}
            </p>
          {% endif %}

          {% if form.errors %}
            <p class="newsletter-bar__message newsletter-bar__message--error">
              {{ form.errors | default_errors }}
            </p>
          {% endif %}
        {% endform %}
      </div>
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }}.newsletter-bar {
    background: {{ section.settings.section_bg }};
  }

  #shopify-section-{{ section.id }} .newsletter-bar__inner {
    padding: 60px 70px;
  }

  #shopify-section-{{ section.id }} .newsletter-bar__content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  #shopify-section-{{ section.id }} .newsletter-bar__text {
    flex: 0 0 50%;
  }

  #shopify-section-{{ section.id }} .newsletter-bar__heading {
    margin: 0 0 4px;
    font-size: 32px;
    line-height: 36px;
    font-weight: 800;
    color: {{ section.settings.heading_color }};
  }

  #shopify-section-{{ section.id }} .newsletter-bar__subheading {
    font-size: 16px;
    line-height: 16px;
    font-weight: 400;
    color: {{ section.settings.subheading_color }};
  }

  #shopify-section-{{ section.id }} .newsletter-bar__form-wrap {
    flex: 1 1 50%;
  }

  #shopify-section-{{ section.id }} .newsletter-bar__form {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .newsletter-bar__field {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  #shopify-section-{{ section.id }} .newsletter-bar__input {
    width: 100%;
    min-width: 0;
    height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    border: 1px solid {{ section.settings.input_border }};
    background: {{ section.settings.input_bg }};
    color: {{ section.settings.input_text }};
    font-size: 12px;
    line-height: 16px;
    outline: none;
    box-shadow: none;
  }

  #shopify-section-{{ section.id }} .newsletter-bar__input::placeholder {
    color: {{ section.settings.placeholder_color }};
    opacity: 1;
  }

  #shopify-section-{{ section.id }} .newsletter-bar__button {
    flex: 0 0 auto;
    height: 44px;
    min-width: 94px;
    padding: 0 20px;
    border: 0;
    border-radius: 999px;
    background: #f39a1e;
    color: #ffffff;
    font-size: 10px;
    line-height: 14px;
    font-weight: 400;
    text-transform: uppercase;
    cursor: pointer;
    font-family: 'Lato';
    font-size: 14px;
}

  #shopify-section-{{ section.id }} .newsletter-bar__message {
    margin: 10px 0 0;
    font-size: 11px;
    line-height: 16px;
  }

  #shopify-section-{{ section.id }} .newsletter-bar__message--success {
    color: {{ section.settings.success_color }};
  }

  #shopify-section-{{ section.id }} .newsletter-bar__message--error {
    color: {{ section.settings.error_color }};
  }

  #shopify-section-{{ section.id }} .newsletter-bar__message ul {
    margin: 0;
    padding-left: 16px;
  }
  @media screen and (max-width: 989px){
    #shopify-section-{{ section.id }} .newsletter-bar__content {
      flex-direction: column;
}
  #shopify-section-{{ section.id }} .newsletter-bar__form-wrap {
    flex: unset;
    width: 100%;
}
#shopify-section-{{ section.id }} .newsletter-bar__text {
    flex: unset;
    width: 100%;
}
#shopify-section-{{ section.id }} .newsletter-bar__heading {
    text-align: center;
}
#shopify-section-{{ section.id }} .newsletter-bar__subheading {
    text-align: center;
}
#shopify-section-{{ section.id }} .newsletter-bar__field {
    flex-direction: row;
}
#shopify-section-{{ section.id }} .newsletter-bar__input {
    width: 70%;
}
#shopify-section-{{ section.id }} .newsletter-bar__button {
    width: 30%;
}
  }
  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .newsletter-bar__inner {
      padding: 60px 16px;
}


    #shopify-section-{{ section.id }} .newsletter-bar__content {
      flex-direction: column;
      align-items: flex-start;
    }

    #shopify-section-{{ section.id }} .newsletter-bar__text {
      max-width: 100%;
    }

    #shopify-section-{{ section.id }} .newsletter-bar__form-wrap {
      width: 100%;
      max-width: 100%;
    }

    #shopify-section-{{ section.id }} .newsletter-bar__field {
      flex-direction: row;
      align-items: stretch;
    }
    #shopify-section-{{ section.id }} h2.newsletter-bar__heading{
      font-size: 20px;
      line-height: 27px;
    }
    #shopify-section-{{ section.id }} .newsletter-bar__subheading{
      font-size: 14px;
    }
  }
  @media screen and (max-width: 450px){
    #shopify-section-{{ section.id }} .newsletter-bar__input {
    width: 60%;
}
#shopify-section-{{ section.id }} .newsletter-bar__button {
    width: 40%;
}
  }
</style>

{% schema %}
{
  "name": "Newsletter Subscribe Bar",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stay Updated with Stretchable Covers"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Be the first to know about new designs, custom solutions, and product updates."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success text",
      "default": "Thanks for subscribing."
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background color",
      "default": "#123764"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#D9E4F2"
    },
    {
      "type": "color",
      "id": "input_bg",
      "label": "Input background",
      "default": "#123764"
    },
    {
      "type": "color",
      "id": "input_border",
      "label": "Input border",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "input_text",
      "label": "Input text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "placeholder_color",
      "label": "Placeholder color",
      "default": "#D9E4F2"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#F39A1E"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "success_color",
      "label": "Success text color",
      "default": "#B9F6CA"
    },
    {
      "type": "color",
      "id": "error_color",
      "label": "Error text color",
      "default": "#FFD1D1"
    }
  ],
  "presets": [
    {
      "name": "Newsletter Subscribe Bar"
    }
  ]
}
{% endschema %}