<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.css"
/>
<script src="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.js"></script>

<div class="image-swiper image-swiper--{{ section.id }} {{ section.settings.section_version }}" style="--section-background: {{ section.settings.background }};">
  <div class="image-swiper-heading">
    {% if section.settings.rating != blank %}
      <div class="image-swiper-rating">
        <div class="image-swiper-stars">
          {% for i in (1..5) %}
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M6.99917 11.156L10.4971 13.2671C11.049 13.6001 11.7297 13.1052 11.5833 12.478L10.6548 8.49859L13.7458 5.82077C14.2329 5.3991 13.9725 4.59872 13.3305 4.54451L9.26166 4.19958L7.67003 0.444015C7.41872 -0.148005 6.57962 -0.148005 6.32831 0.444015L4.73668 4.19958L0.667863 4.54451C0.0258625 4.59872 -0.234598 5.3991 0.252534 5.82077L3.34357 8.49859L2.41506 12.478C2.26864 13.1052 2.94936 13.6001 3.50125 13.2671L6.99917 11.156Z" fill="#FFCE0C"/>
            </svg>
          {% endfor %}
        </div>
        <p>{{ section.settings.rating }}</p>
      </div>
    {% endif %}

    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.description }}</p>
  </div>

  <div class="swiper">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        <div class="swiper-slide">
          {% if block.settings.image != blank %}
            <img src="{{ block.settings.image | image_url }}" width="512" height="512" loading="lazy">
          {% endif %}

          {% if section.settings.section_version == 'version-1' %}
            <p>{{ block.settings.subheading }}</p>
            <h4>{{ block.settings.heading }}</h4>
          {% else %}
            <h4>{{ block.settings.heading }}</h4>
            <p>{{ block.settings.subheading }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    <div class="swiper-interactives">
      <button type="button" class="custom-swiper-button-prev" aria-label="Previous slide">
        <svg width="31" height="31" viewBox="0 0 31 31" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="30.5722" y="30.5722" width="30.1851" height="30.1851" rx="15.0926" transform="rotate(180 30.5722 30.5722)" fill="#0F2E53"/>
          <rect x="30.5722" y="30.5722" width="30.1851" height="30.1851" rx="15.0926" transform="rotate(180 30.5722 30.5722)" stroke="#0F2E53" stroke-width="0.773978"/>
          <path d="M17.0276 11.2228L12.3837 15.8666L17.0276 20.5105" stroke="white" stroke-width="1.54796" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <div class="swiper-pagination"></div>

      <button type="button" class="custom-swiper-button-next" aria-label="Next slide">
        <svg width="31" height="31" viewBox="0 0 31 31" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="0.386989" y="-0.386989" width="30.1851" height="30.1851" rx="15.0926" transform="matrix(1 0 0 -1 0 30.1853)" fill="#0F2E53"/>
          <rect x="0.386989" y="-0.386989" width="30.1851" height="30.1851" rx="15.0926" transform="matrix(1 0 0 -1 0 30.1853)" stroke="#0F2E53" stroke-width="0.773978"/>
          <path d="M13.9316 11.2228L18.5755 15.8666L13.9316 20.5105" stroke="white" stroke-width="1.54796" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </div>
</div>

{% style %}
.image-swiper--{{ section.id }} .swiper.swiper-initialized.swiper-horizontal.swiper-backface-hidden {
    margin-top: 30px !important;
}
.image-swiper--{{ section.id }} {
  background: var(--section-background);
  padding: 60px 70px;
}

.image-swiper--{{ section.id }} .image-swiper-rating {
  display: inline-flex;
  gap: 5px;
}

.image-swiper--{{ section.id }} .image-swiper-rating p {
  margin: auto;
  margin-left: 2px;
}

.image-swiper--{{ section.id }} .image-swiper-stars {
  display: flex;
  gap: 2px;
  align-items: center;
  justify-content: center;
}

.image-swiper--{{ section.id }} .swiper-interactives > * {
  position: unset !important;
}

.image-swiper--{{ section.id }} .swiper-interactives {
  margin-top: 5px;
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
}

.image-swiper--{{ section.id }} .custom-swiper-button-prev,
.image-swiper--{{ section.id }} .custom-swiper-button-next {
  border: 0;
  background: transparent;
  padding: 0;
  margin: 0;
  cursor: pointer;
  line-height: 0;
}

@media screen and (min-width: 640px) {
  .image-swiper--{{ section.id }} .swiper-interactives {
    display: none;
  }
}

.image-swiper--{{ section.id }} .image-swiper-heading > * {
  margin: auto;
  margin-bottom: 10px;
  color:#0F2E53;
}

.image-swiper--{{ section.id }}.version-2 .swiper-slide > h4 {
  max-width: 400px;
}

.image-swiper--{{ section.id }}.version-2 .swiper-slide > p {
  max-width: 300px;
}

.image-swiper--{{ section.id }} .swiper-slide > * {
  margin: auto;
  margin-bottom: 5px;
}

.image-swiper--{{ section.id }} .swiper-slide > p {
  font-family: Lato;
  font-weight: 500;
  font-size: 16px;
  line-height: 24px;
  letter-spacing: 0%;
  text-align: center;
  color: #5F5F5F;
}

.image-swiper--{{ section.id }} .swiper-slide > h4 {
  font-family: Raleway;
  font-weight: 800;
  font-size: 24px;
  line-height: 32px;
  letter-spacing: 0%;
  text-align: center;
}

.image-swiper--{{ section.id }} .image-swiper-heading {
  text-align: center;
}

.image-swiper--{{ section.id }} .swiper-slide {
  text-align: center;
}

.image-swiper--{{ section.id }} .swiper-slide img {
  margin-bottom: 20px;
  width: 100%;
  height: auto;
}

.image-swiper--{{ section.id }}.version-1 .swiper-slide img {
  overflow: hidden;
  border-radius: 12px;
  border: 1px solid #C5C5C5;
}

.image-swiper--{{ section.id }}.version-2 .swiper-slide img {
  max-width: 150px;
}

.image-swiper--{{ section.id }} .swiper {
  margin: 0 !important;
}

/* DEFAULT DESKTOP/TABLET BULLETS */
.image-swiper--{{ section.id }} .swiper-pagination {
  position: static !important;
  display: flex !important;
  align-items: center;
  justify-content: center;
  gap: 6px;
}

.image-swiper--{{ section.id }} .swiper-pagination-bullet {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  opacity: 1;
  background: #ffffff;
}

.image-swiper--{{ section.id }} .swiper-pagination-bullet-active {
  background: #EB891B;
}

.image-swiper--{{ section.id }} .image-swiper-heading h2 {
  font-size: 32px !important;
}

/* ONLY 639PX BELOW: DOT STYLE FROM SECOND CODE */
@media screen and (max-width: 639px) {
  .image-swiper--{{ section.id }} .swiper {
    margin: 2rem;
  }

  .image-swiper--{{ section.id }} .swiper-pagination {
    position: static !important;
    display: flex !important;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: auto !important;
  }

  .image-swiper--{{ section.id }} .swiper-pagination-bullet {
    width: 20px !important;
    height: 20px !important;
    margin: 0 !important;
    padding: 0 !important;
    border-radius: 50%;
    border: 0 !important;
    background: transparent !important;
    opacity: 1 !important;
    display: flex !important;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    transition: all 0.25s ease;
    position: relative;
  }

  .image-swiper--{{ section.id }} .swiper-pagination-bullet::before {
    content: "";
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #C5C5C5;
    transition: all 0.25s ease;
  }

  .image-swiper--{{ section.id }} .swiper-pagination-bullet-active {
    width: 20px !important;
    height: 20px !important;
    border: 2px solid #EB891B !important;
    background: transparent !important;
  }

  .image-swiper--{{ section.id }} .swiper-pagination-bullet-active::before {
    width: 10px;
    height: 10px;
    background: #EB891B;
  }
}

@media screen and (max-width: 768px) {
  .image-swiper--{{ section.id }} {
    padding: 40px 16px;
  }

  .image-swiper--{{ section.id }} .image-swiper-heading h2 {
    font-size: 28px !important;
  }
}

@media screen and (max-width: 500px) {
  .image-swiper--{{ section.id }} .image-swiper-heading h2 {
    font-size: 20px !important;
  }
}
{% endstyle %}

<script>
  (function () {
    function initImageSwiper{{ section.id | replace: '-', '_' }}() {
      var section = document.querySelector('.image-swiper--{{ section.id }}');

      if (!section || section.dataset.swiperInitialized === 'true') return;

      var swiperEl = section.querySelector('.swiper');
      var paginationEl = section.querySelector('.swiper-pagination');
      var nextEl = section.querySelector('.custom-swiper-button-next');
      var prevEl = section.querySelector('.custom-swiper-button-prev');

      if (!swiperEl) return;

      section.dataset.swiperInitialized = 'true';

      new Swiper(swiperEl, {
        loop: true,
        pagination: {
          el: paginationEl,
          clickable: true
        },
        navigation: {
          nextEl: nextEl,
          prevEl: prevEl
        },
        slidesPerView: 1,
        spaceBetween: 20,
        breakpoints: {
          640: {
            slidesPerView: 3
          }
        }
      });
    }

    document.addEventListener('DOMContentLoaded', initImageSwiper{{ section.id | replace: '-', '_' }});
    document.addEventListener('shopify:section:load', initImageSwiper{{ section.id | replace: '-', '_' }});
  })();
</script>

{% schema %}
{
  "name": "Image swiper",
  "settings": [
    {
      "type": "select",
      "id": "section_version",
      "label": "Version",
      "options": [
        {
          "label": "Version 1",
          "value": "version-1"
        },
        {
          "label": "Version 2",
          "value": "version-2"
        }
      ],
      "default": "version-1"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#F6F6F6"
    },
    {
      "type": "html",
      "id": "heading",
      "label": "Heading",
      "default": "Heading"
    },
    {
      "type": "text",
      "id": "description",
      "label": "description",
      "default": "description"
    },
    {
      "type": "text",
      "id": "rating",
      "label": "Rating"
    }
  ],
  "blocks": [
    {
      "type": "block",
      "name": "Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Heading"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Sub-Heading",
          "default": "Sub-Heading"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image swiper",
      "category": "Custom section by AJ"
    }
  ]
}
{% endschema %}