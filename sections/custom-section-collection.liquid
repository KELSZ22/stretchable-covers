{% comment %}
  Section: Image Text Link Slider
{% endcomment %}

<div id="shopify-section-{{ section.id }}" class="acs-section">
  <div class="page-width">
    <div class="acs-header">
      <div class="acs-header__content">
        {% if section.settings.heading != blank %}
          <h2 class="acs-heading">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.subheading != blank %}
          <div class="acs-subheading">{{ section.settings.subheading }}</div>
        {% endif %}
      </div>

      {% if section.settings.view_all_text != blank %}
        <a href="{{ section.settings.view_all_link | default: routes.collections_url }}" class="acs-view-all">
          {{ section.settings.view_all_text }}
        </a>
      {% endif %}
    </div>

    <div class="acs-slider-wrap">
      <button class="acs-arrow acs-arrow--prev" type="button" aria-label="Previous">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M14 6L8 12L14 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <div
        class="acs-slider"
        data-slider
        data-autoplay="{{ section.settings.enable_autoplay }}"
        data-autoplay-speed="{{ section.settings.autoplay_speed }}"
      >
        <div class="acs-slider__track" data-slider-track>
          {% for block in section.blocks %}
            {% assign card_image = block.settings.image %}
            {% assign card_title = block.settings.text %}
            {% assign card_url = block.settings.url %}
            {% assign card_alt = card_title %}

            {% if card_image != blank and card_image.alt != blank %}
              {% assign card_alt = card_image.alt %}
            {% endif %}

            {% capture card_content %}
              <div class="acs-card__media">
                {% if card_image != blank %}
                  <img
                    src="{{ card_image | image_url: width: 900 }}"
                    alt="{{ card_alt | escape }}"
                    loading="lazy"
                    width="{{ card_image.width }}"
                    height="{{ card_image.height }}"
                    class="acs-card__image"
                  >
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'acs-card__placeholder' }}
                {% endif %}

                <div class="acs-card__overlay"></div>

                {% if card_title != blank %}
                  <div class="acs-card__title">{{ card_title }}</div>
                {% endif %}
              </div>
            {% endcapture %}

            {% if card_url != blank %}
              <a href="{{ card_url }}" class="acs-card" {{ block.shopify_attributes }}>
                {{ card_content }}
              </a>
            {% else %}
              <div class="acs-card" {{ block.shopify_attributes }}>
                {{ card_content }}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <button class="acs-arrow acs-arrow--next" type="button" aria-label="Next">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M10 6L16 12L10 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </div>
</div>

<style>
  #shopify-section-{{ section.id }}.acs-section {
    background: {{ section.settings.section_bg }}0A;
    padding: 0px 60px 70px;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .acs-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 18px;
  }

  #shopify-section-{{ section.id }} .acs-heading {
    margin: 0 0 4px;
    font-size: 32px;
    line-height: normal;
    font-weight: 800;
    color: {{ section.settings.heading_color }};
  }

  #shopify-section-{{ section.id }} .acs-subheading {
    font-size: 16px;
    line-height: 18px;
    color: {{ section.settings.subheading_color }};
  }

  #shopify-section-{{ section.id }} .acs-view-all {
    flex: 0 0 auto;
    font-size: 16px;
    line-height: 18px;
    color: {{ section.settings.link_color }};
    text-decoration: underline;
    font-weight: 600;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .acs-view-all:hover {
    opacity: 0.8;
  }

  #shopify-section-{{ section.id }} .acs-slider-wrap {
    position: relative;
  }

  #shopify-section-{{ section.id }} .acs-slider {
    overflow: hidden;
    position: relative;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .acs-slider__track {
    display: flex;
    gap: 14px;
    will-change: transform;
    transform: translate3d(0, 0, 0);
  }

  #shopify-section-{{ section.id }} .acs-card {
    position: relative;
    flex: 0 0 calc((100% - 56px) / 5);
    min-width: calc((100% - 56px) / 5);
    border-radius: {{ section.settings.card_radius }}px;
    overflow: hidden;
    text-decoration: none;
    background: #111111;
    display: block;
  }

  #shopify-section-{{ section.id }} .acs-card__media {
    position: relative;
    aspect-ratio: 1 / 1.08;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .acs-card__image,
  #shopify-section-{{ section.id }} .acs-card__placeholder {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .acs-card__placeholder {
    background: #d9d9d9;
  }

  #shopify-section-{{ section.id }} .acs-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.15) 0%, rgba(0, 0, 0, 0.65) 100%);
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .acs-card__title {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    color: #ffffff;
    font-size: 20px;
    line-height: 24px;
    font-weight: 600;
    text-align: center;
    padding: 0 12px;
  }

  #shopify-section-{{ section.id }} .acs-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 28px;
    height: 28px;
    border: 0;
    border-radius: 999px;
    background: #ffffff;
    color: #111111;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 3;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .acs-arrow svg {
    width: 16px;
    height: 16px;
    display: block;
  }

  #shopify-section-{{ section.id }} .acs-arrow--prev {
    left: -14px;
  }

  #shopify-section-{{ section.id }} .acs-arrow--next {
    right: -14px;
  }

  @media screen and (max-width: 1024px) {
    #shopify-section-{{ section.id }} .acs-card {
      flex: 0 0 calc((100% - 28px) / 3);
      min-width: calc((100% - 28px) / 3);
    }

    #shopify-section-{{ section.id }} .acs-header {
      align-items: center;
      flex-direction: column;
    }

    #shopify-section-{{ section.id }} .acs-heading {
      text-align: center;
    }

    #shopify-section-{{ section.id }} .acs-subheading {
      text-align: center;
    }
  }

  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }}.acs-section {
      padding: {{ section.settings.padding_top_mobile }}px 16px {{ section.settings.padding_bottom_mobile }}px;
      overflow: visible;
    }

    #shopify-section-{{ section.id }} .acs-heading {
      font-size: 20px;
      line-height: 26px;
    }

    #shopify-section-{{ section.id }} .acs-subheading,
    #shopify-section-{{ section.id }} .acs-view-all {
      font-size: 14px;
      line-height: 16px;
    }

    #shopify-section-{{ section.id }} .acs-card__title {
      font-size: 14px;
      line-height: 18px;
    }

    #shopify-section-{{ section.id }} .acs-arrow {
      display: none !important;
    }

    #shopify-section-{{ section.id }} .acs-slider {
      overflow: visible;
    }

    #shopify-section-{{ section.id }} .acs-slider__track {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
      transform: none !important;
      transition: none !important;
      will-change: auto;
    }

    #shopify-section-{{ section.id }} .acs-card {
      flex: none;
      min-width: 0;
      width: 100%;
      display: block;
    }

    #shopify-section-{{ section.id }} .acs-card:nth-child(n + 5) {
      display: none !important;
    }
  }
</style>

<script>
  (function() {
    var section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;

    var slider = section.querySelector('[data-slider]');
    var track = section.querySelector('[data-slider-track]');
    var prevBtn = section.querySelector('.acs-arrow--prev');
    var nextBtn = section.querySelector('.acs-arrow--next');

    if (!slider || !track || !prevBtn || !nextBtn) return;

    var autoplayEnabled = slider.getAttribute('data-autoplay') === 'true';
    var autoDelay = (parseInt(slider.getAttribute('data-autoplay-speed'), 10) || 4) * 1000;
    var autoSlide = null;
    var resizeTimer = null;
    var currentIndex = 0;
    var clonesPerSide = 0;
    var isAnimating = false;

    function isGridMode() {
      return window.innerWidth <= 767;
    }

    function getOriginalCards() {
      return Array.prototype.slice.call(track.querySelectorAll('.acs-card:not(.is-clone)'));
    }

    function getGap() {
      return parseInt(window.getComputedStyle(track).gap || 14, 10);
    }

    function getStep() {
      var firstCard = track.querySelector('.acs-card');
      if (!firstCard) return 300;
      return firstCard.getBoundingClientRect().width + getGap();
    }

    function getVisibleCount() {
      var step = getStep();
      if (!step) return 1;
      return Math.max(1, Math.round(slider.clientWidth / step));
    }

    function canLoop(originalCount, visibleCount) {
      if (originalCount <= 1) return false;
      if (originalCount > visibleCount) return true;
      if (originalCount === visibleCount && originalCount >= 5) return true;
      return false;
    }

    function stopAutoSlide() {
      if (autoSlide) {
        clearInterval(autoSlide);
        autoSlide = null;
      }
    }

    function startAutoSlide() {
      stopAutoSlide();

      if (isGridMode()) return;

      var originals = getOriginalCards();
      var visibleCount = getVisibleCount();

      if (!autoplayEnabled || !canLoop(originals.length, visibleCount)) return;

      autoSlide = setInterval(function() {
        goToSlide(currentIndex + 1);
      }, autoDelay);
    }

    function setTrackPosition(animate) {
      var offset = currentIndex * getStep();
      track.style.transition = animate ? 'transform 0.45s ease' : 'none';
      track.style.transform = 'translate3d(-' + offset + 'px, 0, 0)';
    }

    function clearClones() {
      var clones = track.querySelectorAll('.acs-card.is-clone');
      clones.forEach(function(clone) {
        clone.remove();
      });
    }

    function makeClone(card) {
      var clone = card.cloneNode(true);
      clone.classList.add('is-clone');
      clone.setAttribute('aria-hidden', 'true');
      clone.tabIndex = -1;
      return clone;
    }

    function buildSlider() {
      stopAutoSlide();
      clearClones();

      var originals = getOriginalCards();

      if (isGridMode()) {
        prevBtn.style.display = 'none';
        nextBtn.style.display = 'none';
        currentIndex = 0;
        track.style.transition = 'none';
        track.style.transform = 'none';
        return;
      }

      var visibleCount = getVisibleCount();

      if (!canLoop(originals.length, visibleCount)) {
        prevBtn.style.display = 'none';
        nextBtn.style.display = 'none';
        currentIndex = 0;
        track.style.transition = 'none';
        track.style.transform = 'translate3d(0, 0, 0)';
        return;
      }

      prevBtn.style.display = 'flex';
      nextBtn.style.display = 'flex';

      clonesPerSide = Math.min(originals.length, visibleCount + 1);

      var prependClones = originals.slice(-clonesPerSide).map(makeClone);
      var appendClones = originals.slice(0, clonesPerSide).map(makeClone);

      for (var i = prependClones.length - 1; i >= 0; i--) {
        track.insertBefore(prependClones[i], track.firstChild);
      }

      appendClones.forEach(function(clone) {
        track.appendChild(clone);
      });

      currentIndex = clonesPerSide;
      setTrackPosition(false);

      requestAnimationFrame(function() {
        requestAnimationFrame(function() {
          track.style.transition = 'transform 0.45s ease';
        });
      });

      startAutoSlide();
    }

    function goToSlide(index) {
      if (isGridMode() || isAnimating) return;
      isAnimating = true;
      currentIndex = index;
      setTrackPosition(true);
    }

    function handleLoopReset() {
      if (isGridMode()) {
        isAnimating = false;
        return;
      }

      var originals = getOriginalCards();
      var originalCount = originals.length;

      if (currentIndex >= originalCount + clonesPerSide) {
        currentIndex = clonesPerSide;
        setTrackPosition(false);
      } else if (currentIndex < clonesPerSide) {
        currentIndex = originalCount + clonesPerSide - 1;
        setTrackPosition(false);
      }

      requestAnimationFrame(function() {
        isAnimating = false;
      });
    }

    prevBtn.addEventListener('click', function() {
      stopAutoSlide();
      goToSlide(currentIndex - 1);
      startAutoSlide();
    });

    nextBtn.addEventListener('click', function() {
      stopAutoSlide();
      goToSlide(currentIndex + 1);
      startAutoSlide();
    });

    track.addEventListener('transitionend', function(event) {
      if (event.target !== track) return;
      handleLoopReset();
    });

    slider.addEventListener('mouseenter', stopAutoSlide);
    slider.addEventListener('mouseleave', startAutoSlide);
    slider.addEventListener('touchstart', stopAutoSlide, { passive: true });
    slider.addEventListener('touchend', startAutoSlide);

    window.addEventListener('resize', function() {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function() {
        buildSlider();
      }, 200);
    });

    buildSlider();
  })();
</script>

{% schema %}
{
  "name": "Image Text Link Slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Collections"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all text",
      "default": "View All"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link"
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Enable autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "sec",
      "default": 4
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Background color",
      "default": "#F2F2F2"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 6
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile padding top",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile padding bottom",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Image slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Slide title"
        },
        {
          "type": "url",
          "id": "url",
          "label": "URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Text Link Slider",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}