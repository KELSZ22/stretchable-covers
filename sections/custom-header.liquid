<script>
document.addEventListener('DOMContentLoaded', function () {
  const mobileBreakpoint = 767;
  const marquees = document.querySelectorAll('marquee.custom-header-topbar.mobile');

  marquees.forEach(function (marquee) {
    if (marquee.dataset.jsMarqueeInit === 'true') return;
    marquee.dataset.jsMarqueeInit = 'true';

    const source = marquee.querySelector('.marquee-container');
    if (!source) return;

    const sourceHTML = source.innerHTML;
    let wrapper = null;
    let viewport = null;
    let track = null;
    let resizeTimer = null;

    function createWrapper() {
      wrapper = document.createElement('div');
      wrapper.className = 'custom-header-topbar mobile js-marquee';

      viewport = document.createElement('div');
      viewport.className = 'marquee-viewport';

      track = document.createElement('div');
      track.className = 'marquee-track';

      viewport.appendChild(track);
      wrapper.appendChild(viewport);

      marquee.insertAdjacentElement('afterend', wrapper);
    }

    function buildMarquee() {
      if (!wrapper) createWrapper();

      if (window.innerWidth > mobileBreakpoint) {
        wrapper.style.display = 'none';
        marquee.style.display = '';
        return;
      }

      wrapper.style.display = 'block';
      marquee.style.display = 'none';

      track.innerHTML = '';

      const group = document.createElement('div');
      group.className = 'marquee-group';
      track.appendChild(group);

      let loops = 0;
      const minWidth = Math.max(viewport.clientWidth, window.innerWidth, 320) + 100;

      while (group.scrollWidth < minWidth && loops < 10) {
        const chunk = document.createElement('div');
        chunk.className = 'marquee-container';
        chunk.innerHTML = sourceHTML;
        group.appendChild(chunk);
        loops++;
      }

      if (!group.children.length) return;

      const clone = group.cloneNode(true);
      clone.setAttribute('aria-hidden', 'true');
      track.appendChild(clone);

      wrapper.style.setProperty('--loop-width', group.scrollWidth + 'px');
    }

    function handleResize() {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(buildMarquee, 120);
    }

    buildMarquee();
    window.addEventListener('resize', handleResize);
  });
});
</script>

<script>
  (function() {
    var btn = document.getElementById('mobileMenuBtn');
    var drawer = document.getElementById('mobileNavDrawer');
    var overlay = document.getElementById('mobileNavOverlay');
    var closeBtn = document.getElementById('mobileDrawerClose');

    function openDrawer() {
      drawer.classList.add('open');
      overlay.classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      drawer.classList.remove('open');
      overlay.classList.remove('open');
      document.body.style.overflow = '';
    }

    btn && btn.addEventListener('click', openDrawer);
    closeBtn && closeBtn.addEventListener('click', closeDrawer);
    overlay && overlay.addEventListener('click', closeDrawer);

    document.querySelectorAll('.mobile-sub-toggle').forEach(function(toggle) {
      toggle.addEventListener('click', function() {
        var targetId = this.getAttribute('data-target');
        var sub = document.getElementById(targetId);
        var isOpen = sub.classList.contains('open');
        document.querySelectorAll('.mobile-submenu.open').forEach(function(el) { el.classList.remove('open'); });
        document.querySelectorAll('.mobile-sub-toggle.active').forEach(function(el) { el.classList.remove('active'); });
        if (!isOpen) {
          sub.classList.add('open');
          this.classList.add('active');
        }
      });
    });
  })();
</script>

<script>
  (function() {
    var trigger = document.getElementById('customCartTrigger');
    var drawer = document.getElementById('customCartDrawer');
    var overlay = document.getElementById('customCartOverlay');
    var closeBtn = document.getElementById('customCartClose');
    var bodyEl = document.getElementById('customCartBody');
    var footerEl = document.getElementById('customCartFooter');
    var countEl = document.getElementById('customCartCount');
    var subtotalEl = document.getElementById('customCartSubtotal');
    var itemLabelEl = document.getElementById('customCartItemLabel');

    var bestSellers = [
      {% assign best_seller_products = '' %}
      {% if section.settings.best_seller_1 != blank %}
        {% assign best_seller_products = best_seller_products | append: section.settings.best_seller_1.handle %}
      {% endif %}
      {% if section.settings.best_seller_2 != blank %}
        {% if best_seller_products != blank %}{% assign best_seller_products = best_seller_products | append: ',' %}{% endif %}
        {% assign best_seller_products = best_seller_products | append: section.settings.best_seller_2.handle %}
      {% endif %}
      {% if section.settings.best_seller_3 != blank %}
        {% if best_seller_products != blank %}{% assign best_seller_products = best_seller_products | append: ',' %}{% endif %}
        {% assign best_seller_products = best_seller_products | append: section.settings.best_seller_3.handle %}
      {% endif %}

      {% assign bs_products = best_seller_products | split: ',' %}
      {% for product_handle in bs_products %}
        {% assign bs_product = all_products[product_handle] %}
        {% if bs_product != blank %}
          {
            title: {{ bs_product.title | json }},
            price: {{ bs_product.price | money | json }},
            image: {{ bs_product.featured_image | image_url: width: 160 | json }},
            url: {{ bs_product.url | json }},
            diameter: {{ bs_product.metafields.custom.diameter.value | default: bs_product.metafields.custom.diameter | json }}
          }{% unless forloop.last %},{% endunless %}
        {% endif %}
      {% endfor %}
    ];

    function escapeHtml(str) {
      return String(str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function money(cents) {
      cents = Number(cents || 0);

      if (window.Shopify && typeof window.Shopify.formatMoney === 'function') {
        return window.Shopify.formatMoney(cents, "{{ shop.money_format | escape }}");
      }

      return new Intl.NumberFormat('en-US', {
        style: 'currency',
        currency: '{{ cart.currency.iso_code | default: shop.currency }}'
      }).format(cents / 100);
    }

    function getItemImage(item) {
      if (!item) return '';
      if (typeof item.image === 'string' && item.image !== '') {
        return item.image;
      }
      if (item.featured_image && item.featured_image.url) {
        return item.featured_image.url;
      }
      if (item.featured_image && typeof item.featured_image === 'string') {
        return item.featured_image;
      }
      return '';
    }

    function getDiameterValue(item) {
      var props = item.properties || {};
      var diameter = '';

      if (props.product_variant_diameter) diameter = props.product_variant_diameter;
      else if (props.product_diameter) diameter = props.product_diameter;
      else if (props.Diameter) diameter = props.Diameter;
      else if (props.diameter) diameter = props.diameter;

      if (!diameter || String(diameter).trim() === '') return '';

      return String(diameter).trim();
    }

    function getDiameterHtml(item) {
      var diameter = getDiameterValue(item);

      if (!diameter) return '';

      return `
        <div class="custom-cart-item-meta">
          Diameter <span class="custom-cart-item-meta-icon">
            <svg viewBox="0 0 16 16" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
              <circle cx="8" cy="8" r="6.25" fill="none" stroke="#8a8a8a" stroke-width="1.2"></circle>
              <line x1="11.8" y1="4.2" x2="4.2" y2="11.8" stroke="#8a8a8a" stroke-width="1.2" stroke-linecap="round"></line>
            </svg>
          </span>
          <span>${escapeHtml(diameter)}</span>
        </div>
      `;
    }

    function getVariantDiameterText(item) {
      var diameter = getDiameterValue(item);

      if (!diameter) return '';

      return 'Diameter (' + diameter + ')';
    }

    function bestSellersHtml() {
      return bestSellers.map(function(item) {
        var diameterHtml = '';

        if (item.diameter && String(item.diameter).trim() !== '') {
          diameterHtml = `
            <div class="custom-rec-meta">
              <span class="custom-rec-meta-label">Diameter</span>
              <svg class="custom-rec-meta-icon" viewBox="0 0 16 16" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                <circle cx="8" cy="8" r="6.25" fill="none" stroke="#8a8a8a" stroke-width="1.2"></circle>
                <line x1="11.8" y1="4.2" x2="4.2" y2="11.8" stroke="#8a8a8a" stroke-width="1.2" stroke-linecap="round"></line>
              </svg>
              <span class="custom-rec-meta-value">${escapeHtml(item.diameter)}</span>
            </div>
          `;
        }

        return `
          <div class="custom-rec-item">
