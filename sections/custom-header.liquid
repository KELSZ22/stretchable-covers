{% comment %}{% endcomment %}
{%- assign header_menu = section.settings.menu -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Lato:wght@100;300;400;700;900&display=swap');

  .header-search {
    width: 100%;
  }

  .header-search form {
    display: flex;
    align-items: center;
    width: 100%;
    max-width: 100%;
    height: 42px;
    padding: 0 16px 0 20px;
    background: #f7f7f7;
    border: 1px solid #cfcfcf;
    border-radius: 999px;
    box-sizing: border-box;
  }

  .header-search input[type="text"] {
    flex: 1;
    border: 0;
    outline: 0;
    background: transparent;
    font-family: 'Lato', sans-serif;
    font-size: 16px;
    font-weight: 400;
    color: #444;
    padding: 0;
    margin: 0;
    box-shadow: none;
  }

  .header-search input[type="text"]::placeholder {
    color: #777;
    opacity: 1;
  }

  .header-search input[type="text"]:focus {
    outline: none;
    box-shadow: none;
  }

  .header-search button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    padding: 0;
    margin: 0;
    background: transparent;
    border: 0;
    cursor: pointer;
    flex-shrink: 0;
  }

  .header-search button svg {
    width: 20px;
    height: 20px;
    display: block;
  }

  .header-search button svg circle,
  .header-search button svg line {
    stroke: #333;
    stroke-width: 2;
  }

  .topbar-promos span,
  .topbar-right span {
    font-family: 'Lato', sans-serif;
  }

  .custom-header-wrapper {
    font-family: Arial, Helvetica, sans-serif;
    width: 100%;
    position: sticky;
    top: 0;
    z-index: 1000;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
  }

  .custom-topbar-container {
    background: #e05a00;
    display: flex;
    justify-content: center;
  }

  .custom-header-topbar {
    width: 100%;
    color: #fff;
    font-size: 14px;
    padding: 15px 70px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .topbar-promos {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .topbar-promos span {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .topbar-promos .dot {
    width: 5px;
    height: 5px;
    background: #fff;
    border-radius: 50%;
    display: inline-block;
  }

  .topbar-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .topbar-right a {
    color: #fff;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 13px;
  }

  .topbar-right svg {
    width: 18px;
    height: 18px;
    fill: #fff;
  }

  .topbar-flag {
    display: flex;
    align-items: center;
    gap: 4px;
    cursor: pointer;
    font-size: 13px;
    color: #fff;
  }

  .custom-header-container {
    display: flex;
    justify-content: center;
    background: #0F2E530F;
  }

  .custom-header-main {
    display: flex;
    align-items: center;
    padding: 15px 70px;
    gap: 50px;
    width: 100%;
  }

  .header-logo a {
    display: block;
    text-decoration: none;
  }

  .header-logo img {
    max-height: 55px;
    width: auto;
    display: block;
  }

  .header-logo .logo-text {
    font-size: 22px;
    font-weight: 700;
    color: #e05a00;
    text-decoration: none;
    white-space: nowrap;
  }

  .header-search {
    flex: 1;
    display: flex;
    align-items: center;
    border-radius: 4px;
    overflow: hidden;
  }

  .header-search input {
    flex: 1;
    border: none;
    outline: none;
    padding: 9px 14px;
    font-size: 14px;
    background: transparent;
    color: #333;
  }

  .header-search input::placeholder {
    color: #999;
  }

  .header-search button {
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
  }

  .header-search button svg {
    width: 20px;
    height: 20px;
    fill: #555;
  }

  .header-icons {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-left: auto;
  }

  .header-icons a {
    display: flex;
    align-items: center;
    color: #333;
    text-decoration: none;
    position: relative;
  }

  .header-icons svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: #333;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .cart-count {
    position: absolute;
    top: -6px;
    right: -8px;
    background: #e05a00;
    color: #fff;
    font-size: 10px;
    border-radius: 50%;
    width: 16px;
    height: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
  }

  .custom-header-nav {
    background: #fff;
    display: flex;
    justify-content: center;
  }

  .header-nav-inner {
    display: flex;
    align-items: center;
    padding: 0 20px;
    overflow-x: auto;
    scrollbar-width: none;
    width: 100%;
    justify-content: flex-start;
    width: 1440px;

  }

  .header-nav-inner::-webkit-scrollbar {
    display: none;
  }

  .header-nav-inner > li {
    list-style: none;
    position: relative;
  }

  .header-nav-inner > li > a {
    display: block;
    padding: 13px 14px;
    font-size: 14px;
    font-weight: 400;
    color: #222;
    text-decoration: none;
    white-space: nowrap;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    transition: color 0.15s;
    font-family: 'Lato', sans-serif;
  }

  .header-nav-inner > li > a:hover {
    color: #e05a00;
  }

  .header-nav-inner > li.has-dropdown:hover > .nav-dropdown {
    display: block;
  }

  .nav-dropdown {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 200px;
    background: #fff;
    border: 1px solid #e5e5e5;
    box-shadow: 0 4px 16px rgba(0,0,0,0.1);
    z-index: 999;
    padding: 8px 0;
  }

  .nav-dropdown a {
    display: block;
    padding: 9px 18px;
    font-size: 13px;
    color: #333;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.1s, color 0.1s;
  }

  .nav-dropdown a:hover {
    background: #f5f5f5;
    color: #e05a00;
  }

  .mobile-menu-btn {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
    margin-left: 8px;
  }

  .mobile-menu-btn svg {
    width: 26px;
    height: 26px;
    stroke: #333;
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .mobile-nav-drawer {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 80%;
    max-width: 320px;
    height: 100%;
    background: #fff;
    z-index: 9999;
    overflow-y: auto;
    box-shadow: 4px 0 20px rgba(0,0,0,0.15);
    transform: translateX(-100%);
    transition: transform 0.3s ease;
  }

  .mobile-nav-drawer.open {
    transform: translateX(0);
  }

  .mobile-nav-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.4);
    z-index: 9998;
  }

  .mobile-nav-overlay.open {
    display: block;
  }

  .mobile-drawer-header {
    background: #e05a00;
    padding: 14px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #fff;
    font-weight: 700;
    font-size: 15px;
  }

  .mobile-drawer-close {
    background: none;
    border: none;
    cursor: pointer;
    color: #fff;
    font-size: 22px;
    line-height: 1;
  }

  .mobile-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .mobile-nav-list li a {
    display: block;
    padding: 13px 20px;
    font-size: 13.5px;
    font-weight: 700;
    color: #222;
    text-decoration: none;
    text-transform: uppercase;
    border-bottom: 1px solid #f0f0f0;
    letter-spacing: 0.03em;
  }

  .mobile-nav-list li a:hover {
    background: #fff5ee;
    color: #e05a00;
  }

  .mobile-nav-list .mobile-sub-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    padding: 13px 20px;
    font-size: 13.5px;
    font-weight: 700;
    color: #222;
    text-transform: uppercase;
    border-bottom: 1px solid #f0f0f0;
    letter-spacing: 0.03em;
  }

  .mobile-nav-list .mobile-sub-toggle:hover {
    background: #fff5ee;
    color: #e05a00;
  }

  .mobile-sub-toggle .arrow {
    font-size: 12px;
    transition: transform 0.2s;
  }

  .mobile-sub-toggle.active .arrow {
    transform: rotate(180deg);
  }

  .mobile-submenu {
    display: none;
    background: #f9f9f9;
  }

  .mobile-submenu.open {
    display: block;
  }

  .mobile-submenu a {
    padding-left: 36px !important;
    font-weight: 400 !important;
    text-transform: none !important;
    font-size: 13px !important;
  }

  @media (max-width: 900px) {
    .custom-header-main{
      gap: 0;
    }
    .header-search form{
      display: none;
    }
    .custom-header-nav {
      display: none;
    }

    .mobile-menu-btn {
      display: flex;
    }

    .mobile-nav-drawer {
      display: block;
    }

    .topbar-promos {
      font-size: 11px;
    }
  }

  @media (max-width: 600px) {
    .custom-header-main {
      padding: 8px 12px;
      gap: 10px;
    }


    .header-search {
      max-width: unset;
    }

    .header-logo img {
      max-height: 42px;
    }
  }

  .custom-cart-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.55);
    opacity: 0;
    visibility: hidden;
    transition: 0.25s ease;
    z-index: 9998;
  }

  .custom-cart-overlay.open {
    opacity: 1;
    visibility: visible;
  }

  .custom-cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: 100%;
    max-width: 510px;
    height: 100vh;
    background: #ffffff;
    transform: translateX(100%);
    transition: transform 0.3s ease;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    box-shadow: -8px 0 30px rgba(0,0,0,0.08);
  }

  .custom-cart-drawer.open {
    transform: translateX(0);
  }

  .custom-cart-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 30px 16px;
    border-bottom: 1px solid #ddd8d2;
  }

  .custom-cart-header h2 {
    margin: 0;
    font-size: 28px;
    line-height: 1.15;
    font-weight: 700;
    color: #222;
    font-family: 'Lato', sans-serif;
  }

  .custom-cart-header h2 span {
    font-weight: 400;
    font-size: 18px;
  }

  .custom-cart-close {
    border: 1px solid #d5d1cb;
    width: 28px;
    height: 28px;
    min-width: 28px;
    border-radius: 50%;
    background: #f3f1ee;
    cursor: pointer;
    font-size: 19px;
    line-height: 1;
    color: #7a7a7a;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }

  .custom-cart-body {
    flex: 1;
    overflow-y: auto;
    padding: 0;
  }

  .custom-cart-body.is-empty {
    display: flex;
    flex-direction: column;
  }

  .custom-cart-empty-wrap {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .custom-cart-empty {
    text-align: center;
    padding: 34px 20px 32px;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .custom-cart-empty h3 {
    color:  #1F1F1F;
    font-family: Raleway;
    font-size: 24px;
    font-style: normal;
    font-weight: 800;
    line-height: 32px; 
    margin: 0 0 8px;
  }

  .custom-cart-empty p {
    color:  #1F1F1F;
    text-align: center;
    font-family: Lato;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: 18px; 
    margin: 0 0 22px;
  }

  .custom-cart-empty .shop-now-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 210px;
    height: 40px;
    background: #e98c17;
    color: #fff;
    text-decoration: none;
    padding: 0 28px;
    border-radius: 999px;
    font-weight: 700;
    font-size: 14px;
    font-family: 'Lato', sans-serif;
    margin: 0 auto;
  }

  .custom-cart-recommendations {
    background:rgba(235, 137, 27, 0.14);
    padding: 25px 20px;
    margin-top: auto;
  }

  .custom-cart-recommendations h4 {
    text-align: center;
    color: #1F1F1F;
    font-family: Raleway;
    font-size: 20px;
    font-style: normal;
    font-weight: 800;
    line-height: 27px; 
    margin: 0 0 20px;
  }

  .custom-rec-item {
    background: #fff;
    border-radius: 4px;
    padding: 12px;
    display: grid;
    grid-template-columns: 74px 1fr auto;
    gap: 12px;
    align-items: center;
    margin-bottom: 12px;
    border: 1px solid #eee7de;
  }

  .custom-rec-item:last-child {
    margin-bottom: 0;
  }

  .custom-rec-item img {
    width: 79px;
    height: 79px;
    object-fit: cover;
    border-radius: 2.6px;
    background: #fcfdfc;
    box-shadow: 0 1.427px 1.427px 0 rgba(0, 0, 0, 0.12);
  }

  .custom-rec-content {
    min-width: 0;
  }

  .custom-rec-title {
    color: #1F1F1F;
    font-family: Lato;
    font-size: 20px;
    font-style: normal;
    font-weight: 500;
    line-height: 28px; 
    margin-bottom: 3px;
  }

  .custom-rec-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
    font-size: 13px;
    line-height: 1.35;
    color: #6b6b6b;
    margin-bottom: 3px;
    font-family: 'Lato', sans-serif;
  }

  .custom-rec-meta-label {
    color: #6b6b6b;
  }

  .custom-rec-meta-icon {
    width: 14px;
    height: 14px;
    display: inline-block;
    vertical-align: middle;
    flex: 0 0 14px;
  }

  .custom-rec-meta-value {
    color: #6b6b6b;
  }

  .custom-rec-price {
    color:  #1F1F1F;
    font-family: Lato;
    font-size: 16px;
    font-style: normal;
    font-weight: 500;
    line-height: 24px; 
  }

  .custom-rec-btn {
    background: #0F2E53;
    color: #fff;
    text-decoration: none;
    padding: 10px 14px;
    border-radius: 999px;
    font-size: 14px;
    line-height: 1;
    font-weight: 500;
    white-space: nowrap;
    font-family: 'Lato', sans-serif;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .custom-cart-item {
    display: grid;
    grid-template-columns: 104px 1fr;
    gap: 16px;
    padding: 26px 30px 0;
    border-bottom: 0;
    align-items: start;
  }

  .custom-cart-item-image {
    width: 104px;
  }

  .custom-cart-item-image img {
    width: 100%;
    height: 104px;
    object-fit: cover;
    border: 1px solid #ece7e1;
    border-radius: 3.88px;
    background: #fcfdfc;
    box-shadow: 0 2.129px 2.129px 0 rgba(0, 0, 0, 0.12);
  }

  .custom-cart-item-details {
    min-width: 0;
  }

  .custom-cart-item-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
  }

  .custom-cart-item-title {
    font-size: 16px;
    font-weight: 400;
    color: #232323;
    margin-bottom: 4px;
    line-height: 1.3;
    font-family: 'Lato', sans-serif;
  }

  .custom-cart-item-meta {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 14px;
    color: #444;
    margin-bottom: 4px;
    line-height: 1.3;
    font-family: 'Lato', sans-serif;
    display: none;
  }

  .custom-cart-item-meta-icon {
    width: 14px;
    height: 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .custom-cart-item-meta-icon svg {
    width: 14px;
    height: 14px;
  }

  .custom-cart-item-variant {
    font-size: 13px;
    color: #555;
    margin-bottom: 4px;
    line-height: 1.3;
    font-family: 'Lato', sans-serif;
  }

  .custom-cart-item-price {
    font-size: 14px;
    color: #222;
    margin-bottom: 10px;
    font-family: 'Lato', sans-serif;
  }

  .custom-cart-item-bottom {
    margin-top: 2px;
  }

  .custom-cart-remove {
    background: none;
    border: 0;
    cursor: pointer;
    color: #5f6670;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .custom-cart-remove svg {
    width: 18px;
    height: 18px;
  }

  .custom-cart-qty {
    display: inline-flex;
    align-items: center;
    border: 1px solid #5a79a7;
    border-radius: 999px;
    overflow: hidden;
    height: 32px;
    min-width: 100px;
    justify-content: space-between;
    padding: 0 4px;
  }

  .custom-cart-qty button {
    width: 28px;
    height: 30px;
    border: 0;
    background: transparent;
    cursor: pointer;
    font-size: 22px;
    line-height: 1;
    color: #355b88;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .custom-cart-qty span {
    min-width: 24px;
    text-align: center;
    font-size: 16px;
    color: #355b88;
    font-family: 'Lato', sans-serif;
  }

  .custom-cart-footer {
    padding: 18px 30px 16px;
    margin-top: auto;
  }

  .custom-cart-subtotal-row {
    display: flex;
    justify-content: space-between;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    margin-bottom: 16px;
  }

  .custom-cart-subtotal-row strong {
    color: #1F1F1F;
    font-family: Raleway;
    font-size: 20px;
    font-style: normal;
    font-weight: 800;
    line-height: 27px; 
  }

  .custom-cart-subtotal-row p {
    color:  #1F1F1F;
    font-family: Lato;
    font-size: 12px;
    font-style: normal;
    font-weight: 400;
    line-height: 14px; 
  }
  .custom-cart-subtotal-row-inner {
    display: flex;
    justify-content: space-between;
    width: 100%;
  }
  .custom-cart-checkout {
    display: block;
    text-align: center;
    background: #e98c17;
    color: #fff;
    text-decoration: none;
    font-weight: 700;
    padding: 14px 20px;
    border-radius: 999px;
    font-family: 'Lato', sans-serif;
    margin-bottom: 10px;
  }

  .custom-cart-delivery {
    text-align: center;
    color: #1F1F1F;
    font-family: Lato;
    font-size: 12px;
    font-style: normal;
    font-weight: 400;
    line-height: 14px; 
    margin-bottom: 12px;
  }

  .custom-cart-delivery span {
    color: #DA0004;
  }

  .custom-cart-payments {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
  }

  .custom-topbar-container > .custom-header-topbar:not(.mobile) {
    display: flex;
  }

  .custom-topbar-container > marquee.custom-header-topbar.mobile,
  .custom-topbar-container > .custom-header-topbar.mobile.js-marquee {
    display: none;
  }

  @keyframes mobileTopbarLoop {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-1 * var(--loop-width, 0px)));
    }
  }

  {% comment %} .custom-cart-payment-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 34px;
    height: 22px;
    padding: 0 6px;
    border: 1px solid #dadada;
    border-radius: 3px;
    background: #fff;
    font-size: 10px;
    line-height: 1;
    color: #222;
    font-family: Arial, sans-serif;
  } {% endcomment %}

  @media (max-width: 767px) {
    .topbar-promos span {
      font-size: 12px !important;
    }

    .custom-topbar-container > .custom-header-topbar:not(.mobile) {
      display: none;
    }

    .custom-topbar-container > marquee.custom-header-topbar.mobile {
      display: block;
      width: 100%;
      padding: 8px 16px;
      border: 0;
    }

    .custom-topbar-container > marquee.custom-header-topbar.mobile .marquee-container {
      display: inline-flex;
      align-items: center;
      gap: 20px;
      white-space: nowrap;
    }

