{% comment %}{% endcomment %}
{%- assign header_menu = section.settings.menu -%}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Lato:wght@100;300;400;700;900&display=swap');


  .header-search {
  width: 100%;
}

.header-search form {
  display: flex;
  align-items: center;
  width: 100%;
  max-width: 100%;
  height: 42px;
  padding: 0 16px 0 20px;
  background: #f7f7f7;
  border: 1px solid #cfcfcf;
  border-radius: 999px;
  box-sizing: border-box;
}

.header-search input[type="text"] {
  flex: 1;
  border: 0;
  outline: 0;
  background: transparent;
  font-family: 'Lato', sans-serif;
  font-size: 16px;
  font-weight: 400;
  color: #444;
  padding: 0;
  margin: 0;
  box-shadow: none;
}

.header-search input[type="text"]::placeholder {
  color: #777;
  opacity: 1;
}

.header-search input[type="text"]:focus {
  outline: none;
  box-shadow: none;
}

.header-search button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  padding: 0;
  margin: 0;
  background: transparent;
  border: 0;
  cursor: pointer;
  flex-shrink: 0;
}

.header-search button svg {
  width: 20px;
  height: 20px;
  display: block;
}

.header-search button svg circle,
.header-search button svg line {
  stroke: #333;
  stroke-width: 2;
}

  .topbar-promos span, .topbar-right span {
    font-family: 'Lato', sans-serif;
}
  .custom-header-wrapper {
    font-family: Arial, Helvetica, sans-serif;
    width: 100%;
    position: sticky;
    top: 0;
    z-index: 1000;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
  }
  .custom-topbar-container {
    background: #e05a00;
    display: flex;
    justify-content: center;
}
  .custom-header-topbar {
    width: 1440px;
    color: #fff;
    font-size: 13px;
    padding: 7px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .topbar-promos {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .topbar-promos span {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .topbar-promos .dot {
    width: 5px;
    height: 5px;
    background: #fff;
    border-radius: 50%;
    display: inline-block;
  }

  .topbar-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .topbar-right a {
    color: #fff;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 13px;
  }

  .topbar-right svg {
    width: 18px;
    height: 18px;
    fill: #fff;
  }

  .topbar-flag {
    display: flex;
    align-items: center;
    gap: 4px;
    cursor: pointer;
    font-size: 13px;
    color: #fff;
  }
  .custom-header-container {
    display: flex;
    justify-content: center;
    background: #0F2E530F;
}
  .custom-header-main {
    display: flex;
    align-items: center;
    padding: 10px 20px;
        gap: 50px;
    border-bottom: 1px solid #e5e5e5;
    width: 1440px;
  }

  .header-logo a {
    display: block;
    text-decoration: none;
  }

  .header-logo img {
    max-height: 55px;
    width: auto;
    display: block;
  }

  .header-logo .logo-text {
    font-size: 22px;
    font-weight: 700;
    color: #e05a00;
    text-decoration: none;
    white-space: nowrap;
  }

  .header-search {
    flex: 1;
    display: flex;
    align-items: center;
    border-radius: 4px;
    overflow: hidden;
  }

  .header-search input {
    flex: 1;
    border: none;
    outline: none;
    padding: 9px 14px;
    font-size: 14px;
    background: transparent;
    color: #333;
  }

  .header-search input::placeholder {
    color: #999;
  }

  .header-search button {
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
  }

  .header-search button svg {
    width: 20px;
    height: 20px;
    fill: #555;
  }

  .header-icons {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-left: auto;
  }

  .header-icons a {
    display: flex;
    align-items: center;
    color: #333;
    text-decoration: none;
    position: relative;
  }

  .header-icons svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: #333;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .cart-count {
    position: absolute;
    top: -6px;
    right: -8px;
    background: #e05a00;
    color: #fff;
    font-size: 10px;
    border-radius: 50%;
    width: 16px;
    height: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
  }

  .custom-header-nav {
    background: #fff;
    border-top: 1px solid #e5e5e5;
    border-bottom: 2px solid #e5e5e5;
        display: flex;
    justify-content: center;
  }

  .header-nav-inner {
    display: flex;
    align-items: center;
    padding: 0 20px;
    overflow-x: auto;
    scrollbar-width: none;
    width: 1440px;
    justify-content: center;
}

  .header-nav-inner::-webkit-scrollbar {
    display: none;
  }

  .header-nav-inner > li {
    list-style: none;
    position: relative;
  }

  .header-nav-inner > li > a {
    display: block;
    padding: 13px 14px;
    font-size: 12.5px;
    font-weight: 500;
    color: #222;
    text-decoration: none;
    white-space: nowrap;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    transition: color 0.15s;
    font-family: 'Lato', sans-serif;
  }

  .header-nav-inner > li > a:hover {
    color: #e05a00;
  }

  .header-nav-inner > li.has-dropdown:hover > .nav-dropdown {
    display: block;
  }

  .nav-dropdown {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 200px;
    background: #fff;
    border: 1px solid #e5e5e5;
    box-shadow: 0 4px 16px rgba(0,0,0,0.1);
    z-index: 999;
    padding: 8px 0;
  }

  .nav-dropdown a {
    display: block;
    padding: 9px 18px;
    font-size: 13px;
    color: #333;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.1s, color 0.1s;
  }

  .nav-dropdown a:hover {
    background: #f5f5f5;
    color: #e05a00;
  }

  .mobile-menu-btn {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
    margin-left: 8px;
  }

  .mobile-menu-btn svg {
    width: 26px;
    height: 26px;
    stroke: #333;
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .mobile-nav-drawer {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 80%;
    max-width: 320px;
    height: 100%;
    background: #fff;
    z-index: 9999;
    overflow-y: auto;
    box-shadow: 4px 0 20px rgba(0,0,0,0.15);
    transform: translateX(-100%);
    transition: transform 0.3s ease;
  }

  .mobile-nav-drawer.open {
    transform: translateX(0);
  }

  .mobile-nav-overlay {
    display: none;
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background: rgba(0,0,0,0.4);
    z-index: 9998;
  }

  .mobile-nav-overlay.open {
    display: block;
  }

  .mobile-drawer-header {
    background: #e05a00;
    padding: 14px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #fff;
    font-weight: 700;
    font-size: 15px;
  }

  .mobile-drawer-close {
    background: none;
    border: none;
    cursor: pointer;
    color: #fff;
    font-size: 22px;
    line-height: 1;
  }

  .mobile-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .mobile-nav-list li a {
    display: block;
    padding: 13px 20px;
    font-size: 13.5px;
    font-weight: 700;
    color: #222;
    text-decoration: none;
    text-transform: uppercase;
    border-bottom: 1px solid #f0f0f0;
    letter-spacing: 0.03em;
  }

  .mobile-nav-list li a:hover {
    background: #fff5ee;
    color: #e05a00;
  }

  .mobile-nav-list .mobile-sub-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    padding: 13px 20px;
    font-size: 13.5px;
    font-weight: 700;
    color: #222;
    text-transform: uppercase;
    border-bottom: 1px solid #f0f0f0;
    letter-spacing: 0.03em;
  }

  .mobile-nav-list .mobile-sub-toggle:hover {
    background: #fff5ee;
    color: #e05a00;
  }

  .mobile-sub-toggle .arrow {
    font-size: 12px;
    transition: transform 0.2s;
  }

  .mobile-sub-toggle.active .arrow {
    transform: rotate(180deg);
  }

  .mobile-submenu {
    display: none;
    background: #f9f9f9;
  }

  .mobile-submenu.open {
    display: block;
  }

  .mobile-submenu a {
    padding-left: 36px !important;
    font-weight: 400 !important;
    text-transform: none !important;
    font-size: 13px !important;
  }

  @media (max-width: 900px) {
    .custom-header-nav {
      display: none;
    }
    .mobile-menu-btn {
      display: flex;
    }
    .mobile-nav-drawer {
      display: block;
    }
    .topbar-promos {
      font-size: 11px;
    }
  }

  @media (max-width: 600px) {
    .custom-header-main {
      padding: 8px 12px;
      gap: 10px;
    }
    .topbar-right span:not(.topbar-flag) {
      display: none;
    }
    .header-search {
      max-width: unset;
    }
    .header-logo img {
      max-height: 42px;
    }
  }
</style>

<div class="custom-header-wrapper">
  <div class="custom-topbar-container">
    <div class="custom-header-topbar">
    <div class="topbar-promos">
      <span>No Limit on Colors or Background Designs</span>
      <span class="dot"></span>
      <span>No Minimum Orders Required</span>
    </div>
   
    <div class="topbar-right">
      <a href="tel:{{ section.settings.phone_number }}">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/>
        </svg>
        <span>{{ section.settings.phone_number }}</span>
      </a>
      <span class="topbar-flag">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="14" viewBox="0 0 22 14"><rect width="22" height="14" fill="#B22234"/><rect y="1.08" width="22" height="1.08" fill="#fff"/><rect y="3.23" width="22" height="1.08" fill="#fff"/><rect y="5.38" width="22" height="1.08" fill="#fff"/><rect y="7.54" width="22" height="1.08" fill="#fff"/><rect y="9.69" width="22" height="1.08" fill="#fff"/><rect y="11.85" width="22" height="1.08" fill="#fff"/><rect width="8.8" height="7.54" fill="#3C3B6E"/></svg>
        ▾
      </span>
    </div>
     </div>
  </div>

  <div class="custom-header-container">
  <div class="custom-header-main">
    <div class="header-logo">
      <a href="{{ routes.root_url }}">
        {%- if section.settings.logo != blank -%}
         <img src="{{ section.settings.logo | img_url: 'master' }}" alt="{{ shop.name }}" loading="eager">
        {%- else -%}
          <span class="logo-text">{{ shop.name }}</span>
        {%- endif -%}
      </a>
    </div>

    <div class="header-search">
      <form action="{{ routes.search_url }}" method="get" role="search">
        <input type="text" name="q" placeholder="{{ section.settings.search_placeholder | default: 'Search Covers' }}" aria-label="Search">
        <button type="submit" aria-label="Submit search">
          <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="17" height="17" viewBox="0 0 17 17">
  <image xlink:href="data:image/png;base64," x="0" y="0" width="17" height="17"/>
</svg>
        </button>
      </form>
    </div>

    <div class="header-icons">
      <a href="{{ routes.account_url }}" aria-label="Account">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
      </a>
      <a href="#" aria-label="Wishlist">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
      </a>
      <a href="{{ routes.cart_url }}" aria-label="Cart">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <circle cx="9" cy="21" r="1"/>
          <circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
        </svg>
        {%- if cart.item_count > 0 -%}
          <span class="cart-count">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
    </div>

    <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Open menu">
      <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>
  </div>
</div>
  <nav class="custom-header-nav" aria-label="Main navigation">
    <ul class="header-nav-inner">
      {%- for link in linklists[header_menu].links -%}
        <li class="{% if link.links != blank %}has-dropdown{% endif %}">
          <a href="{{ link.url }}">{{ link.title }}</a>
          {%- if link.links != blank -%}
            <ul class="nav-dropdown">
              {%- for child_link in link.links -%}
                <li><a href="{{ child_link.url }}">{{ child_link.title }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </nav>
</div>

<div class="mobile-nav-overlay" id="mobileNavOverlay"></div>
<div class="mobile-nav-drawer" id="mobileNavDrawer">
  <div class="mobile-drawer-header">
    <span>Menu</span>
    <button class="mobile-drawer-close" id="mobileDrawerClose" aria-label="Close menu">&#x2715;</button>
  </div>
  <ul class="mobile-nav-list">
    {%- for link in linklists[header_menu].links -%}
      {%- if link.links != blank -%}
        <li>
          <div class="mobile-sub-toggle" data-target="mobile-sub-{{ forloop.index }}">
            {{ link.title }} <span class="arrow">&#9660;</span>
          </div>
          <ul class="mobile-submenu" id="mobile-sub-{{ forloop.index }}">
            {%- for child_link in link.links -%}
              <li><a href="{{ child_link.url }}">{{ child_link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </li>
      {%- else -%}
        <li><a href="{{ link.url }}">{{ link.title }}</a></li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</div>

<script>
  (function() {
    var btn = document.getElementById('mobileMenuBtn');
    var drawer = document.getElementById('mobileNavDrawer');
    var overlay = document.getElementById('mobileNavOverlay');
    var closeBtn = document.getElementById('mobileDrawerClose');

    function openDrawer() {
      drawer.classList.add('open');
      overlay.classList.add('open');
      document.body.style.overflow = 'hidden';
    }
    function closeDrawer() {
      drawer.classList.remove('open');
      overlay.classList.remove('open');
      document.body.style.overflow = '';
    }

    btn && btn.addEventListener('click', openDrawer);
    closeBtn && closeBtn.addEventListener('click', closeDrawer);
    overlay && overlay.addEventListener('click', closeDrawer);

    document.querySelectorAll('.mobile-sub-toggle').forEach(function(toggle) {
      toggle.addEventListener('click', function() {
        var targetId = this.getAttribute('data-target');
        var sub = document.getElementById(targetId);
        var isOpen = sub.classList.contains('open');
        document.querySelectorAll('.mobile-submenu.open').forEach(function(el) { el.classList.remove('open'); });
        document.querySelectorAll('.mobile-sub-toggle.active').forEach(function(el) { el.classList.remove('active'); });
        if (!isOpen) {
          sub.classList.add('open');
          this.classList.add('active');
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Custom Header",
  "tag": "header",
  "class": "section-custom-header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu",
      "default": "main-menu"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "Phone Number",
      "default": "410-561-0800"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search Placeholder Text",
      "default": "Search Covers"
    }
  ],
  "presets": [
    {
      "name": "Custom Header"
    }
  ]
}
{% endschema %}