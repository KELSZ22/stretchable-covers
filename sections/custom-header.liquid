    function addBusinessDays(startDate, businessDays) {
      var date = new Date(startDate);
      var added = 0;

      while (added < businessDays) {
        date.setDate(date.getDate() + 1);
        var day = date.getDay();
        if (day !== 0 && day !== 6) {
          added++;
        }
      }

      return date;
    }

    function formatDeliveryDate(date) {
      return date.toLocaleDateString('en-US', {
        weekday: 'long',
        month: 'short',
        day: 'numeric'
      });
    }

    function getCutoffCountdown(cutoffHour) {
      var now = new Date();
      var cutoff = new Date();
      cutoff.setHours(cutoffHour, 0, 0, 0);

      if (now > cutoff) {
        cutoff.setDate(cutoff.getDate() + 1);
      }

      var diff = cutoff - now;
      var hours = Math.floor(diff / (1000 * 60 * 60));
      var minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));

      return hours + ' hrs. ' + minutes + ' mins.';
    }

    function getDeliveryEstimateHtml() {
      var estimatedDate = addBusinessDays(new Date(), 15);
      var formattedDate = formatDeliveryDate(estimatedDate);
      var countdown = getCutoffCountdown(15);

      return `
        <div class="custom-cart-delivery">
          Estimated Delivery by <strong>${formattedDate}</strong>
          <span>Order within ${countdown}</span>
        </div>
      `;
    }

    function renderEmptyCart(cart) {
      countEl.textContent = '(' + cart.item_count + ')';
      footerEl.style.display = 'none';
      bodyEl.classList.add('is-empty');

      bodyEl.innerHTML = `
        <div class="custom-cart-empty-wrap">
          <div class="custom-cart-empty">
            <h3>Your cart is currently empty.</h3>
            <p>Add your custom covers to your cart!</p>
            <a href="/collections/all" class="shop-now-btn">Shop Now</a>
          </div>

          <div class="custom-cart-recommendations">
            <h4>Shop Best Sellers</h4>
            ${bestSellersHtml()}
          </div>
        </div>
      `;
    }

function renderCartItems(cart) {
  bodyEl.classList.remove('is-empty');
  countEl.textContent = '(' + cart.item_count + ')';
  footerEl.style.display = 'block';
  subtotalEl.textContent = money(cart.total_price);
  itemLabelEl.textContent = cart.item_count + (cart.item_count === 1 ? ' Item' : ' Items');

  bodyEl.innerHTML = cart.items.map(function(item, index) {
    var variantText = getVariantDiameterText(item);
    var image = getItemImage(item);
    var quantity = Number(item.quantity || 0);
    var unitPrice = item.final_price != null ? item.final_price : item.price;
    var diameterHtml = getDiameterHtml(item);

    return `
      <div class="custom-cart-item">
        <div class="custom-cart-item-image">
          ${image ? `<img src="${image}" alt="${escapeHtml(item.product_title)}">` : ''}
        </div>

        <div class="custom-cart-item-details">
          <div class="custom-cart-item-top">
            <div>
              <div class="custom-cart-item-title">${escapeHtml(item.product_title)}</div>
              ${diameterHtml}
              ${variantText ? `<div class="custom-cart-item-variant">${escapeHtml(variantText)}</div>` : ''}
              <div class="custom-cart-item-price">${money(unitPrice)}</div>
            </div>

            <button type="button" class="custom-cart-remove" data-line="${index + 1}" data-remove="true" aria-label="Remove item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" xmlns="http://www.w3.org/2000/svg">
                <path d="M3 6h18"></path>
                <path d="M8 6V4h8v2"></path>
                <path d="M19 6l-1 14H6L5 6"></path>
                <path d="M10 11v6"></path>
                <path d="M14 11v6"></path>
              </svg>
            </button>
          </div>

          <div class="custom-cart-item-bottom">
            <div class="custom-cart-qty">
              <button type="button" data-line="${index + 1}" data-qty="${quantity - 1}">−</button>
              <span>${quantity}</span>
              <button type="button" data-line="${index + 1}" data-qty="${quantity + 1}">+</button>
            </div>
          </div>
        </div>
      </div>
    `;
  }).join('');

  footerEl.innerHTML = `
    <div class="custom-cart-subtotal-row">
      <div class="custom-cart-subtotal-row-inner">
        <strong>Subtotal (<span id="customCartItemLabel">${cart.item_count + (cart.item_count === 1 ? ' Item' : ' Items')}</span>)</strong>
        <strong id="customCartSubtotal">${money(cart.total_price)}</strong>
      </div>
        <p>Discounts and promo codes will be calculated at checkout</p>
    </div>

    <a href="/checkout" class="custom-cart-checkout">Secure Check Out</a>

    <div class="custom-cart-delivery">
      Estimated Delivery by <strong>Friday, Feb 13.</strong>
      <span>Order within 20 hrs. 30 mins.</span>
    </div>

    ${paymentIconsHtml()}
  `;
}

    function updateHeaderBubble(count) {
      var bubble = document.querySelector('.cart-count');

      if (!bubble && count > 0) {
        bubble = document.createElement('span');
        bubble.className = 'cart-count';
        bubble.textContent = count;
        var cartLink = document.getElementById('customCartTrigger');
        if (cartLink) cartLink.appendChild(bubble);
      } else if (bubble) {
        bubble.textContent = count;
        bubble.style.display = count > 0 ? 'flex' : 'none';
      }
    }

    function loadCart() {
      fetch('/cart.js')
        .then(function(res) { return res.json(); })
        .then(function(cart) {
          if (cart.item_count === 0) {
            renderEmptyCart(cart);
          } else {
            renderCartItems(cart);
          }
          updateHeaderBubble(cart.item_count);
        })
        .catch(function(error) {
          console.error('Cart load error:', error);
          bodyEl.innerHTML = '<div style="padding:20px;">There was an error loading your cart.</div>';
        });
    }

    function updateCart(line, quantity) {
      fetch('/cart/change.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          line: line,
          quantity: quantity
        })
      })
      .then(function(res) { return res.json(); })
      .then(function(cart) {
        if (cart.item_count === 0) {
          renderEmptyCart(cart);
        } else {
          renderCartItems(cart);
        }
        updateHeaderBubble(cart.item_count);
      })
      .catch(function(error) {
        console.error('Cart update error:', error);
      });
    }

    function openDrawer() {
      drawer.classList.add('open');
      overlay.classList.add('open');
      drawer.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      loadCart();
    }

    function closeDrawer() {
      drawer.classList.remove('open');
      overlay.classList.remove('open');
      drawer.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    trigger && trigger.addEventListener('click', function(e) {
      e.preventDefault();
      openDrawer();
    });

    closeBtn && closeBtn.addEventListener('click', closeDrawer);
    overlay && overlay.addEventListener('click', closeDrawer);

    document.addEventListener('click', function(e) {
      var qtyBtn = e.target.closest('.custom-cart-qty button');
      var removeBtn = e.target.closest('.custom-cart-remove');

      if (qtyBtn) {
        var line = parseInt(qtyBtn.getAttribute('data-line'), 10);
        var qty = parseInt(qtyBtn.getAttribute('data-qty'), 10);
        if (qty < 0) qty = 0;
        updateCart(line, qty);
      }

      if (removeBtn) {
        var removeLine = parseInt(removeBtn.getAttribute('data-line'), 10);
        updateCart(removeLine, 0);
      }
    });

    document.addEventListener('cart:refresh', loadCart);
  })();
</script>

