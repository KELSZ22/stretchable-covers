            'café table cover',
            'cafe table',
            'café table',
            'table cover'
          ]
        },
        {
          filterLabel: 'Equipment Covers',
          keywords: [
            'equipment cover',
            'equipment',
            'industrial equipment',
            'industrial equipment cover'
          ]
        },
        {
          filterLabel: 'XXXL JumboPLUS Covers',
          keywords: [
            'xxxl jumbo plus',
            'xxxl jumboplus',
            'jumbo plus',
            'jumboplus',
            'xxxl cover'
          ]
        }
      ];

      function hasFilterParams() {
        var params = new URLSearchParams(window.location.search);
        var found = false;

        params.forEach(function (value, key) {
          if (key.indexOf('filter.') === 0) {
            found = true;
          }
        });

        return found;
      }

      function getMatchedFilterLabel() {
        for (var i = 0; i < searchCategoryMap.length; i++) {
          var item = searchCategoryMap[i];

          for (var k = 0; k < item.keywords.length; k++) {
            var keyword = normalize(item.keywords[k]);

            if (normalizedSearch.indexOf(keyword) !== -1) {
              return item.filterLabel;
            }
          }
        }

        return '';
      }

      function getInputLabel(input) {
        var labelText = '';

        var closestLabel = input.closest('label');

        if (closestLabel) {
          labelText = closestLabel.textContent || '';
        }

        if (!labelText && input.id && window.CSS && CSS.escape) {
          var label = document.querySelector('label[for="' + CSS.escape(input.id) + '"]');

          if (label) {
            labelText = label.textContent || '';
          }
        }

        return labelText;
      }

      function findFilterInputByLabel(filterLabel) {
        var wantedLabel = normalize(filterLabel);
        var form = document.querySelector('[data-custom-search-filter-form]');

        if (!form) return null;

        var inputs = Array.prototype.slice.call(
          form.querySelectorAll('input[type="checkbox"][name^="filter."]')
        );

        for (var i = 0; i < inputs.length; i++) {
          var input = inputs[i];

          if (input.disabled) continue;

          var inputLabel = normalize(getInputLabel(input));
          var inputValue = normalize(input.value);

          if (inputLabel === wantedLabel || inputValue === wantedLabel) {
            return input;
          }
        }

        return null;
      }

      function buildAutoFilterUrl(input) {
        var url = new URL(window.location.href);

        url.searchParams.delete('page');

        if (!url.searchParams.get('q')) {
          url.searchParams.set('q', searchTerm);
        }

        if (!url.searchParams.get('type')) {
          url.searchParams.set('type', 'product');
        }

        if (!url.searchParams.get('options[prefix]')) {
          url.searchParams.set('options[prefix]', 'last');
        }

        url.searchParams.append(input.name, input.value);

        return url.toString();
      }

      function runAutoCategoryFilter() {
        if (activeFilterCount > 0) return;
        if (hasFilterParams()) return;

        var matchedFilterLabel = getMatchedFilterLabel();

        if (!matchedFilterLabel) return;

        var matchingInput = findFilterInputByLabel(matchedFilterLabel);

        if (!matchingInput) return;
        if (matchingInput.checked) return;

        window.location.replace(buildAutoFilterUrl(matchingInput));
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', runAutoCategoryFilter);
      } else {
        runAutoCategoryFilter();
      }
    })();
  </script>
{% endif %}

<script>
  (function () {
    function initProductCardCarousels(root) {
      const scope = root || document;

      scope.querySelectorAll('[data-search-product-card]').forEach(function (card) {
        if (card.dataset.carouselInitialized === 'true') return;
        card.dataset.carouselInitialized = 'true';

        const slides = Array.prototype.slice.call(card.querySelectorAll('[data-search-product-slide]'));
        const prevButton = card.querySelector('[data-search-card-prev]');
        const nextButton = card.querySelector('[data-search-card-next]');
        const imageLink = card.querySelector('[data-search-product-image-link]');

        if (slides.length <= 1) return;

        let currentIndex = slides.findIndex(function (slide) {
          return slide.classList.contains('is-active');
        });

        if (currentIndex < 0) {
          currentIndex = 0;
        }

        let startX = 0;
        let startY = 0;
        let suppressClick = false;

        function updateSlide(nextIndex) {
          if (nextIndex < 0) {
            nextIndex = slides.length - 1;
          }

          if (nextIndex >= slides.length) {
            nextIndex = 0;
          }

          slides.forEach(function (slide, index) {
            slide.classList.toggle('is-active', index === nextIndex);
          });

          currentIndex = nextIndex;
        }

        function showPrevious() {
          updateSlide(currentIndex - 1);
        }

        function showNext() {
          updateSlide(currentIndex + 1);
        }

        if (prevButton) {
          prevButton.addEventListener('click', function (event) {
            event.preventDefault();
            event.stopPropagation();
            showPrevious();
          });
        }

        if (nextButton) {
          nextButton.addEventListener('click', function (event) {
            event.preventDefault();
            event.stopPropagation();
            showNext();
          });
        }

        if (imageLink) {
          imageLink.addEventListener('pointerdown', function (event) {
            startX = event.clientX;
            startY = event.clientY;
          });

          imageLink.addEventListener('pointerup', function (event) {
            const endX = event.clientX;
            const endY = event.clientY;
            const diffX = endX - startX;
            const diffY = endY - startY;

            if (Math.abs(diffX) > 40 && Math.abs(diffX) > Math.abs(diffY)) {
              suppressClick = true;

              if (diffX < 0) {
                showNext();
              } else {
                showPrevious();
              }

              window.setTimeout(function () {
                suppressClick = false;
              }, 250);
            }
          });

          imageLink.addEventListener('click', function (event) {
            if (suppressClick) {
              event.preventDefault();
              event.stopPropagation();
            }
          });
        }
      });
    }

    function initCustomSearchFilters() {
      const section = document.querySelector('[data-custom-search-section]');
      const filterForm = section ? section.querySelector('[data-custom-search-filter-form]') : null;

      if (!section) return;

      initProductCardCarousels(section);

      const sortForm = section.querySelector('[data-custom-search-sort-form]');
      const sortSelect = section.querySelector('[data-custom-search-sort-select]');
      const filterSortHidden = section.querySelector('[data-custom-search-filter-sort-hidden]');
      const drawerSortSelect = section.querySelector('[data-custom-search-drawer-sort-select]');
      const openFilterButton = section.querySelector('[data-mobile-filter-open]');
      const closeFilterButton = section.querySelector('[data-mobile-filter-close]');
      const applyFilterButton = section.querySelector('[data-mobile-filter-apply]');
      const filterOverlay = section.querySelector('[data-mobile-filter-overlay]');

      function openMobileFilter() {
        section.classList.add('is-filter-drawer-open');
        document.body.classList.add('custom-search-filter-lock');
      }

      function closeMobileFilter() {
        section.classList.remove('is-filter-drawer-open');
        document.body.classList.remove('custom-search-filter-lock');
      }

      function syncSortControls(value, source) {
        if (filterSortHidden) {
          filterSortHidden.value = value || '';
        }

        if (sortSelect && source !== 'toolbar') {
          sortSelect.value = value || '';
        }

        if (drawerSortSelect && source !== 'drawer') {
          drawerSortSelect.value = value || '';
        }
      }

      const initialSortValue =
        (filterSortHidden && filterSortHidden.value) ||
        (sortSelect && sortSelect.value) ||
        (drawerSortSelect && drawerSortSelect.value) ||
        '';

      syncSortControls(initialSortValue);

      if (openFilterButton && openFilterButton.dataset.drawerInitialized !== 'true') {
        openFilterButton.dataset.drawerInitialized = 'true';

        openFilterButton.addEventListener('click', function (event) {
          event.preventDefault();
          openMobileFilter();
        });
      }

      if (closeFilterButton && closeFilterButton.dataset.drawerInitialized !== 'true') {
        closeFilterButton.dataset.drawerInitialized = 'true';

        closeFilterButton.addEventListener('click', function (event) {
          event.preventDefault();
          closeMobileFilter();
        });
      }

      if (applyFilterButton && applyFilterButton.dataset.drawerInitialized !== 'true') {
        applyFilterButton.dataset.drawerInitialized = 'true';

        applyFilterButton.addEventListener('click', function (event) {
          event.preventDefault();
          closeMobileFilter();
        });
      }

      if (filterOverlay && filterOverlay.dataset.drawerInitialized !== 'true') {
        filterOverlay.dataset.drawerInitialized = 'true';

        filterOverlay.addEventListener('click', function () {
          closeMobileFilter();
        });
      }

      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') {
          closeMobileFilter();
        }
      });

      if (!filterForm) return;

      if (filterForm.dataset.ajaxInitialized === 'true') return;
      filterForm.dataset.ajaxInitialized = 'true';

      let priceTimer = null;
      let activeController = null;

      function buildUrlFromForm() {
        const formData = new FormData(filterForm);
        const params = new URLSearchParams();

        formData.forEach(function (value, key) {
          if (String(value).trim() !== '') {
            params.append(key, value);
          }
        });

        const baseUrl = filterForm.getAttribute('action') || window.location.pathname;
        const queryString = params.toString();

        return queryString ? baseUrl + '?' + queryString : baseUrl;
      }

      function buildUrlFromSortForm() {
        const currentUrl = new URL(window.location.href);
        const formData = sortForm ? new FormData(sortForm) : null;

        if (!formData) return window.location.href;

        formData.forEach(function (value, key) {
          if (String(value).trim() !== '') {
            currentUrl.searchParams.set(key, value);
          } else {
            currentUrl.searchParams.delete(key);
          }
        });

        return currentUrl.pathname + '?' + currentUrl.searchParams.toString();
      }

      function replaceSearchSectionFromHtml(html) {
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');
        const newSection = doc.querySelector('[data-custom-search-section]');

        if (!newSection) {
          window.location.reload();
          return;
        }

        section.innerHTML = newSection.innerHTML;
        section.classList.remove('is-loading');
        section.classList.remove('is-filter-drawer-open');
        document.body.classList.remove('custom-search-filter-lock');

        initCustomSearchFilters();
      }

      function loadSearchUrl(url, pushState) {
        if (activeController) {
          activeController.abort();
        }

        activeController = new AbortController();

        section.classList.add('is-loading');

        fetch(url, {
          signal: activeController.signal,
          headers: {
            'X-Requested-With': 'XMLHttpRequest'
          }
        })
          .then(function (response) {
            if (!response.ok) {
              throw new Error('Search filter request failed');
            }

            return response.text();
          })
          .then(function (html) {
            replaceSearchSectionFromHtml(html);

            if (pushState) {
              window.history.pushState({}, '', url);
            }
          })
          .catch(function (error) {
            if (error.name === 'AbortError') return;

            console.error(error);
            window.location.href = url;
          });
      }

      function submitFiltersAjax() {
        const url = buildUrlFromForm();
        loadSearchUrl(url, true);
      }

      filterForm.querySelectorAll('input[type="checkbox"]').forEach(function (checkbox) {
        checkbox.addEventListener('change', function () {
          submitFiltersAjax();
        });
      });

      filterForm.querySelectorAll('.custom-search-results__price-field input').forEach(function (input) {
        input.addEventListener('input', function () {
          clearTimeout(priceTimer);

          priceTimer = setTimeout(function () {
            submitFiltersAjax();
          }, 900);
        });
      });

      filterForm.addEventListener('submit', function (event) {
        event.preventDefault();
        submitFiltersAjax();
      });

      if (sortSelect && sortSelect.dataset.sortInitialized !== 'true') {
        sortSelect.dataset.sortInitialized = 'true';

        sortSelect.addEventListener('change', function () {
          syncSortControls(this.value, 'toolbar');
          const url = buildUrlFromSortForm();
          loadSearchUrl(url, true);
        });
      }

      if (drawerSortSelect && drawerSortSelect.dataset.sortInitialized !== 'true') {
        drawerSortSelect.dataset.sortInitialized = 'true';

        drawerSortSelect.addEventListener('change', function () {
          syncSortControls(this.value, 'drawer');
          submitFiltersAjax();
        });
      }

      if (sortForm && sortForm.dataset.sortInitialized !== 'true') {
        sortForm.dataset.sortInitialized = 'true';

        sortForm.addEventListener('submit', function (event) {
          event.preventDefault();
          const selectedValue = sortSelect ? sortSelect.value : '';
          syncSortControls(selectedValue, 'toolbar');

          const url = buildUrlFromSortForm();
          loadSearchUrl(url, true);
        });
      }

      section.querySelectorAll('[data-custom-search-link]').forEach(function (link) {
        link.addEventListener('click', function (event) {
          event.preventDefault();

          const url = link.getAttribute('href');

          if (!url) return;

          loadSearchUrl(url, true);
        });
      });
    }

    document.addEventListener('DOMContentLoaded', initCustomSearchFilters);

    window.addEventListener('popstate', function () {
      const currentUrl = window.location.href;
      const section = document.querySelector('[data-custom-search-section]');

      if (!section) return;

      section.classList.add('is-loading');

      fetch(currentUrl, {
        headers: {
          'X-Requested-With': 'XMLHttpRequest'
        }
      })
        .then(function (response) {
          return response.text();
        })
        .then(function (html) {
          const parser = new DOMParser();
          const doc = parser.parseFromString(html, 'text/html');
          const newSection = doc.querySelector('[data-custom-search-section]');

          if (newSection) {
            section.innerHTML = newSection.innerHTML;
            section.classList.remove('is-loading');
            section.classList.remove('is-filter-drawer-open');
            document.body.classList.remove('custom-search-filter-lock');
            initCustomSearchFilters();
          } else {
            window.location.reload();
          }
        });
    });
  })();
</script>

