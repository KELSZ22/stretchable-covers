{% liquid
  assign results_per_page = section.settings.products_per_page
  assign current_search_terms = search.terms | default: ''
  assign current_sort_by = search.sort_by | default: search.default_sort_by
  assign relevance_sort_value = search.default_sort_by | default: 'relevance'
  assign mobile_sort_value = current_sort_by
  assign has_active_filters = false
  assign active_filter_count = 0

  unless mobile_sort_value == relevance_sort_value or mobile_sort_value == 'price-ascending' or mobile_sort_value == 'price-descending'
    assign mobile_sort_value = relevance_sort_value
  endunless

  for filter in search.filters
    if filter.active_values.size > 0
      assign has_active_filters = true
      assign active_filter_count = active_filter_count | plus: filter.active_values.size
    endif

    if filter.type == 'price_range'
      if filter.min_value.value != blank or filter.max_value.value != blank
        assign has_active_filters = true
        assign active_filter_count = active_filter_count | plus: 1
      endif
    endif
  endfor
%}

<section class="custom-search-results-section" data-custom-search-section>
  <div class="custom-search-results__inner">
    {% if search.performed %}
      {% paginate search.results by results_per_page %}
        {% assign current_page_product_count = 0 %}
        {% for item in search.results %}
          {% if item.object_type == 'product' %}
            {% assign current_page_product_count = current_page_product_count | plus: 1 %}
          {% endif %}
        {% endfor %}

        <div class="custom-search-results__mobile-toolbar">
          <button
            type="button"
            class="custom-search-results__mobile-filter-button"
            aria-label="Open filters"
            data-mobile-filter-open
          >
            <span class="custom-search-results__mobile-filter-icon" aria-hidden="true">
              <svg width="26" height="26" viewBox="0 0 26 26" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M5 7H15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M5 13H21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M5 19H12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <circle cx="18.5" cy="7" r="2.5" fill="currentColor"/>
                <circle cx="13.5" cy="19" r="2.5" fill="currentColor"/>
              </svg>

              {% if active_filter_count > 0 %}
                <span class="custom-search-results__mobile-filter-badge">
                  {{ active_filter_count }}
                </span>
              {% endif %}
            </span>

            <span>Filter By:</span>
          </button>

          <form
            class="custom-search-results__mobile-sort-form"
            action="{{ routes.search_url }}"
            method="get"
            data-custom-search-sort-form
          >
            <input type="hidden" name="q" value="{{ current_search_terms | escape }}">
            <input type="hidden" name="type" value="product">
            <input type="hidden" name="options[prefix]" value="last">

            <label class="custom-search-results__mobile-sort-label" for="CustomSearchSortBy">
              Sort By:
            </label>

            <div class="custom-search-results__mobile-sort-select-wrap">
              <select
                id="CustomSearchSortBy"
                name="sort_by"
                class="custom-search-results__mobile-sort-select"
                data-custom-search-sort-select
              >
                <option
                  value="{{ relevance_sort_value }}"
                  {% if mobile_sort_value == relevance_sort_value %}selected{% endif %}
                >
                  Relevance
                </option>
                <option
                  value="price-ascending"
                  {% if mobile_sort_value == 'price-ascending' %}selected{% endif %}
                >
                  Price, low to high
                </option>
                <option
                  value="price-descending"
                  {% if mobile_sort_value == 'price-descending' %}selected{% endif %}
                >
                  Price, high to low
                </option>
              </select>

              <span class="custom-search-results__mobile-sort-arrow" aria-hidden="true">
                <svg width="10" height="6" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
          </form>
        </div>

        <div class="custom-search-results__mobile-filter-overlay" data-mobile-filter-overlay></div>

        <div class="custom-search-results__layout">
          <aside class="custom-search-results__filters" data-mobile-filter-drawer>
            <div class="custom-search-results__mobile-filter-header">
              <h2>Filter By:</h2>

              <button
                type="button"
                class="custom-search-results__mobile-filter-close"
                aria-label="Close filters"
                data-mobile-filter-close
              >
                ×
              </button>
            </div>

            <form
              class="custom-search-results__filter-form"
              id="CustomSearchFilterForm"
              action="{{ routes.search_url }}"
              method="get"
              data-custom-search-filter-form
            >
              <input type="hidden" name="q" value="{{ current_search_terms | escape }}">
              <input type="hidden" name="type" value="product">
              <input type="hidden" name="options[prefix]" value="last">
              <input
                type="hidden"
                name="sort_by"
                value="{{ mobile_sort_value | escape }}"
                data-custom-search-filter-sort-hidden
              >

              <div class="custom-search-results__filter-card">
                {% if has_active_filters %}
                  <div class="custom-search-results__active-filters">
                    {% for filter in search.filters %}
                      {% for filter_value in filter.active_values %}
                        <a
                          href="{{ filter_value.url_to_remove }}"
                          class="custom-search-results__active-filter"
                          data-custom-search-link
                        >
                          <span>{{ filter_value.label }}</span>
                          <span class="custom-search-results__active-filter-remove" aria-hidden="true">×</span>
                        </a>
                      {% endfor %}

                      {% if filter.type == 'price_range' %}
                        {% if filter.min_value.value != blank or filter.max_value.value != blank %}
                          <a
                            href="{{ filter.url_to_remove }}"
                            class="custom-search-results__active-filter"
                            data-custom-search-link
                          >
                            <span>
                              Price:
                              {% if filter.min_value.value != blank %}
                                {{ filter.min_value.value | money }}
                              {% else %}
                                {{ 0 | money }}
                              {% endif %}
                              —
                              {% if filter.max_value.value != blank %}
                                {{ filter.max_value.value | money }}
                              {% else %}
                                {{ filter.range_max | money }}
                              {% endif %}
                            </span>
                            <span class="custom-search-results__active-filter-remove" aria-hidden="true">×</span>
                          </a>
                        {% endif %}
                      {% endif %}
                    {% endfor %}

                    <a
                      href="{{ routes.search_url }}?q={{ current_search_terms | url_encode }}&type=product&options%5Bprefix%5D=last{% if mobile_sort_value != blank %}&sort_by={{ mobile_sort_value | url_encode }}{% endif %}"
                      class="custom-search-results__active-filter custom-search-results__active-filter--clear"
                      data-custom-search-link
                    >
                      <span>Clear all</span>
                    </a>
                  </div>
                {% endif %}

                <h2 class="custom-search-results__filter-title">Filters</h2>

                {% if search.filters != blank %}
                  {% for filter in search.filters %}
                    {% liquid
                      assign filter_active_count = filter.active_values.size

                      if filter.type == 'price_range'
                        if filter.min_value.value != blank or filter.max_value.value != blank
                          assign filter_active_count = 1
                        endif
                      endif
                    %}

                    <details class="custom-search-results__filter-group" open>
                      <summary class="custom-search-results__filter-summary">
                        <span class="custom-search-results__filter-summary-left">
                          <span>{{ filter.label }}</span>

                          {% if filter_active_count > 0 %}
                            <span class="custom-search-results__filter-count">
                              {{ filter_active_count }}
                            </span>
                          {% endif %}
                        </span>

                        <span class="custom-search-results__filter-arrow" aria-hidden="true">
                          <svg width="10" height="6" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </span>
                      </summary>

                      <div class="custom-search-results__filter-body">
                        {% case filter.type %}
                          {% when 'boolean', 'list' %}
                            <ul class="custom-search-results__filter-list">
                              {% for filter_value in filter.values %}
                                <li class="custom-search-results__filter-item">
                                  <label class="custom-search-results__checkbox-label">
                                    <input
                                      type="checkbox"
                                      name="{{ filter_value.param_name }}"
                                      value="{{ filter_value.value }}"
                                      {% if filter_value.active %}checked{% endif %}
                                      {% if filter_value.count == 0 and filter_value.active == false %}disabled{% endif %}
                                      class="custom-search-results__checkbox"
                                    >

                                    <span class="custom-search-results__fake-checkbox" aria-hidden="true">
                                      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" class="icon-checkmark">
                                        <path d="M4.75439 10.7485L7.68601 14.5888C7.79288 14.7288 7.84632 14.7988 7.91174 14.8242C7.96907 14.8466 8.03262 14.8469 8.09022 14.8253C8.15596 14.8007 8.21026 14.7314 8.31886 14.5927L15.2475 5.74658" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                                      </svg>
                                    </span>

                                    <span class="custom-search-results__filter-value">
                                      {{ filter_value.label }}
                                    </span>
                                  </label>
                                </li>
                              {% endfor %}
                            </ul>

                          {% when 'price_range' %}
                            <div class="custom-search-results__price-filter">
                              <div class="custom-search-results__price-slider-line">
                                <span></span>
                              </div>

                              <div class="custom-search-results__price-inputs">
                                <label class="custom-search-results__price-field">
                                  <span>$</span>
                                  <input
                                    name="{{ filter.min_value.param_name }}"
                                    type="number"
                                    inputmode="numeric"
                                    min="0"
                                    {% if filter.min_value.value %}
                                      value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
                                    {% endif %}
                                    placeholder="0"
                                  >
                                </label>

                                <span class="custom-search-results__price-to">to</span>

                                <label class="custom-search-results__price-field">
                                  <span>$</span>
                                  <input
                                    name="{{ filter.max_value.param_name }}"
                                    type="number"
                                    inputmode="numeric"
                                    min="0"
                                    {% if filter.max_value.value %}
                                      value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
                                    {% endif %}
                                    placeholder="{{ filter.range_max | money_without_currency }}"
                                  >
                                </label>
                              </div>

                              <p class="custom-search-results__highest-price">
                                The highest price is {{ filter.range_max | money }}
                              </p>
                            </div>
                        {% endcase %}
                      </div>
                    </details>
                  {% endfor %}
                {% else %}
                  <p class="custom-search-results__no-filters">
                    No filters available.
                  </p>
                {% endif %}

                <div class="custom-search-results__mobile-drawer-sort-row">
                  <label class="custom-search-results__mobile-drawer-sort-label" for="CustomSearchDrawerSortBy">
                    Sort By:
                  </label>

                  <div class="custom-search-results__mobile-drawer-sort-wrap">
                    <select
                      id="CustomSearchDrawerSortBy"
                      class="custom-search-results__mobile-drawer-sort-select"
                      data-custom-search-drawer-sort-select
                    >
                      <option
                        value="{{ relevance_sort_value }}"
                        {% if mobile_sort_value == relevance_sort_value %}selected{% endif %}
                      >
                        Relevance
                      </option>
                      <option
                        value="price-ascending"
                        {% if mobile_sort_value == 'price-ascending' %}selected{% endif %}
                      >
                        Price, low to high
                      </option>
                      <option
                        value="price-descending"
                        {% if mobile_sort_value == 'price-descending' %}selected{% endif %}
                      >
                        Price, high to low
                      </option>
                    </select>

                    <span class="custom-search-results__mobile-drawer-sort-arrow" aria-hidden="true">
                      <svg width="10" height="6" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                  </div>
                </div>
              </div>

              <div class="custom-search-results__mobile-drawer-actions">
                <button
                  type="button"
                  class="custom-search-results__mobile-drawer-button"
                  data-mobile-filter-apply
                >
                  See {{ current_page_product_count }} {% if current_page_product_count == 1 %}item{% else %}items{% endif %}
                </button>
              </div>
            </form>
          </aside>

          <div class="custom-search-results__products">
            {% assign product_count = 0 %}

            <div class="custom-search-results__grid">
              {% for item in search.results %}
                {% if item.object_type == 'product' %}
                  {% assign product = item %}
                  {% assign product_count = product_count | plus: 1 %}
                  {% assign product_variant = product.selected_or_first_available_variant %}

                  {% liquid
                    assign product_diameter = product.metafields.custom.diameter.value | default: product.metafields.custom.diameter

                    if product_diameter == blank
                      assign product_diameter = product.metafields.custom.product_diameter.value | default: product.metafields.custom.product_diameter
                    endif

                    assign variant_diameter = product_variant.metafields.custom.diameter.value | default: product_variant.metafields.custom.diameter

                    if variant_diameter == blank
                      assign variant_diameter = product_variant.metafields.custom.product_diameter.value | default: product_variant.metafields.custom.product_diameter
                    endif

                    assign display_diameter = variant_diameter | default: product_diameter
                    assign product_image_count = product.images.size
                  %}

                  <div class="custom-search-product-card" data-search-product-card>
                    <div
                      class="custom-search-product-card__image-wrap {% if product_image_count > 1 %}has-multiple-images{% endif %}"
                      data-search-product-carousel
                    >
                      {% if product_image_count > 0 %}
                        <a
                          href="{{ product.url }}"
                          class="custom-search-product-card__image-link"
                          aria-label="{{ product.title | escape }}"
                          data-search-product-image-link
                        >
                          {% for product_image in product.images limit: 6 %}
                            <img
                              class="custom-search-product-card__image {% if forloop.first %}is-active{% endif %}"
                              src="{{ product_image | image_url: width: 700 }}"
                              alt="{{ product_image.alt | default: product.title | escape }}"
                              loading="lazy"
                              width="700"
                              height="700"
                              data-search-product-slide
                              data-slide-index="{{ forloop.index0 }}"
                            >
                          {% endfor %}
                        </a>

                        {% if product_image_count > 1 %}
                          <button
                            type="button"
                            class="custom-search-product-card__arrow custom-search-product-card__arrow--prev"
                            aria-label="Previous image"
                            data-search-card-prev
                          >
                            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                              <path d="M11.25 14.25L6 9L11.25 3.75" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                          </button>

                          <button
                            type="button"
                            class="custom-search-product-card__arrow custom-search-product-card__arrow--next"
                            aria-label="Next image"
                            data-search-card-next
                          >
                            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                              <path d="M6.75 3.75L12 9L6.75 14.25" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                          </button>
                        {% endif %}
                      {% elsif product.featured_image != blank %}
                        <a
                          href="{{ product.url }}"
                          class="custom-search-product-card__image-link"
                          aria-label="{{ product.title | escape }}"
                        >
                          <img
                            class="custom-search-product-card__image is-active"
                            src="{{ product.featured_image | image_url: width: 700 }}"
                            alt="{{ product.featured_image.alt | default: product.title | escape }}"
                            loading="lazy"
                            width="700"
                            height="700"
                          >
                        </a>
                      {% else %}
                        <a
                          href="{{ product.url }}"
                          class="custom-search-product-card__placeholder"
                          aria-label="{{ product.title | escape }}"
                        >
                          {{ product.title }}
                        </a>
                      {% endif %}
                    </div>

                    <div class="custom-search-product-card__content">
                      <h3 class="custom-search-product-card__title">
                        <a href="{{ product.url }}">
                          {{ product.title }}
                        </a>
                      </h3>

                      {% if display_diameter != blank %}
                        <div class="custom-search-product-card__meta">
                          <span class="custom-search-product-card__meta-label">Diameter</span>

                          <span class="custom-search-product-card__meta-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 14 14" fill="none">
                              <circle cx="7" cy="7" r="6.25" stroke="currentColor" stroke-width="1.2"/>
                              <path d="M4.5 9.5L9.5 4.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                              <path d="M8.2 4.5H9.5V5.8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                              <path d="M5.8 9.5H4.5V8.2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                          </span>

                          <span class="custom-search-product-card__meta-value">
                            {{ display_diameter }}
                          </span>
                        </div>
                      {% endif %}

                      <div class="custom-search-product-card__price">
                        {% if product.price_varies %}
                          Starts at {{ product.price_min | money }}
                        {% else %}
                          Starts at {{ product.price | money }}
                        {% endif %}
                      </div>
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
            </div>

            {% if product_count == 0 %}
              <div class="custom-search-results__empty">
                <h2>No products found</h2>
                <p>Try searching for a different cover or category.</p>
              </div>
            {% endif %}

            {% if paginate.pages > 1 %}
              <nav class="custom-search-results__pagination" role="navigation" aria-label="Pagination">
                {% if paginate.previous %}
                  <a href="{{ paginate.previous.url }}" class="custom-search-results__pagination-link" data-custom-search-link>
                    Previous
                  </a>
                {% endif %}

                {% for part in paginate.parts %}
                  {% if part.is_link %}
                    <a href="{{ part.url }}" class="custom-search-results__pagination-link" data-custom-search-link>
                      {{ part.title }}
                    </a>
                  {% else %}
                    <span class="custom-search-results__pagination-link is-active">
                      {{ part.title }}
                    </span>
                  {% endif %}
                {% endfor %}

                {% if paginate.next %}
                  <a href="{{ paginate.next.url }}" class="custom-search-results__pagination-link" data-custom-search-link>
                    Next
                  </a>
                {% endif %}
              </nav>
            {% endif %}
          </div>
        </div>
      {% endpaginate %}
    {% else %}
      <div class="custom-search-results__empty custom-search-results__empty--not-performed">
        <h2>Search our products</h2>
        <p>Use the search bar above to find covers, sizes, and categories.</p>
      </div>
    {% endif %}
  </div>
</section>

<style>
  .custom-search-results-section {
    width: 100%;
    background: #ffffff;
    padding: 48px 36px 64px;
    transition: opacity 0.2s ease;
  }

  .custom-search-results-section.is-loading {
    opacity: 0.45;
    pointer-events: none;
  }

  body.custom-search-filter-lock {
    overflow: hidden;
  }

  .custom-search-results__inner {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
  }

  .custom-search-results__mobile-toolbar,
  .custom-search-results__mobile-filter-overlay,
  .custom-search-results__mobile-filter-header,
  .custom-search-results__mobile-drawer-actions,
  .custom-search-results__mobile-drawer-sort-row {
    display: none;
  }

  .custom-search-results__layout {
    display: grid;
    grid-template-columns: 278px minmax(0, 1fr);
    gap: 84px;
    align-items: flex-start;
  }

  .custom-search-results__filters {
    width: 100%;
  }

  .custom-search-results__filter-form {
    width: 100%;
  }

  .custom-search-results__filter-card {
    width: 100%;
    background: #ffffff;
    border-radius: 14px;
    padding: 27px 19px;
    box-shadow: 0 4px 5.2px 0 rgba(0, 0, 0, 0.07);
  }

  .custom-search-results__active-filters {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 30px;
  }

  .custom-search-results__active-filter {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 30px;
    padding: 7px 12px;
    border-radius: 999px;
    background: #f1f1f1;
    color: #1f1f1f;
    font-family: Lato, sans-serif;
    font-size: 14px;
    line-height: 1;
    text-decoration: none;
  }

  .custom-search-results__active-filter:hover {
    background: #e7e7e7;
    color: #0F2E53;
  }

  .custom-search-results__active-filter-remove {
    color: #8a8a8a;
    font-size: 17px;
    line-height: 1;
  }

  .custom-search-results__active-filter--clear {
    background: #0F2E53;
    color: #ffffff;
  }

  .custom-search-results__active-filter--clear:hover {
    background: #173f70;
    color: #ffffff;
  }

  .custom-search-results__filter-title {
    color: #1F1F1F;
    font-family: Lato, sans-serif;
    font-size: 20px;
    font-style: normal;
    font-weight: 700;
    line-height: 28px;
    margin: 0 0 20px;
  }

  .custom-search-results__filter-group {
    border-bottom: 1px solid #eeeeee;
    padding: 0 0 14px;
    margin: 0 0 14px;
  }

  .custom-search-results__filter-group:last-of-type {
    border-bottom: 0;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .custom-search-results__filter-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    cursor: pointer;
    list-style: none;
    color: #000000cf;
    font-family: Lato, sans-serif;
    font-size: 20px;
    font-style: normal;
    font-weight: 400;
    line-height: 22px;
  }

  .custom-search-results__filter-summary::-webkit-details-marker {
    display: none;
  }

  .custom-search-results__filter-summary-left {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .custom-search-results__filter-count {
    min-width: 18px;
    height: 18px;
    padding: 0 6px;
    border-radius: 999px;
    background: #eeeeee;
    color: #5f5f5f;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: Lato, sans-serif;
    font-size: 12px;
    line-height: 1;
  }

  .custom-search-results__filter-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #8a8a8a;
    transition: transform 0.2s ease;
  }

  .custom-search-results__filter-group[open] .custom-search-results__filter-arrow {
    transform: rotate(180deg);
  }

  .custom-search-results__filter-body {
    padding-top: 14px;
  }

  .custom-search-results__filter-list {
    list-style: none;
    margin: 0;
