{% schema %}
{
  "name": "Announcement Bars",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#E67E22"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement Text",
      "default": "Free Shipping on $XX+ Orders  •  No Limit on Colors or Background Designs  •  No Minimum Orders Required"
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "Phone Number",
      "default": "+(000) 000 000"
    },
    {
      "type": "text",
      "id": "phone_link",
      "label": "Phone Link",
      "default": "tel:+0000000000"
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "Show Phone Number",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_country_selector",
      "label": "Show Country Selector",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Announcement Bars"
    }
  ]
}
{% endschema %}

<style>
.announcement-bar {
  background-color: {{ section.settings.bg_color }};
  color: {{ section.settings.text_color }};
  padding: 8px 20px;
  font-size: 14px;
  position: relative;
  z-index: 100;
}

.announcement-bar__wrapper {
  max-width: 1600px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.announcement-bar__text {
  flex: 1;
  text-align: center;
  font-weight: 400;
  letter-spacing: 0.3px;
}

.announcement-bar__right {
  display: flex;
  align-items: center;
  gap: 20px;
}

.announcement-bar__phone {
  display: flex;
  align-items: center;
  gap: 8px;
  color: {{ section.settings.text_color }};
  text-decoration: none;
  white-space: nowrap;
}

.announcement-bar__phone-icon {
  width: 20px;
  height: 20px;
}

.announcement-bar__country-selector {
  display: flex;
  align-items: center;
  gap: 6px;
  cursor: pointer;
  position: relative;
  padding: 4px 8px;
  border-radius: 4px;
  transition: background-color 0.2s;
}

.announcement-bar__country-selector:hover {
  background-color: rgba(0, 0, 0, 0.1);
}

.announcement-bar__flag {
  width: 24px;
  height: auto;
}

.announcement-bar__chevron {
  width: 12px;
  height: 12px;
  transition: transform 0.2s;
}

@media (max-width: 768px) {
  .announcement-bar {
    padding: 8px 15px;
    font-size: 12px;
  }

  .announcement-bar__wrapper {
    flex-direction: column;
    gap: 10px;
  }

  .announcement-bar__text {
    font-size: 11px;
  }

  .announcement-bar__right {
    width: 100%;
    justify-content: center;
    gap: 15px;
  }

  .announcement-bar__phone {
    font-size: 12px;
  }
}
</style>

<div class="announcement-bar">
  <div class="announcement-bar__wrapper">
    <div class="announcement-bar__text">
      {{ section.settings.announcement_text }}
    </div>

    <div class="announcement-bar__right">
      {% if section.settings.show_phone %}
        <a href="{{ section.settings.phone_link }}" class="announcement-bar__phone">
          <svg class="announcement-bar__phone-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          <span>{{ section.settings.phone_number }}</span>
        </a>
      {% endif %}

      {% if section.settings.show_country_selector %}
        <div class="announcement-bar__country-selector">
          <img src="https://flagcdn.com/w40/us.png" alt="United States Flag" class="announcement-bar__flag">
          <svg class="announcement-bar__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </div>
      {% endif %}
    </div>
  </div>
</div>