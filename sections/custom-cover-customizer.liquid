                    {%- comment -%} ===== CLIPART PANEL ===== {%- endcomment -%}
                    <div
                      class="custom-cover-customizer__clipart-panel"
                      data-tool-panel="clipart"
                      hidden>
                      <p class="custom-cover-customizer__clipart-title">Choose a clipart</p>

                      {%- assign clipart_metaobject_type = section.settings.clipart_metaobject_type | strip | downcase | replace: ' ', '_' -%}
                      {%- assign clipart_metaobjects_collection = shop.metaobjects[clipart_metaobject_type] -%}
                      {%- if clipart_metaobjects_collection == blank and shop.metaobjects.clipart_item != blank -%}
                        {%- assign clipart_metaobjects_collection = shop.metaobjects.clipart_item -%}
                      {%- endif -%}

                      {%- comment -%}
                        KEY FINDING from debug:
                        - .category.value.handle is EMPTY (Shopify does not expose system handle for referenced metaobjects)
                        - .category.value.name returns the name string directly e.g. "Misc", "Safety", "Music"
                        So we use the lowercased name as our grouping key.
                      {%- endcomment -%}

                      {%- assign clipart_count = 0 -%}
                      {%- assign seen_cat_keys = '' -%}
                      {%- assign ordered_cat_keys = '' -%}
                      {%- assign ordered_cat_names = '' -%}
                      {%- assign clipart_page_size = 50 -%}

                        {%- if clipart_metaobjects_collection != blank -%}
                        {%- paginate clipart_metaobjects_collection.values by clipart_page_size -%}
                        <div
                          data-clipart-pagination
                          data-clipart-current-page="{{ paginate.current_page }}"
                          data-clipart-total-pages="{{ paginate.pages }}"
                          data-clipart-page-param="{{ paginate.page_param | escape }}"
                          data-clipart-section-id="{{ section.id }}">

                        {%- comment -%} Pass 1: collect unique categories in encounter order {%- endcomment -%}
                        {%- for clipart in clipart_metaobjects_collection.values -%}
                          {%- assign clipart_image = clipart.image.value | default: clipart.image -%}
                          {%- if clipart_image == blank -%}
                            {%- continue -%}{%- endif -%}

                          {%- assign cat_name = clipart.category.value.name | strip -%}
                          {%- if cat_name == blank -%}
                            {%- assign cat_name = 'Uncategorized' -%}
                          {%- endif -%}
                          {%- assign cat_key = cat_name | downcase | replace: ' ', '-' -%}

                          {%- assign clipart_count = clipart_count | plus: 1 -%}
                          {%- assign sentinel = cat_key | prepend: '|' | append: '|' -%}
                          {%- unless seen_cat_keys contains sentinel -%}
                            {%- assign seen_cat_keys = seen_cat_keys | append: sentinel -%}
                            {%- assign ordered_cat_keys = ordered_cat_keys | append: cat_key | append: '~~~' -%}
                            {%- assign ordered_cat_names = ordered_cat_names | append: cat_name | append: '~~~' -%}
                          {%- endunless -%}
                        {%- endfor -%}

                        {%- if clipart_count > 0 -%}
                          {%- assign cat_key_list = ordered_cat_keys | split: '~~~' -%}
                          {%- assign cat_name_list = ordered_cat_names | split: '~~~' -%}

                          {%- comment -%} Pass 2: render each category section {%- endcomment -%}
                          {%- for cat_key in cat_key_list -%}
                            {%- if cat_key == blank -%}
                              {%- continue -%}{%- endif -%}
                            {%- assign current_cat_name = cat_name_list[forloop.index0] -%}

                            <div class="custom-cover-customizer__clipart-category" data-clipart-category="{{ cat_key | escape }}">
                              <p class="custom-cover-customizer__clipart-category-name">{{ current_cat_name | escape }}</p>
                              <div class="custom-cover-customizer__clipart-list" data-clipart-list>
                                {%- for clipart in clipart_metaobjects_collection.values -%}
                                  {%- assign clipart_image = clipart.image.value | default: clipart.image -%}
                                  {%- if clipart_image == blank -%}
                                    {%- continue -%}{%- endif -%}

                                  {%- assign item_cat_name = clipart.category.value.name | strip -%}
                                  {%- if item_cat_name == blank -%}
                                    {%- assign item_cat_name = 'Uncategorized' -%}
                                  {%- endif -%}
                                  {%- assign item_cat_key = item_cat_name | downcase | replace: ' ', '-' -%}

                                  {%- unless item_cat_key == cat_key -%}
                                    {%- continue -%}{%- endunless -%}

                                  <button
                                    type="button"
                                    class="custom-cover-customizer__clipart"
                                    data-add-clipart
                                    data-src="{{ clipart_image | image_url: width: 240 }}"
                                    data-category="{{ item_cat_key | escape }}"
                                    aria-label="{{ item_cat_name | escape }} clipart">
                                    {{ clipart_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: item_cat_name }}
                                  </button>
                                {%- endfor -%}
                              </div>
                            </div>
                          {%- endfor -%}

                        {%- else -%}
                          <p class="custom-cover-customizer__message custom-cover-customizer__clipart-empty">
                            Add clipart items in Shopify Admin → Content → Metaobjects
                          </p>
                        {%- endif -%}
                        </div>
                        {%- endpaginate -%}

                      {%- endif -%}
