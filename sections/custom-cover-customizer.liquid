{%- liquid
  assign all_catalog_products = collections['all'].products
  assign all_catalog_products_limit = 250
-%}

{{ 'custom-cover-customizer.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign font_library_mode = section.settings.font_library | default: 'both'
-%}
{%- capture google_fonts_pipe -%}
{%- render 'custom-cover-customizer-google-font-pipe-list' -%}
{%- endcapture -%}
{%- assign google_fonts_pipe = google_fonts_pipe | strip -%}
{%- assign custom_cover_font_lines = section.settings.font_choices | newline_to_br | split: '<br />' -%}
{%- assign default_text_hex = section.settings.default_text_color | default: '#000000' -%}
{%- assign default_outline_hex = section.settings.default_text_outline_color | default: '#ffffff' -%}
{%- assign template_handles = section.settings.templates_handles | newline_to_br | split: '<br />' -%}
{%- assign templates_metaobject_type = section.settings.templates_metaobject_type | strip | downcase | replace: ' ', '_' -%}
{%- assign templates_metaobjects_collection = shop.metaobjects[templates_metaobject_type] -%}
{%- if templates_metaobjects_collection == blank and shop.metaobjects.templates != blank -%}
  {%- assign templates_metaobjects_collection = shop.metaobjects.templates -%}
{%- endif -%}
{%- if font_library_mode != 'custom' -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin>
{%- endif -%}
<script
  src="{{ 'custom-cover-customizer.js' | asset_url }}"
  type="module"
  fetchpriority="low"></script>

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section class="section custom-cover-customizer color-{{ section.settings.color_scheme }}" data-section-id="{{ section.id }}">
  <div class="section-content-wrapper spacing-style custom-cover-customizer__layout" style="{% render 'spacing-style', settings: section.settings %}">
    <div class="custom-cover-customizer__design-bar custom-cover-customizer__design-bar--header">
      <label class="custom-cover-customizer__design-title-wrap">
        <span class="visually-hidden">Design title</span>
        <input
          type="text"
          size="1"
          class="custom-cover-customizer__design-title-input"
          name="properties[Design title]"
          form="CustomizerProductForm-{{ section.id }}"
          value="Untitled"
          data-design-title-input
          aria-label="Design title">
        <span
          class="custom-cover-customizer__design-title-icon"
          aria-hidden="true"
          style="width: 24px; height: 24px; flex-shrink: 0;">
          {{- 'custom-icon-design-title-edit.svg' | inline_asset_content -}}
        </span>
      </label>
      <details class="custom-cover-customizer__design-overflow">
        <summary class="custom-cover-customizer__design-overflow-summary">
          <span class="visually-hidden">More design actions</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true">
            <circle
              cx="5"
              cy="12"
              r="1.75" />
            <circle
              cx="12"
              cy="12"
              r="1.75" />
            <circle
              cx="19"
              cy="12"
              r="1.75" />
          </svg>
        </summary>
        <div class="custom-cover-customizer__design-overflow-body">
          {% render 'custom-cover-customizer-design-bar-actions'
            , section_id: section.id
            , menu_variant: 'menu' %}
        </div>
      </details>
      <div class="custom-cover-customizer__design-bar-actions">
        {% render 'custom-cover-customizer-design-bar-actions'
          , section_id: section.id
          , menu_variant: 'inline' %}
      </div>
    </div>

    <div class="custom-cover-customizer__left-column">
      {%- assign safe_banner_text = section.settings.safe_area_warning | strip -%}
      {%- if safe_banner_text == blank -%}
        {%- assign safe_banner_text = "Can't print up to the end of the edge" -%}
      {%- endif -%}
      <div
        class="custom-cover-customizer__safe-banner"
        role="status"
        aria-live="polite">
        <span class="custom-cover-customizer__safe-banner-icon" aria-hidden="true">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 18 18"
            fill="none">
            <path
              d="M9 16.5C13.1421 16.5 16.5 13.1421 16.5 9C16.5 4.85786 13.1421 1.5 9 1.5C4.85786 1.5 1.5 4.85786 1.5 9C1.5 13.1421 4.85786 16.5 9 16.5Z"
              stroke="#DA0004"
              stroke-linecap="round"
              stroke-linejoin="round" />
            <path
              d="M9 6V9"
              stroke="#DA0004"
              stroke-linecap="round"
              stroke-linejoin="round" />
            <path
              d="M9 12H9.0075"
              stroke="#DA0004"
              stroke-linecap="round"
              stroke-linejoin="round" />
          </svg>
        </span>
        <span>{{ safe_banner_text | escape }}</span>
      </div>

      <div class="custom-cover-customizer__panel">
        <custom-cover-customizer-component
          class="custom-cover-customizer__app"
          data-section-id="{{ section.id }}"
          data-product-id=""
          data-customer-id="{% if customer %}{{ customer.id }}{% endif %}"
          data-customer-logged-in="{% if customer %}true{% else %}false{% endif %}"
          data-draft-api-endpoint="{{ section.settings.drafts_api_endpoint | escape }}"
          data-safe-area-shape="{{ section.settings.safe_area_shape | default: 'circle' }}"
          data-safe-x="{{ section.settings.safe_area_x }}"
          data-safe-y="{{ section.settings.safe_area_y }}"
          data-safe-width="{{ section.settings.safe_area_width }}"
          data-safe-height="{{ section.settings.safe_area_height }}"
          data-text-price-cents="{{ section.settings.text_price_adjustment | times: 100 | round }}"
          data-image-price-cents="{{ section.settings.image_price_adjustment | times: 100 | round }}"
          data-clipart-price-cents="{{ section.settings.clipart_price_adjustment | times: 100 | round }}"
          data-shape-price-cents="{{ section.settings.shape_price_adjustment | times: 100 | round }}"
          data-max-upload-bytes="{{ section.settings.max_upload_mb | default: 10 | times: 1048576 | round }}"
          data-max-upload-mb="{{ section.settings.max_upload_mb | default: 10 }}"
          data-block-outside-safe-area="{{ section.settings.block_outside_safe_area }}"
          data-safe-warning="{{ section.settings.safe_area_warning | escape }}"
          data-upload-warning="{{ section.settings.upload_warning | escape }}"
          data-font-fallback="{{ section.settings.font_fallback | escape }}"
          data-google-font-library="{{ font_library_mode | escape }}"
          {% if font_library_mode == 'both' and google_fonts_pipe != blank %}
          data-google-font-allowlist="{{ google_fonts_pipe | escape }}"
          {% endif %}
          data-currency-code="{{ cart.currency.iso_code }}"
          data-money-format="{{ shop.money_format | escape }}"
          data-include-preview="{{ section.settings.include_preview_data }}"
          data-imprint-variant-size-option="{{ section.settings.variant_imprint_size_option | escape }}"
          data-imprint-variant-type-option="{{ section.settings.variant_imprint_type_option | escape }}"
          data-imprint-variant-color-option="{{ section.settings.variant_imprint_color_option | escape }}">

          <script type="application/json" data-product-catalog>
            [
              {%- for product in all_catalog_products limit: all_catalog_products_limit -%}
                {
                  "id": {{ product.id | json }},
                  "title": {{ product.title | strip | json }},
                  "optionNames": [
                    {%- for option in product.options_with_values -%}
                      {{ option.name | json }}
                      {%- unless forloop.last -%},{%- endunless -%}
                    {%- endfor -%}
                  ],
                  "variants": [
                    {%- for variant in product.variants -%}
                      {
                        "id": {{ variant.id | json }},
                        "title": {{ variant.title | strip | json }},
                        "price": {{ variant.price | json }},
                        "available": {{ variant.available | json }},
                        "option1": {{ variant.option1 | json }},
                        "option2": {{ variant.option2 | json }},
                        "option3": {{ variant.option3 | json }}
                      }{%- unless forloop.last -%},{%- endunless -%}
                    {%- endfor -%}
                  ]
                }{%- unless forloop.last -%},{%- endunless -%}
              {%- endfor -%}
            ]
          </script>

          <form
            method="post"
            action="{{ routes.cart_add_url }}"
            id="CustomizerProductForm-{{ section.id }}"
            class="custom-cover-customizer__form">
            <input
              type="hidden"
              name="id"
              value="">
            <input
              type="hidden"
              name="quantity"
              value="1">
            <input
              type="hidden"
              name="properties[_Customizer JSON]"
              data-customizer-json>
            <input
              type="hidden"
              name="properties[_Safe Area Status]"
              data-safe-area-status>
            <input
              type="hidden"
              name="properties[_Customizer Preview]"
              data-preview-image>
            <input
              type="hidden"
              name="properties[_Customizer Preview Token]"
              data-preview-token>
            <input
              type="hidden"
              name="properties[Imprint size]"
              data-imprint-size-property>
            <input
              type="hidden"
              name="properties[Imprint]"
              data-imprint-text-property>

            <div
              class="custom-cover-customizer__mode-tabs"
              role="tablist"
              aria-label="Customizer modes">
              <button
                type="button"
                class="custom-cover-customizer__mode-tab is-active"
                data-mode-tab="editor"
                role="tab"
                aria-selected="true">
                <span class="custom-cover-customizer__mode-tab-icon" aria-hidden="true">{{- 'custom-icon-editor.svg' | inline_asset_content -}}</span>
                <span class="custom-cover-customizer__mode-tab-label">Editor</span>
              </button>
              <button
                type="button"
                class="custom-cover-customizer__mode-tab"
                data-mode-tab="templates"
                role="tab"
                aria-selected="false">
                <span class="custom-cover-customizer__mode-tab-icon" aria-hidden="true">{{- 'custom-icon-templates.svg' | inline_asset_content -}}</span>
                <span class="custom-cover-customizer__mode-tab-label">Templates</span>
              </button>
              <button
                type="button"
                class="custom-cover-customizer__mode-tab"
                data-mode-tab="drafts"
                role="tab"
                aria-selected="false">
                <span class="custom-cover-customizer__mode-tab-icon" aria-hidden="true">{{- 'custom-icon-drafts.svg' | inline_asset_content -}}</span>
                <span class="custom-cover-customizer__mode-tab-label">Drafts</span>
              </button>
            </div>

            <div
              class="custom-cover-customizer__drawer"
              data-customizer-drawer
              aria-hidden="true">
              <div class="custom-cover-customizer__drawer-backdrop" data-customizer-drawer-backdrop></div>
              <div
                class="custom-cover-customizer__drawer-sheet"
                role="dialog"
                aria-modal="true"
                aria-labelledby="CustomizerDrawerTitle-{{ section.id }}"
                id="CustomizerDrawer-{{ section.id }}">
                <div class="custom-cover-customizer__drawer-header">
                  <h2
                    class="custom-cover-customizer__drawer-title"
                    id="CustomizerDrawerTitle-{{ section.id }}"
                    data-customizer-drawer-title>
                    Editor
                  </h2>
                  <button
                    type="button"
                    class="custom-cover-customizer__drawer-close"
                    data-customizer-drawer-close
                    aria-label="Close panel">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="22"
                      height="22"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      aria-hidden="true">
                      <path d="M18 6L6 18M6 6l12 12" />
                    </svg>
                  </button>
                </div>

                <div class="custom-cover-customizer__drawer-body">
                  <p
                    class="custom-cover-customizer__warning"
                    aria-live="polite"
                    data-warning-output></p>

                  <div data-mode-panel="editor">
                    <div class="custom-cover-customizer__product-fields">
                      <p class="custom-cover-customizer__label custom-cover-customizer__section-label">Product</p>
                      <div class="custom-cover-customizer__group">
                        <label class="custom-cover-customizer__label" for="CustomizerProduct-{{ section.id }}">Product name</label>
                        <select
                          id="CustomizerProduct-{{ section.id }}"
                          class="custom-cover-customizer__input custom-cover-customizer__input--select-like"
                          name="product_selector"
                          data-product-selector>
                          <option
                            value=""
                            selected
                            disabled>Select product</option>
                          {%- for product in all_catalog_products limit: all_catalog_products_limit -%}
                            <option value="{{ product.id }}">{{ product.title | escape }}</option>
                          {%- endfor -%}
                        </select>
                      </div>
                      <div class="custom-cover-customizer__group">
                        <div class="custom-cover-customizer__label-action-row">
                          <label class="custom-cover-customizer__label" for="CustomizerImprintText-{{ section.id }}">
                            {{- section.settings.imprint_text_label | default: 'Imprint' | escape -}}
                          </label>
                          <button
                            type="button"
                            class="custom-cover-customizer__round-action custom-cover-customizer__round-action--imprint-hint"
                            data-size-guide-open
                            aria-haspopup="dialog"
                            aria-controls="SizingGuideModal-{{ section.id }}-customizer"
                            aria-label="Sizing guide">
                            <span class="custom-cover-customizer__round-action-icon" aria-hidden="true">
                              <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 19 19" fill="none" aria-hidden="true">
                                <g transform="translate(9.5 9.5) scale(1.08) translate(-9.5 -9.5)">
                                  <path d="M6.75024 7.4204C6.94616 6.86345 7.33287 6.39382 7.84187 6.09467C8.35087 5.79553 8.94932 5.68618 9.53122 5.78599C10.1131 5.8858 10.6409 6.18833 11.0211 6.64C11.4014 7.09167 11.6095 7.66333 11.6086 8.25373C11.6086 9.9204 9.10858 10.7537 9.10858 10.7537" stroke="#5F5F5F" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round"/>
                                  <path d="M9.08333 13.75H9.09166" stroke="#5F5F5F" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round"/>
                                </g>
                              </svg>
                            </span>
                          </button>
                        </div>
                        <div>
                          <select
                            id="CustomizerImprintText-{{ section.id }}"
                            class="custom-cover-customizer__input custom-cover-customizer__input--select-like"
                            data-imprint-text
                            autocomplete="off"
                            aria-label="{{ section.settings.imprint_text_placeholder | default: 'Select imprint' | escape }}">
                            <option value="" disabled selected>
                              {{- section.settings.imprint_text_placeholder | default: 'Select imprint' | escape -}}
                            </option>
                            {% assign imprint_types = section.settings.imprint_types | newline_to_br | split: '<br />' %}
                            {% for imprint_type in imprint_types %}
                              {% assign trimmed_imprint_type = imprint_type | strip %}
                              {% if trimmed_imprint_type != blank %}
                                <option value="{{ trimmed_imprint_type | escape }}">
                                  {{- trimmed_imprint_type | escape -}}
                                </option>
                              {% endif %}
                            {% endfor %}
                          </select>
                        </div>
                      </div>
                      <div class="custom-cover-customizer__group">
                        <div class="custom-cover-customizer__label-action-row">
                          <label class="custom-cover-customizer__label" for="CustomizerImprint-{{ section.id }}">Imprint size</label>
                        </div>
                        <div>
                          <select
                            id="CustomizerImprint-{{ section.id }}"
                            class="custom-cover-customizer__input custom-cover-customizer__input--select-like"
                            data-imprint-size>
                            <option value="" disabled>Select imprint size</option>
                            {% assign imprint_sizes = section.settings.imprint_sizes | newline_to_br | split: '<br />' %}
                            {% assign imprint_list_has_plain_other = false %}
                            {% for imprint_size in imprint_sizes %}
                              {% assign trimmed_imprint_size = imprint_size | strip %}
                              {% if trimmed_imprint_size != blank %}
                                {% assign imprint_line_lc = trimmed_imprint_size | downcase %}
                                {% if imprint_line_lc == 'other' %}
                                  {% assign imprint_list_has_plain_other = true %}
                                {% endif %}
                                <option
                                  value="{{ trimmed_imprint_size | escape }}"
                                  {% if imprint_line_lc == 'other' %}
                                  selected
                                  data-imprint-other-option{% endif %}>{{ trimmed_imprint_size | escape }}</option>
                              {% endif %}
                            {% endfor %}
                            {% unless imprint_list_has_plain_other %}
                              <option
                                value="__custom_imprint_size__"
                                selected
                                data-imprint-other-option>
                                {{- section.settings.imprint_other_option_label | default: 'Other' | escape -}}
                              </option>
                            {% endunless %}
                          </select>
                        </div>
                      </div>
                      <div
                        class="custom-cover-customizer__group"
                        data-variant-color-group>
                        <label class="custom-cover-customizer__label" for="CustomizerVariant-{{ section.id }}">
                          <span>{{ section.settings.variant_imprint_color_option | default: 'Color' | escape }}:</span>
                          <span data-selected-color-label>—</span>
                        </label>
                        <select
                          id="CustomizerVariant-{{ section.id }}"
                          class="custom-cover-customizer__input custom-cover-customizer__input--select-like custom-cover-customizer__variant-select"
                          name="variant_selector"
                          data-variant-selector
                          hidden
                          aria-hidden="true"
                          tabindex="-1">
                          <option
                            value=""
                            selected
                            disabled>Select color</option>
                        </select>
                        <div
                          class="custom-cover-customizer__swatches"
                          data-variant-swatches
                          aria-label="Color swatches"
                          role="list"></div>
                      </div>
                    </div>

                    <div class="custom-cover-customizer__toolbar-wrap">
                      <p class="custom-cover-customizer__label custom-cover-customizer__section-label">Insert</p>
                      <div
                        class="custom-cover-customizer__toolbar"
                        role="toolbar"
                        aria-label="Insert tools">
                        <button
                          type="button"
                          class="custom-cover-customizer__tool is-active"
                          data-tool-button="text">
                          <span class="custom-cover-customizer__tool-icon custom-cover-customizer__tool-icon--svg" aria-hidden="true">{{- 'icon-customizer-tool-text.svg' | inline_asset_content -}}</span>
                          <span>{{ section.settings.text_button_label | escape }}</span>
                        </button>
                        <button
                          type="button"
                          class="custom-cover-customizer__tool"
                          data-tool-button="image">
                          <span class="custom-cover-customizer__tool-icon custom-cover-customizer__tool-icon--svg" aria-hidden="true">{{- 'icon-customizer-tool-image.svg' | inline_asset_content -}}</span>
                          <span>{{ section.settings.image_button_label | escape }}</span>
                        </button>
                        <button
                          type="button"
                          class="custom-cover-customizer__tool"
                          data-tool-button="clipart">
                          <span class="custom-cover-customizer__tool-icon custom-cover-customizer__tool-icon--svg" aria-hidden="true">{{- 'icon-customizer-tool-clipart.svg' | inline_asset_content -}}</span>
                          <span>{{ section.settings.clipart_heading | escape }}</span>
                        </button>
                        <button
                          type="button"
                          class="custom-cover-customizer__tool"
                          data-tool-button="shapes">
                          <span class="custom-cover-customizer__tool-icon custom-cover-customizer__tool-icon--svg" aria-hidden="true">{{- 'icon-customizer-tool-shapes.svg' | inline_asset_content -}}</span>
                          <span>{{ section.settings.shapes_section_heading | escape }}</span>
                        </button>
                        <button
                          type="button"
                          class="custom-cover-customizer__tool"
                          data-tool-button="background">
                          <span class="custom-cover-customizer__tool-icon custom-cover-customizer__tool-icon--svg" aria-hidden="true">{{- 'icon-customizer-tool-background.svg' | inline_asset_content -}}</span>
                          <span>{{ section.settings.background_button_label | escape }}</span>
                        </button>
                      </div>
                      <input
                        type="file"
                        accept="image/*,.svg,.ai"
                        data-upload-input
                        class="custom-cover-customizer__hidden-upload">
                    </div>

                    <div
                      class="custom-cover-customizer__image-panel"
                      data-tool-panel="image"
                      hidden>
                      <label class="custom-cover-customizer__rights">
                        <input type="checkbox" data-image-rights>
                        <span>{{ section.settings.image_rights_label | default: 'Allow stretchablecovers to have rights to this image' | escape }}</span>
                      </label>
                      <div class="custom-cover-customizer__upload-box" data-upload-box hidden>
                        <p
                          class="custom-cover-customizer__warning custom-cover-customizer__warning--upload"
                          aria-live="polite"
                          data-upload-warning-output></p>
                        <button
                          type="button"
                          class="custom-cover-customizer__dropzone"
                          data-upload-dropzone>
                          <span class="custom-cover-customizer__dropzone-icon" aria-hidden="true">
                            <svg
                              xmlns="http://www.w3.org/2000/svg"
                              width="40"
                              height="40"
                              viewBox="0 0 40 40"
                              fill="none">
                              <path
                                d="M20 5V25"
                                stroke="#5F5F5F"
                                stroke-width="3"
                                stroke-linecap="round"
                                stroke-linejoin="round" />
                              <path
                                d="M28.3334 13.3333L20 5L11.6667 13.3333"
                                stroke="#5F5F5F"
                                stroke-width="3"
                                stroke-linecap="round"
                                stroke-linejoin="round" />
                              <path
                                d="M35 25V31.6667C35 32.5507 34.6488 33.3986 34.0237 34.0237C33.3986 34.6488 32.5507 35 31.6667 35H8.33333C7.44928 35 6.60143 34.6488 5.97631 34.0237C5.35119 33.3986 5 32.5507 5 31.6667V25"
                                stroke="#5F5F5F"
                                stroke-width="3"
                                stroke-linecap="round"
                                stroke-linejoin="round" />
                            </svg>
                          </span>
                          <span class="custom-cover-customizer__dropzone-label">
                            {{-
                              section.settings.image_upload_dropzone_label
                              | default: 'Browse your computer or drag your image here'
                              | escape
                            -}}
                          </span>
                          <span class="custom-cover-customizer__dropzone-formats">
                            {{-
                              section.settings.image_upload_formats_hint
                              | default: 'Accepts JPG, PNG, SVG, and WebP'
                              | escape
                            -}}
                          </span>
                          <span class="custom-cover-customizer__dropzone-max">
                            Max file size:
                            {{ section.settings.max_upload_mb | default: 10 }} MB
                          </span>
                        </button>
                      </div>
                    </div>

                    <div
                      class="custom-cover-customizer__background-panel"
                      data-tool-panel="background"
                      hidden>
                      <div class="custom-cover-customizer__background-mode" role="radiogroup" aria-label="Background style">
                        <button type="button" class="custom-cover-customizer__background-mode-btn is-active" data-background-mode="solid" aria-pressed="true">Solid</button>
                        <button type="button" class="custom-cover-customizer__background-mode-btn" data-background-mode="gradient" aria-pressed="false">Gradient</button>
                        <button type="button" class="custom-cover-customizer__background-mode-btn" data-background-mode="image" aria-pressed="false">Image</button>
                      </div>

                      <div class="custom-cover-customizer__background-pane custom-cover-customizer__text-color-row" data-background-pane="solid">
                        <label class="custom-cover-customizer__label" for="CustomizerBackgroundSolid-{{ section.id }}">
                          Solid color
                        </label>
                        <label class="custom-cover-customizer__color-chip">
                          <span class="visually-hidden">Solid color</span>
                          <input
                            id="CustomizerBackgroundSolid-{{ section.id }}"
                            class="custom-cover-customizer__color-native"
                            type="color"
                            value="#ffffff"
                            data-background-solid-input
                            aria-label="Solid color">
                          <span
                            class="custom-cover-customizer__color-swatch"
                            data-background-solid-swatch
                            aria-hidden="true"
                            style="background-color: #ffffff"></span>
