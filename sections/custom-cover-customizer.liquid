                <iframe
                  data-help-video-frame
                  class="custom-cover-help-modal__iframe"
                  title="{{ section.settings.design_help_heading | escape }} — video"
                  loading="lazy"
                  src=""
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  allowfullscreen></iframe>
              {%- else -%}
                <video
                  data-help-video-element
                  class="custom-cover-help-modal__iframe"
                  controls
                  playsinline
                  preload="metadata"
                  src="{{ design_help_video_url | escape }}">
                  Your browser does not support the video tag.
                </video>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endunless -%}
</section>

