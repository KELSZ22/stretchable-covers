{%- liquid
  assign customizer_product = section.settings.product
  assign initial_variant = blank
  if customizer_product != blank
    assign initial_variant = customizer_product.selected_or_first_available_variant
  endif
-%}

{{ 'custom-cover-customizer.css' | asset_url | stylesheet_tag }}
<script
  src="{{ 'custom-cover-customizer.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="section custom-cover-customizer color-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
>
  <div
    class="section-content-wrapper spacing-style custom-cover-customizer__layout"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    <div class="custom-cover-customizer__panel">
      {% if section.settings.heading != blank %}
        <h2 class="custom-cover-customizer__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="custom-cover-customizer__subheading">{{ section.settings.subheading | escape }}</p>
      {% endif %}

      {% if customizer_product == blank %}
        <p class="custom-cover-customizer__message">
          {{ section.settings.empty_product_message | escape }}
        </p>
      {% else %}
        <custom-cover-customizer-component
          class="custom-cover-customizer__app"
          data-safe-x="{{ section.settings.safe_area_x }}"
          data-safe-y="{{ section.settings.safe_area_y }}"
          data-safe-width="{{ section.settings.safe_area_width }}"
          data-safe-height="{{ section.settings.safe_area_height }}"
          data-text-price-cents="{{ section.settings.text_price_adjustment | times: 100 | round }}"
          data-image-price-cents="{{ section.settings.image_price_adjustment | times: 100 | round }}"
          data-clipart-price-cents="{{ section.settings.clipart_price_adjustment | times: 100 | round }}"
          data-max-upload-bytes="{{ section.settings.max_upload_mb | times: 1048576 | round }}"
          data-block-outside-safe-area="{{ section.settings.block_outside_safe_area }}"
          data-safe-warning="{{ section.settings.safe_area_warning | escape }}"
          data-upload-warning="{{ section.settings.upload_warning | escape }}"
          data-font-fallback="{{ section.settings.font_fallback | escape }}"
          data-currency-code="{{ cart.currency.iso_code }}"
          data-money-format="{{ shop.money_format | escape }}"
          data-include-preview="{{ section.settings.include_preview_data }}"
        >
          <form
            method="post"
            action="{{ routes.cart_add_url }}"
            id="CustomizerProductForm-{{ section.id }}"
            class="custom-cover-customizer__form"
          >
            <input type="hidden" name="id" value="{{ initial_variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <input type="hidden" name="properties[_Customizer JSON]" data-customizer-json>
            <input type="hidden" name="properties[_Safe Area Status]" data-safe-area-status>
            <input type="hidden" name="properties[_Customizer Preview]" data-preview-image>

            <div class="custom-cover-customizer__group">
              <label class="custom-cover-customizer__label" for="CustomizerProduct-{{ section.id }}">Product</label>
              <select id="CustomizerProduct-{{ section.id }}" class="custom-cover-customizer__input" disabled>
                <option selected>{{ customizer_product.title | escape }}</option>
              </select>
            </div>

            <div class="custom-cover-customizer__group">
              <label class="custom-cover-customizer__label" for="CustomizerVariant-{{ section.id }}">Product size</label>
              <select
                id="CustomizerVariant-{{ section.id }}"
                class="custom-cover-customizer__input"
                name="variant_selector"
                data-variant-selector
              >
                {% for variant in customizer_product.variants %}
                  <option
                    value="{{ variant.id }}"
                    data-price="{{ variant.price }}"
                    {% if variant.id == initial_variant.id %}
                      selected
                    {% endif %}
                    {% unless variant.available %}
                      disabled
                    {% endunless %}
                  >
                    {{ variant.title | escape }}{% unless variant.available %} - {{ 'content.unavailable' | t }}{% endunless %}
                  </option>
                {% endfor %}
              </select>
            </div>

            <div class="custom-cover-customizer__group">
              <label class="custom-cover-customizer__label" for="CustomizerImprint-{{ section.id }}">Imprint size</label>
              <select
                id="CustomizerImprint-{{ section.id }}"
                class="custom-cover-customizer__input"
                data-imprint-size
              >
                {% assign imprint_sizes = section.settings.imprint_sizes | newline_to_br | split: '<br />' %}
                {% for imprint_size in imprint_sizes %}
                  {% assign trimmed_imprint_size = imprint_size | strip %}
                  {% if trimmed_imprint_size != blank %}
                    <option value="{{ trimmed_imprint_size | escape }}">{{ trimmed_imprint_size | escape }}</option>
                  {% endif %}
                {% endfor %}
              </select>
            </div>

            <div class="custom-cover-customizer__group">
              <p class="custom-cover-customizer__label">Insert</p>
              <div class="custom-cover-customizer__toolbar" role="toolbar" aria-label="Insert tools">
                <button
                  type="button"
                  class="custom-cover-customizer__tool is-active"
                  data-tool-button="text"
                  data-add-text
                >
                  <span class="custom-cover-customizer__tool-icon custom-cover-customizer__tool-icon--text">T</span>
                  <span>Text</span>
                </button>
                <button
                  type="button"
                  class="custom-cover-customizer__tool"
                  data-tool-button="image"
                  data-trigger-upload
                >
                  <span class="custom-cover-customizer__tool-icon">▧</span>
                  <span>Image</span>
                </button>
                <button
                  type="button"
                  class="custom-cover-customizer__tool"
                  data-tool-button="clipart"
                  data-open-clipart
                >
                  <span class="custom-cover-customizer__tool-icon">✿</span>
                  <span>Clipart</span>
                </button>
                <button
                  type="button"
                  class="custom-cover-customizer__tool"
                  data-tool-button="shapes"
                  data-open-shapes
                >
                  <span class="custom-cover-customizer__tool-icon">△</span>
                  <span>Shapes</span>
                </button>
              </div>
              <input type="file" accept="image/*" data-upload-input class="custom-cover-customizer__hidden-upload">
            </div>

            <div class="custom-cover-customizer__image-panel" data-tool-panel="image" hidden>
              <label class="custom-cover-customizer__rights">
                <input type="checkbox" data-image-rights>
                <span>{{ section.settings.image_rights_label | escape }}</span>
              </label>
              <button type="button" class="custom-cover-customizer__dropzone" data-upload-dropzone>
                <span class="custom-cover-customizer__dropzone-icon">⇪</span>
                <span>Browse your computer or drag your file here</span>
              </button>
            </div>

            {% if section.blocks.size > 0 %}
              <div class="custom-cover-customizer__clipart-panel" data-tool-panel="clipart" hidden>
                <p class="custom-cover-customizer__clipart-title">Choose a clipart</p>
                <div class="custom-cover-customizer__clipart-list">
                  {% for block in section.blocks %}
                    {% if block.settings.icon != blank %}
                      <button
                        type="button"
                        class="custom-cover-customizer__clipart"
                        data-add-clipart
                        data-src="{{ block.settings.icon | image_url: width: 240 }}"
                        aria-label="{{ block.settings.label | default: 'Clipart' | escape }}"
                        {{ block.shopify_attributes }}
                      >
                        {{ block.settings.icon | image_url: width: 160 | image_tag: loading: 'lazy', alt: block.settings.label }}
                      </button>
                    {% endif %}
                  {% endfor %}
                </div>
              </div>
            {% endif %}

            <div class="custom-cover-customizer__group">
              <label class="custom-cover-customizer__label" for="CustomizerTextInput-{{ section.id }}">Text</label>
              <textarea
                id="CustomizerTextInput-{{ section.id }}"
                class="custom-cover-customizer__textarea"
                rows="3"
                maxlength="{{ section.settings.max_text_length }}"
                data-text-input
                placeholder="{{ section.settings.text_placeholder | escape }}"
              ></textarea>
            </div>

            <div class="custom-cover-customizer__inline-grid">
              <div class="custom-cover-customizer__group">
                <label class="custom-cover-customizer__label" for="CustomizerFont-{{ section.id }}">Font</label>
                <select id="CustomizerFont-{{ section.id }}" class="custom-cover-customizer__input" data-font-input>
                  {% assign fonts = section.settings.font_choices | newline_to_br | split: '<br />' %}
                  {% for font in fonts %}
                    {% assign trimmed_font = font | strip %}
                    {% if trimmed_font != blank %}
                      <option value="{{ trimmed_font | escape }}">{{ trimmed_font | escape }}</option>
                    {% endif %}
                  {% endfor %}
                </select>
              </div>
              <div class="custom-cover-customizer__group">
                <label class="custom-cover-customizer__label" for="CustomizerFontSize-{{ section.id }}">Size</label>
                <input
                  id="CustomizerFontSize-{{ section.id }}"
                  class="custom-cover-customizer__input"
                  type="number"
                  min="{{ section.settings.min_font_size }}"
                  max="{{ section.settings.max_font_size }}"
                  value="{{ section.settings.default_font_size }}"
                  data-font-size-input
                >
              </div>
            </div>

            <div class="custom-cover-customizer__inline-grid">
              <div class="custom-cover-customizer__group">
                <label class="custom-cover-customizer__label" for="CustomizerColor-{{ section.id }}">Color</label>
                <input
                  id="CustomizerColor-{{ section.id }}"
                  class="custom-cover-customizer__input custom-cover-customizer__color"
                  type="color"
                  value="{{ section.settings.default_text_color }}"
                  data-text-color-input
                >
              </div>
              <div class="custom-cover-customizer__group">
                <label class="custom-cover-customizer__label" for="CustomizerRotate-{{ section.id }}">Rotate</label>
                <input
                  id="CustomizerRotate-{{ section.id }}"
                  class="custom-cover-customizer__input"
                  type="range"
                  min="-180"
                  max="180"
                  step="1"
                  value="0"
                  data-rotate-input
                >
              </div>
            </div>

            <div class="custom-cover-customizer__group">
              <label class="custom-cover-customizer__label" for="CustomizerScale-{{ section.id }}">Scale</label>
              <input
                id="CustomizerScale-{{ section.id }}"
                class="custom-cover-customizer__input"
                type="range"
                min="40"
                max="240"
                step="1"
                value="100"
                data-scale-input
              >
            </div>

            <div class="custom-cover-customizer__pricing">
              <p class="custom-cover-customizer__price-label">{{ section.settings.price_label | escape }}</p>
              <p class="custom-cover-customizer__price-value" data-live-price>
                {{ initial_variant.price | money }}
              </p>
            </div>

            <p class="custom-cover-customizer__warning" aria-live="polite" data-warning-output></p>

            <button type="submit" class="button">{{ section.settings.add_to_cart_label | escape }}</button>
          </form>
        </custom-cover-customizer-component>
      {% endif %}
    </div>

    <div class="custom-cover-customizer__preview">
      <div class="custom-cover-customizer__canvas-wrap">
        <canvas
          width="900"
          height="900"
          data-customizer-canvas
          aria-label="Cover customizer canvas"
        ></canvas>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom Cover Customizer",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Customizer product"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Design your stretchable cover"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Add text, images, and clipart to create your custom print."
    },
    {
      "type": "text",
      "id": "empty_product_message",
      "label": "Empty state message",
      "default": "Select a product in section settings to activate the customizer."
    },
    {
      "type": "header",
      "content": "Text settings"
    },
    {
      "type": "textarea",
      "id": "font_choices",
      "label": "Font list (one per line)",
      "default": "Arial\nHelvetica\nGeorgia\nTimes New Roman"
    },
    {
      "type": "range",
      "id": "min_font_size",
      "label": "Min font size",
      "min": 8,
      "max": 120,
      "step": 2,
      "default": 12
    },
    {
      "type": "range",
      "id": "default_font_size",
      "label": "Default font size",
      "min": 8,
      "max": 200,
      "step": 2,
      "default": 24
    },
    {
      "type": "range",
      "id": "max_font_size",
      "label": "Max font size",
      "min": 20,
      "max": 320,
      "step": 5,
      "default": 120
    },
    {
      "type": "range",
      "id": "max_text_length",
      "label": "Max text length",
      "min": 20,
      "max": 400,
      "step": 5,
      "default": 80
    },
    {
      "type": "color",
      "id": "default_text_color",
      "label": "Default text color",
      "default": "#000000"
    },
    {
      "type": "text",
      "id": "font_fallback",
      "label": "Font fallback stack",
      "default": "sans-serif"
    },
    {
      "type": "text",
      "id": "text_placeholder",
      "label": "Text placeholder",
      "default": "Insert your text"
    },
    {
      "type": "text",
      "id": "text_button_label",
      "label": "Text button label",
      "default": "Add text"
    },
    {
      "type": "text",
      "id": "image_button_label",
      "label": "Image button label",
      "default": "Upload image"
    },
    {
      "type": "text",
      "id": "image_rights_label",
      "label": "Image rights label",
      "default": "Allow stretchablecovers to have rights to this image"
    },
    {
      "type": "text",
      "id": "clipart_heading",
      "label": "Clipart heading",
      "default": "Clipart"
    },
    {
      "type": "textarea",
      "id": "imprint_sizes",
      "label": "Imprint sizes (one per line)",
      "default": "Small\nMedium\nLarge"
    },
    {
      "type": "header",
      "content": "Safe area and validation"
    },
    {
      "type": "range",
      "id": "safe_area_x",
      "label": "Safe area X start (%)",
      "min": 0,
      "max": 90,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "safe_area_y",
      "label": "Safe area Y start (%)",
      "min": 0,
      "max": 90,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "safe_area_width",
      "label": "Safe area width (%)",
      "min": 10,
      "max": 100,
      "step": 1,
      "default": 80
    },
    {
      "type": "range",
      "id": "safe_area_height",
      "label": "Safe area height (%)",
      "min": 10,
      "max": 100,
      "step": 1,
      "default": 80
    },
    {
      "type": "checkbox",
      "id": "block_outside_safe_area",
      "label": "Prevent add to cart when outside safe area",
      "default": true
    },
    {
      "type": "text",
      "id": "safe_area_warning",
      "label": "Safe area warning text",
      "default": "Can’t print up to the edge. Keep your design in the safe area."
    },
    {
      "type": "text",
      "id": "upload_warning",
      "label": "Upload warning text",
      "default": "Image file is too large for upload."
    },
    {
      "type": "range",
      "id": "max_upload_mb",
      "label": "Max upload size (MB)",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "Pricing adjustments"
    },
    {
      "type": "number",
      "id": "text_price_adjustment",
      "label": "Price add-on for text",
      "default": 0
    },
    {
      "type": "number",
      "id": "image_price_adjustment",
      "label": "Price add-on for image upload",
      "default": 0
    },
    {
      "type": "number",
      "id": "clipart_price_adjustment",
      "label": "Price add-on for clipart",
      "default": 0
    },
    {
      "type": "text",
      "id": "price_label",
      "label": "Price label",
      "default": "Live total"
    },
    {
      "type": "text",
      "id": "add_to_cart_label",
      "label": "Add to cart label",
      "default": "Add customized cover to cart"
    },
    {
      "type": "checkbox",
      "id": "include_preview_data",
      "label": "Include preview image in line item properties",
      "default": false
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "clipart",
      "name": "Clipart",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Clipart icon"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Cover Customizer",
      "category": "t:categories.products"
    }
  ]
}
{% endschema %}
