{%- doc -%}
  Custom add to cart button.

  @param {boolean} can_add_to_cart - Whether the product can be added to the cart.
  @param {string} add_to_cart_text - The text to display on the button.
  @param {object} product - The product object to be added to the cart.
  @param {boolean} [icon_only_on_mobile] - If true, only the icon is shown on mobile devices.
  @param {string} [class] - Additional CSS classes to apply to the button.
  @param {string} [id] - The ID attribute for the button.
  @param {string} [data_testid] - The data-testid attribute for testing.
{%- enddoc -%}

{%- liquid
  assign target_product = product
  if target_product == blank
    assign target_product = closest.product
  endif

  assign default_add_to_cart_text = 'actions.add_to_cart' | t
  assign button_text = add_to_cart_text | default: default_add_to_cart_text

  assign target_variant = blank
  assign target_variant_price = blank
  if target_product != blank
    assign target_variant = target_product.selected_or_first_available_variant
    assign target_variant_price = target_variant.price
  endif

  assign product_variant_media = ''
  if target_product != blank
    assign product_variant_media = target_product.selected_or_first_available_variant.featured_media.preview_image | image_url: width: 100
    if target_product.selected_or_first_available_variant.featured_media.preview_image == blank
      assign product_variant_media = target_product.featured_media.preview_image | image_url: width: 100
    endif
  endif

  assign cleaned_class = class | default: ''
  assign cleaned_class = cleaned_class | replace: 'add-to-cart-button', '' | strip
-%}

<div
  data-src="https://cdn.shopify.com/s/files/1/0621/6784/2913/files/Pop_Up.jpg?v=1775105880"
  data-fancybox="quantity-toolkit"
  class="quantity-selector-toolkit"
>
  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z" stroke="#1F1F1F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M12 8V12" stroke="#1F1F1F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M12 16H12.01" stroke="#1F1F1F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
  <p>Add more to save more</p>
</div>

<div class="mobile-add-to-cart-sticky">
  <div class="custom mobile-sticky-price">
    {% if target_variant_price != blank %}
      {{ target_variant_price | money }}
    {% endif %}
    <div class="bryan quantity-selector-container">
    {% render 'quantity-selector', product: target_product %}
  </div>
  </div>

  

  <add-to-cart-component
    ref="addToCartButtonContainer"
    data-product-variant-media="{{ product_variant_media }}"
    data-add-to-cart-animation="{{ settings.add_to_cart_animation }}"
  >
    <button
      {% if id != blank %}
        id="{{ id }}"
      {% endif %}
      type="submit"
      name="add"
      ref="addToCartButton"
      on:click="/handleClick"
      class="button custom-add-to-cart-button{% if cleaned_class != blank %} {{ cleaned_class }}{% endif %}"
      {% if data_testid %}
        data-testid="{{ data_testid }}"
      {% endif %}
      {% unless can_add_to_cart %}
        disabled
      {% endunless %}
    >
      <span class="add-to-cart-text">

        <span class="custom add-to-cart-text__content{% if icon_only_on_mobile %} is-visually-hidden-mobile{% endif %}">
          <span>
            <span>Add to Cart</span>
          </span>
        </span>
      </span>

      <span class="add-to-cart__added">
        <span class="svg-wrapper add-to-cart__added-icon">
          {{- 'icon-checkmark-burst.svg' | inline_asset_content -}}
        </span>
      </span>
    </button>
  </add-to-cart-component>
</div>

{% stylesheet %}
.product-form-buttons.spacing-style.product-form-buttons--stacked {
    display: flex;
}
  .quantity-selector-toolkit {
    display: flex;
    align-items: center;
    gap: 5px;
    justify-content: center;
  }

  .mobile-add-to-cart-sticky {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 15px;
}

.custom.mobile-sticky-price {
    display: flex;
    align-items: center;
    font-size: 16px;
    gap: 10px;
}
span.custom.add-to-cart-text__content {
    font-family: Lato;
font-size: 16px;
}
 button#custom-mobile-add-to-cart {
    height: 0;
    min-height: 0;
    padding: 15px;
} 
.custom.mobile-sticky-price quantity-selector-component.quantity-selector{
        height: 0;
    padding: 20px 0;
}
{% endstylesheet %}