{%- liquid
  assign diameter_value = diameter_value | default: value | strip
  assign diameter_class = class | default: 'custom-diameter-meta'
-%}
{%- if diameter_value != blank -%}
  {%- capture diameter_display -%}
    {%- render 'custom-diameter-format', value: diameter_value -%}
  {%- endcapture -%}
  {%- assign diameter_display = diameter_display | strip -%}
{%- endif -%}
{%- if diameter_display != blank -%}
  <div class="{{ diameter_class }}">
    <span class="custom-diameter-meta__label">Diameter</span>
    <span class="custom-diameter-meta__icon" aria-hidden="true">
      {{- 'custom-icon-diameter-meta.svg' | inline_asset_content -}}
    </span>
    <span class="custom-diameter-meta__value">{{ diameter_display | escape }}</span>
  </div>
{%- endif -%}

{% stylesheet %}
  .custom-diameter-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #5f5f5f;
    font-family: Lato, sans-serif;
    font-size: 14px;
    line-height: 18px;
  }

  .custom-diameter-meta__label,
  .custom-diameter-meta__value {
    color: inherit;
    font: inherit;
  }

  .custom-diameter-meta__icon {
    display: inline-flex;
    width: 18px;
    height: 18px;
    flex: 0 0 18px;
  }

  .custom-diameter-meta__icon svg {
    display: block;
    width: 18px;
    height: 18px;
  }
{% endstylesheet %}
