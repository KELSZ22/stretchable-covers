{%- doc -%}
  Renders a default variant picker, used to display the variant picker in the variants block.

  @param {object} product_resource - The product object.
  @param {object} [block] - The block object
{%- enddoc -%}

{% assign block_settings = block.settings %}

{% assign has_size_option = false %}
{% if product_resource.options_with_values.size > 0 %}
  {% assign has_size_option = true %}
{% endif %}

{% unless product_resource.has_only_default_variant %}
  {% liquid
    assign button_background_brightness = section.settings.color_scheme.settings.foreground | color_brightness
    if button_background_brightness < 105
      assign strikethrough_color_mix = '#000'
    else
      assign strikethrough_color_mix = '#fff'
    endif

    assign size_guide_modal_id = 'SizingGuideModal-' | append: section.id | append: '-' | append: block.id | append: '-' | append: product_resource.id
    assign size_guide_title_id = 'SizingGuideTitle-' | append: section.id | append: '-' | append: block.id | append: '-' | append: product_resource.id
  %}

  <variant-picker
    class="variant-picker spacing-style variant-picker--{{ block_settings.alignment }}"
    style="--color-strikethrough-mix: {{ strikethrough_color_mix }}; {% render 'spacing-style', settings: block_settings %}"
    data-section-id="{{ section.id }}"
    data-product-id="{{ product_resource.id }}"
    data-block-id="{{ block.id }}"
    data-product-url="{{ product_resource.url }}"
    ref="mainVariantPicker"
    {% if product.id == product_resource.id %}
      data-template-product-match="true"
    {% endif %}
    {{ block.shopify_attributes }}
    {% if request.visual_preview_mode %}
      data-shopify-visual-preview
    {% endif %}
  >
    <form class="variant-picker__form{% if product_resource.options_with_values.size == 1 %} variant-picker__form--single-option{% endif %}">
      {%- liquid
        assign imprint_option_index = -1
        assign imprint_size_option_index = -1

        for product_option in product_resource.options_with_values
          assign option_name_lc = product_option.name | downcase | strip

          if option_name_lc == 'imprint'
            assign imprint_option_index = forloop.index0
          elsif option_name_lc == 'imprint size'
            assign imprint_size_option_index = forloop.index0
          endif
        endfor

        assign has_imprint_group = false
        assign imprint_group_first_index = -1
        assign imprint_group_last_index = -1

        if imprint_option_index >= 0 or imprint_size_option_index >= 0
          assign has_imprint_group = true
          assign imprint_group_first_index = imprint_option_index
          assign imprint_group_last_index = imprint_size_option_index

          if imprint_option_index < 0
            assign imprint_group_first_index = imprint_size_option_index
            assign imprint_group_last_index = imprint_size_option_index
          elsif imprint_size_option_index < 0
            assign imprint_group_last_index = imprint_option_index
          elsif imprint_option_index < imprint_size_option_index
            assign imprint_group_first_index = imprint_option_index
            assign imprint_group_last_index = imprint_size_option_index
          else
            assign imprint_group_first_index = imprint_size_option_index
            assign imprint_group_last_index = imprint_option_index
          endif
        endif
      -%}

      {%- for product_option in product_resource.options_with_values -%}
        {%- liquid
          assign swatch_count = product_option.values | map: 'swatch' | compact | size
          assign variant_style = block_settings.variant_style
          assign option_id_attribute = blank
          assign fieldset_id = blank
          assign longest_value = 0

          assign product_option_name_downcase = product_option.name | downcase | strip
          assign is_color_option = false
          assign is_imprint_option = false
          assign is_imprint_size_option = false
          assign open_imprint_group = false
          assign close_imprint_group = false

          if product_option_name_downcase == 'color'
            assign is_color_option = true
          endif

          if product_option_name_downcase == 'imprint'
            assign is_imprint_option = true
            assign variant_style = 'buttons'
          elsif product_option_name_downcase == 'imprint size'
            assign is_imprint_size_option = true
          endif

          if has_imprint_group
            if forloop.index0 == imprint_group_first_index
              assign open_imprint_group = true
            endif

            if forloop.index0 == imprint_group_last_index
              assign close_imprint_group = true
            endif
          endif

          if swatch_count > 0 and block_settings.show_swatches and is_imprint_option == false
            if block_settings.variant_style == 'dropdown'
              assign variant_style = 'swatch_dropdown'
            else
              assign variant_style = 'swatch'
            endif
          endif

          unless is_imprint_option
            if variant_style == 'buttons' and settings.variant_button_width == 'equal-width-buttons'
              assign fieldset_id = section.id | append: '-' | append: product_resource.id | append: '-' | append: product_option.name | handleize
              assign option_id_attribute = 'data-option-id="' | append: fieldset_id | append: '"'
            endif
          endunless

          assign show_sizing_guide = false
          assign guide_display_type = blank

          if product_option_name_downcase == 'imprint'
            assign show_sizing_guide = true
            assign guide_display_type = 'icon'
          elsif forloop.index == 1 and product_resource.options_with_values.size > 1
            assign show_sizing_guide = true
            assign guide_display_type = 'icon'
          elsif forloop.index == 2 and product_option_name_downcase != 'imprint size'
            assign show_sizing_guide = true
            assign guide_display_type = 'text'
          endif
        -%}

        {%- if open_imprint_group -%}
          <div class="variant-imprint-group">
        {%- endif -%}

        {%- if is_color_option and product_resource.options_with_values.size > 1 -%}
          {%- assign fieldset_index = forloop.index0 -%}

          <fieldset
            class="variant-option variant-option--color-swatches"
            data-fieldset-index="{{ fieldset_index }}"
            ref="fieldsets[]"
          >
            <legend class="variant-color-swatch__legend">
              <span>{{ product_option.name | escape }}:</span>
              <strong data-color-swatch-selected>{{ product_option.selected_value }}</strong>
            </legend>

            <div class="variant-color-swatch__list">
              {%- for product_option_value in product_option.values -%}
                {%- liquid
                  assign swatch_name = product_option_value | downcase | strip
                  assign swatch_color = '#cccccc'

                  case swatch_name
                    when 'safety orange'
                      assign swatch_color = '#ff8500'
                    when 'safety yellow'
                      assign swatch_color = '#f4e600'
                    when 'white'
                      assign swatch_color = '#ffffff'
                    when 'black'
                      assign swatch_color = '#000000'
                    when 'red'
                      assign swatch_color = '#ff0000'
                    when 'blue'
                      assign swatch_color = '#0057ff'
                    when 'green'
                      assign swatch_color = '#008000'
                    when 'gray'
                      assign swatch_color = '#808080'
                    when 'grey'
                      assign swatch_color = '#808080'
                  endcase
                -%}

                <label
                  class="variant-color-swatch{% if product_option_value.available == false %} variant-color-swatch--unavailable{% endif %}"
                  title="{{ product_option_value | escape }}"
                  aria-label="{{ product_option_value | escape }}"
                >
                  <input
                    class="variant-color-swatch__input"
                    type="radio"
                    name="{{ product_option.name | escape }}-{{ block.id }}-{{ product_resource.id }}"
                    value="{{ product_option_value | escape }}"
                    aria-label="{{ product_option_value.name }}"
                    {% if product_option_value.available == false %}
                      aria-disabled="true"
                    {% endif %}
                    data-previous-checked="false"
                    data-fieldset-index="{{ fieldset_index }}"
                    data-input-index="{{ forloop.index0 }}"
                    data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
                    data-option-value-id="{{ product_option_value.id }}"
                    data-option-available="{{ product_option_value.available }}"
                    data-connected-product-url="{{ product_option_value.product_url }}"
                    {% if product_option_value.variant.id %}
                      data-variant-id="{{ product_option_value.variant.id }}"
                    {% endif %}
                    {% if product_option_value.selected %}
                      data-current-checked="true"
                      checked
                    {% else %}
                      data-current-checked="false"
                    {% endif %}
                  >

                  <span
                    class="variant-color-swatch__circle"
                    style="--variant-color-swatch-bg: {{ swatch_color }};"
                  ></span>

                  <span class="variant-color-swatch__text">
                    {{- product_option_value | escape -}}
                  </span>

                  {% render 'strikethrough-variant', product_option: product_option_value %}
                </label>
              {%- endfor -%}
            </div>
          </fieldset>

        {%- elsif product_resource.options_with_values.size == 1 -%}
          <div class="variant-option variant-option--text-mode">
            <div class="varian-option-container varian-option-container--single">
              <label for="OptionText-{{ block.id }}-{{ forloop.index0 }}">
                {{ product_option.name | escape }}
              </label>
            </div>

            <div class="variant-option__text-input-wrapper">
              <input
                id="OptionText-{{ block.id }}-{{ forloop.index0 }}"
                type="text"
                class="variant-option__text-input"
                name="properties[Diameter]"
                value=""
                placeholder="{{ product_option.selected_value | escape }}"
                autocomplete="off"
                inputmode="decimal"
                pattern="[0-9.]*"
                data-number-only-input
                data-line-item-property-input
              >
            </div>
          </div>

        {%- elsif is_imprint_option or variant_style == 'swatch' or block_settings.variant_style == 'buttons' -%}
          {%- assign fieldset_index = forloop.index0 -%}

          <fieldset
            class="variant-option variant-option--buttons{% if is_imprint_option %} variant-option--imprint-tabs{% elsif variant_style == 'swatch' %} variant-option--swatches{% else %} variant-option--{{ settings.variant_button_width }}{% endif %}"
            data-fieldset-index="{{ fieldset_index }}"
            ref="fieldsets[]"
            {{ option_id_attribute }}
          >
            {%- if is_imprint_option -%}
              <legend class="variant-imprint-tabs__legend">
                <span class="variant-imprint-tabs__legend-label">{{ product_option.name | escape }}</span>

                {%- if show_sizing_guide -%}
                  <button
                    type="button"
                    class="variant-option__size-guide variant-option__size-guide--{{ guide_display_type }}"
                    data-size-guide-open
                    aria-haspopup="dialog"
                    aria-controls="{{ size_guide_modal_id }}"
                    aria-label="Important printing note"
                  >
                    {% if guide_display_type == 'icon' %}
                      <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 19 19" fill="none">
                        <path d="M9.08333 17.4167C13.6857 17.4167 17.4167 13.6857 17.4167 9.08333C17.4167 4.48096 13.6857 0.75 9.08333 0.75C4.48096 0.75 0.75 4.48096 0.75 9.08333C0.75 13.6857 4.48096 17.4167 9.08333 17.4167Z" stroke="#5F5F5F" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M6.75024 7.4204C6.94616 6.86345 7.33287 6.39382 7.84187 6.09467C8.35087 5.79553 8.94932 5.68618 9.53122 5.78599C10.1131 5.8858 10.6409 6.18833 11.0211 6.64C11.4014 7.09167 11.6095 7.66333 11.6086 8.25373C11.6086 9.9204 9.10858 10.7537 9.10858 10.7537" stroke="#5F5F5F" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M9.08333 13.75H9.09166" stroke="#5F5F5F" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    {% endif %}
                  </button>
                {%- endif -%}
              </legend>

              <div
                class="variant-imprint-tabs__list"
                role="radiogroup"
                aria-label="{{ product_option.name | escape }}"
              >
            {%- else -%}
              <legend>
                {{ product_option.name | escape -}}
                {%- if variant_style == 'swatch' -%}
                  <span class="variant-option__swatch-value">{{ product_option.selected_value }}</span>
                {%- endif %}
              </legend>
            {%- endif -%}

            {%- for product_option_value in product_option.values -%}
              {% if product_option_value.size > longest_value and option_id_attribute %}
                {% assign longest_value = product_option_value.size %}
              {% endif %}

              <label
                class="{% if is_imprint_option %}variant-imprint-tab{% else %}variant-option__button-label{% endif %}{% if variant_style == 'swatch' %} variant-option__button-label--has-swatch{% endif %}"
              >
                <input
                  type="radio"
                  name="{{ product_option.name | escape }}-{{ block.id }}-{{ product_resource.id }}"
                  value="{{ product_option_value | escape }}"
                  aria-label="{{ product_option_value.name }}"
                  {% if product_option_value.available == false %}
                    aria-disabled="true"
                  {% endif %}
                  data-previous-checked="false"
                  data-fieldset-index="{{ fieldset_index }}"
                  data-input-index="{{ forloop.index0 }}"
                  data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
                  data-option-value-id="{{ product_option_value.id }}"
                  data-option-available="{{ product_option_value.available }}"
                  data-connected-product-url="{{ product_option_value.product_url }}"
                  {% if product_option_value.variant.id %}
                    data-variant-id="{{ product_option_value.variant.id }}"
                  {% endif %}
                  {% if product_option_value.selected %}
                    data-current-checked="true"
                    checked
                  {% else %}
                    data-current-checked="false"
                  {% endif %}
                >

                {% if variant_style == 'swatch' %}
                  {% liquid
                    assign featured_media = product_option_value.variant.featured_media

                    if featured_media == blank and product_option_value.product_url
                      assign featured_media = product_option_value.variant.product.featured_media
                    endif
                  %}

                  {% render 'swatch',
                    swatch: product_option_value.swatch,
                    variant_image: featured_media,
                    mode: 'unscaled'
                  %}
                {% else %}
                  {% unless is_imprint_option %}
                    {% if product_option_value.available == true %}
                      <span
                        class="variant-option__button-label__pill"
                        data-key="variant-option-pill"
                      ></span>
                    {% endif %}
                  {% endunless %}

                  <span
                    class="variant-option__button-label__text"
                    data-key="variant-option-text"
                  >
                    {{- product_option_value | escape -}}
                  </span>
                {% endif %}

                {% render 'strikethrough-variant', product_option: product_option_value %}
              </label>
            {%- endfor -%}

            {%- if is_imprint_option -%}
              </div>
            {%- endif -%}

            {% if option_id_attribute %}
              {% style %}
                [data-option-id="{{ fieldset_id }}"] {
                  --variant-ch: {{ longest_value | times: 0.65 }}em;
                }
              {% endstyle %}
            {% endif %}
          </fieldset>

        {%- elsif block_settings.variant_style == 'dropdowns' -%}
          {% liquid
            assign property_being_updated = false
            if settings.variant_swatch_width != settings.variant_swatch_height
              assign property_being_updated = true
              assign new_width = settings.variant_swatch_width | times: 1.0 | divided_by: settings.variant_swatch_height | times: 20
            endif
          %}

          <div class="variant-option variant-option--dropdowns{% if is_imprint_size_option %} variant-option--imprint-size{% endif %}">
            <div class="varian-option-container">
              <label for="Option-{{ block.id }}-{{ forloop.index0 }}">
                {{ product_option.name | escape }}
              </label>

              {% unless is_imprint_size_option %}
                {% if show_sizing_guide %}
                  <button
                    type="button"
                    class="variant-option__size-guide variant-option__size-guide--{{ guide_display_type }}"
                    data-size-guide-open
                    aria-haspopup="dialog"
                    aria-controls="{{ size_guide_modal_id }}"
                    aria-label="Sizing guide"
                  >
                    {% if guide_display_type == 'icon' %}
                      <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 19 19" fill="none">
                        <path d="M9.08333 17.4167C13.6857 17.4167 17.4167 13.6857 17.4167 9.08333C17.4167 4.48096 13.6857 0.75 9.08333 0.75C4.48096 0.75 0.75 4.48096 0.75 9.08333C0.75 13.6857 4.48096 17.4167 9.08333 17.4167Z" stroke="#5F5F5F" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M6.75024 7.4204C6.94616 6.86345 7.33287 6.39382 7.84187 6.09467C8.35087 5.79553 8.94932 5.68618 9.53122 5.78599C10.1131 5.8858 10.6409 6.18833 11.0211 6.64C11.4014 7.09167 11.6095 7.66333 11.6086 8.25373C11.6086 9.9204 9.10858 10.7537 9.10858 10.7537" stroke="#5F5F5F" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M9.08333 13.75H9.09166" stroke="#5F5F5F" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    {% elsif guide_display_type == 'text' %}
                      Sizing guide
                    {% endif %}
                  </button>
                {% endif %}
              {% endunless %}
            </div>

            <div
              class="variant-option__select-wrapper"
              style="
                {%- if property_being_updated -%}
                  --variant-picker-swatch-width: clamp(10px,{{ new_width }}px, 50px);
                {%- endif -%}
              "
            >
              <select
                id="Option-{{ block.id }}-{{ forloop.index0 }}"
                name="options[{{ product_option.name | escape }}]"
                class="variant-option__select{% if is_imprint_size_option %} variant-option__select--imprint-size{% endif %}"
                {% if is_imprint_size_option %}
                  data-imprint-size-select
                {% endif %}
              >
                {%- if is_imprint_size_option -%}
                  <option
                    value=""
                    disabled
                    selected
                    data-imprint-size-placeholder
                  >
                    Select imprint size
                  </option>
                  <option value="-----" disabled data-imprint-size-dash>-----</option>
                {%- endif -%}
                {%- for product_option_value in product_option.values -%}
                  <option
                    value="{{ product_option_value | escape }}"
                    data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
                    data-option-value-id="{{ product_option_value.id }}"
                    data-variant-id="{{ product_option_value.variant.id }}"
                    data-connected-product-url="{{ product_option_value.product_url }}"
                    {% if product_option_value.selected and is_imprint_size_option == false %}
                      selected="selected"
                    {% endif %}
                  >
                    {% if product_option_value.available == false %}
                      {{ product_option_value | escape }} - {{ 'content.unavailable' | t }}
                    {% else %}
                      {{ product_option_value | escape }}
                    {% endif %}
                  </option>
                {%- endfor -%}
              </select>

              <svg
                aria-hidden="true"
                focusable="false"
                class="icon icon-caret"
                viewBox="0 0 10 6"
              >
                {%- render 'icon', icon: 'caret' -%}
              </svg>
            </div>
          </div>
        {%- endif -%}

        {%- if close_imprint_group -%}
          </div>
        {%- endif -%}
      {%- endfor -%}

      <script type="application/json">
        {{ product_resource.selected_or_first_available_variant | json }}
      </script>

      <script type="application/json" data-custom-variants-json>
        {{ product_resource.variants | json }}
      </script>
    </form>

    {% if has_size_option %}
      <div
        id="{{ size_guide_modal_id }}"
        class="variant-size-guide-modal"
        aria-hidden="true"
      >
        <div class="variant-size-guide-modal__overlay" data-size-guide-close></div>

        <div
          class="variant-size-guide-modal__dialog"
          role="dialog"
          aria-modal="true"
          aria-labelledby="{{ size_guide_title_id }}"
        >
          <button
            type="button"
            class="variant-size-guide-modal__close"
            aria-label="Close sizing guide"
            data-size-guide-close
          >
            &times;
          </button>

          <div class="variant-size-guide-modal__content variant-size-guide-modal__content--printing-note">
            <h3 id="{{ size_guide_title_id }}" class="variant-size-guide-modal__title">
              Important Printing Note!
            </h3>

            <div class="variant-size-guide-modal__body variant-size-guide-modal__body--printing-note">
              <p class="variant-size-guide-modal__intro">
                <strong>(Kindly Read all the notes before proceeding.)</strong>
              </p>

              <ol class="variant-size-guide-modal__list">
                <li>
                  Sublimation imprinting does not allow for white imprints on colors.
                </li>

                <li>
                  IF your design requires white, please order WHITE COVERS ONLY.
                </li>

                <li>
                  Please keep in mind that colors printed on material other than white, may mix to change the final printed color. Since we cannot print white we cannot produce a white underlay to keep colors from mixing together.
                </li>
              </ol>

              <p class="variant-size-guide-modal__example">
                <em>(Example: blue on safety yellow may appear more green.)</em>
              </p>

              <ol class="variant-size-guide-modal__list" start="4">
                <li>
                  Maximum imprint size is 19" in diameter for all cover sizes. (We are sourcing new equipment for larger imprints in the near future.)
                </li>

                <li>
                  Safety Orange Covers work best with dark imprint colors like black or navy blue.
                </li>
              </ol>
            </div>
          </div>
        </div>
      </div>
    {% endif %}
  </variant-picker>

  <script>
    if (!window.variantColorSwatchesInit) {
      window.variantColorSwatchesInit = true;

      function updateColorSwatchText(fieldset) {
        if (!fieldset) return;

        var selectedText = fieldset.querySelector('[data-color-swatch-selected]');
        var checkedInput = fieldset.querySelector('.variant-color-swatch__input:checked');

        if (selectedText && checkedInput) {
          selectedText.textContent = checkedInput.value;
        }
      }

      function updateAllColorSwatchTexts() {
        document.querySelectorAll('.variant-option--color-swatches').forEach(function(fieldset) {
          updateColorSwatchText(fieldset);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', updateAllColorSwatchTexts);
      } else {
        updateAllColorSwatchTexts();
      }

      document.addEventListener('shopify:section:load', function () {
        updateAllColorSwatchTexts();
      });

      document.addEventListener('change', function(event) {
        var input = event.target.closest('.variant-color-swatch__input');

        if (!input) return;

        var fieldset = input.closest('.variant-option--color-swatches');
        updateColorSwatchText(fieldset);
      });
    }
  </script>

  <script>
    if (!window.variantSizeGuideModalInit) {
      window.variantSizeGuideModalInit = true;

      function moveModalToBody(modal) {
        if (!modal || modal.dataset.movedToBody === 'true') return;
        document.body.appendChild(modal);
        modal.dataset.movedToBody = 'true';
      }

      function openSizeGuideModal(modal, triggerButton) {
        if (!modal) return;

        moveModalToBody(modal);

        modal.classList.add('is-active');
        modal.setAttribute('aria-hidden', 'false');
        modal._triggerButton = triggerButton || null;
        document.body.classList.add('variant-size-guide-modal-open');

        var closeButton = modal.querySelector('.variant-size-guide-modal__close');
        if (closeButton) {
          closeButton.focus();
        }
      }

      function closeSizeGuideModal(modal) {
        if (!modal) return;

        modal.classList.remove('is-active');
        modal.setAttribute('aria-hidden', 'true');

        if (!document.querySelector('.variant-size-guide-modal.is-active')) {
          document.body.classList.remove('variant-size-guide-modal-open');
        }

        if (modal._triggerButton) {
          modal._triggerButton.focus();
        }
      }

      function prepareAllSizeGuideModals() {
        document.querySelectorAll('.variant-size-guide-modal').forEach(function(modal) {
          moveModalToBody(modal);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', prepareAllSizeGuideModals);
      } else {
        prepareAllSizeGuideModals();
      }

      document.addEventListener('shopify:section:load', function () {
        prepareAllSizeGuideModals();
      });

      document.addEventListener('click', function (event) {
        var openButton = event.target.closest('[data-size-guide-open]');
        if (openButton) {
          event.preventDefault();

          var modalId = openButton.getAttribute('aria-controls');
          var modal = modalId ? document.getElementById(modalId) : null;

          openSizeGuideModal(modal, openButton);
          return;
        }

        var closeButton = event.target.closest('[data-size-guide-close]');
        if (closeButton) {
          event.preventDefault();

          var modal = closeButton.closest('.variant-size-guide-modal');
          closeSizeGuideModal(modal);
        }
      });

      document.addEventListener('keydown', function (event) {
        if (event.key !== 'Escape') return;

        var activeModal = document.querySelector('.variant-size-guide-modal.is-active');
        if (activeModal) {
          closeSizeGuideModal(activeModal);
        }
      });
    }
  </script>

  <script>
    if (!window.customVariantPickerCartFixInit) {
      window.customVariantPickerCartFixInit = true;

      function cleanDiameterValue(value) {
        value = String(value || '')
          .replace(/[^0-9.]/g, '')
          .replace(/(\..*)\./g, '$1')
          .trim();

        return value;
      }

      function escapeCssValue(value) {
        if (window.CSS && typeof window.CSS.escape === 'function') {
          return window.CSS.escape(String(value || ''));
        }

        return String(value || '').replace(/\\/g, '\\\\').replace(/\"/g, '\\\"');
      }

      function findProductFormFromElement(element) {
        var picker = element && element.closest ? element.closest('variant-picker') : null;
        var sectionId = picker ? picker.getAttribute('data-section-id') : null;
        var section;
        var form;

        if (sectionId) {
          section = document.getElementById('shopify-section-' + sectionId);

          if (section) {
            form = section.querySelector('form[action*="/cart/add"]');
            if (form) return form;
          }
        }

        section = element && element.closest
          ? element.closest('section, .shopify-section, [data-section-id], product-info, .product')
          : null;

        if (section) {
          form = section.querySelector('form[action*="/cart/add"]');
          if (form) return form;
        }

        return document.querySelector('form[action*="/cart/add"]');
      }

      function getLinkedDiameterInput(form, input) {
        var key = input && input.id ? input.id : 'custom-diameter';
        var hiddenInput = form.querySelector('input[data-custom-diameter-line-item="' + escapeCssValue(key) + '"]');

        if (!hiddenInput) {
          hiddenInput = document.createElement('input');
          hiddenInput.type = 'hidden';
          hiddenInput.setAttribute('data-custom-diameter-line-item', key);
          form.appendChild(hiddenInput);
        }

        hiddenInput.name = 'properties[Diameter]';

        return hiddenInput;
      }

      function syncDiameterInput(input) {
        var form;
        var value;
        var hiddenInput;

        if (!input) return '';

        form = findProductFormFromElement(input);
        value = cleanDiameterValue(input.value);

        input.value = value;

        if (!form) return value;

        hiddenInput = getLinkedDiameterInput(form, input);

        if (value && value !== '0') {
          var formattedValue = value;

          if (window.CustomDiameterFormat && typeof window.CustomDiameterFormat.formatDiameterDisplay === 'function') {
            formattedValue = window.CustomDiameterFormat.formatDiameterDisplay(value);
          } else {
            formattedValue = value + "'";
          }

          hiddenInput.value = formattedValue;
          input.dataset.lastValidDiameter = value;
          return formattedValue;
        }

        hiddenInput.remove();
        delete input.dataset.lastValidDiameter;

        return '';
      }

      function syncDiameterInputsInScope(scope) {
        scope = scope || document;

        scope.querySelectorAll('[data-line-item-property-input]').forEach(function(input) {
          syncDiameterInput(input);
        });
      }

      function getPickerVariants(picker) {
        var json = picker ? picker.querySelector('[data-custom-variants-json]') : null;

        if (!json) return [];

        try {
          return JSON.parse(json.textContent || '[]');
        } catch (error) {
          return [];
        }
      }

      function normalizeOption(value) {
        return String(value || '').trim();
      }

      function getImprintSizeOptionIndex(picker) {
        var pickerForm = picker ? picker.querySelector('.variant-picker__form') : null;
        var sizeIndex = -1;

        if (!pickerForm) return sizeIndex;

        Array.prototype.slice.call(pickerForm.children).forEach(function(optionEl, index) {
          if (optionEl.querySelector('[data-imprint-size-select]')) {
            sizeIndex = index;
          }
        });

        return sizeIndex;
      }

      function isImprintSizeDashSelected(select) {
        if (!select) return false;

        var option = select.options[select.selectedIndex];

        return Boolean(option && option.hasAttribute('data-imprint-size-dash'));
      }

      function getPickerOptionValues(picker) {
        var pickerForm = picker ? picker.querySelector('.variant-picker__form') : null;
        var values = [];

        if (!pickerForm) return values;

        Array.prototype.slice.call(pickerForm.children).forEach(function(optionEl, index) {
          var select;
          var checked;
          var selectedOption;

          if (!optionEl.classList || !optionEl.classList.contains('variant-option')) return;

          select = optionEl.querySelector('select');
          checked = optionEl.querySelector('input[type="radio"]:checked');

          if (select) {
            selectedOption = select.options[select.selectedIndex];

            if (selectedOption && selectedOption.hasAttribute('data-imprint-size-dash')) {
              values[index] = undefined;
            } else {
              values[index] = select.value;
            }
          } else if (checked) {
            values[index] = checked.value;
          }
        });

        return values;
      }

      function findMatchingVariant(picker) {
        var variants = getPickerVariants(picker);
        var selectedOptions = getPickerOptionValues(picker);
        var sizeIndex = getImprintSizeOptionIndex(picker);
        var ignoreImprintSize = !imprintTypeRequiresSize(getSelectedImprintType(picker)) && sizeIndex >= 0;

        if (!variants.length || !selectedOptions.length) return null;

        return variants.find(function(variant) {
          if (!variant || !Array.isArray(variant.options)) return false;

          return selectedOptions.every(function(value, index) {
            if (ignoreImprintSize && index === sizeIndex) return true;

            if (value === undefined || value === null || value === '') return true;

            return normalizeOption(variant.options[index]) === normalizeOption(value);
          });
        }) || null;
      }

      function updateSelectedVariantIdForCart(picker) {
        var variant = findMatchingVariant(picker);
        var form = findProductFormFromElement(picker);
        var idInput;

        if (!variant || !variant.id || !form) return '';

        idInput = form.querySelector('[name="id"]');

        if (!idInput) {
          idInput = document.createElement('input');
          idInput.type = 'hidden';
          idInput.name = 'id';
          form.appendChild(idInput);
        }

        idInput.value = variant.id;
        picker.dataset.currentVariantId = variant.id;

        idInput.dispatchEvent(new Event('change', { bubbles: true }));

        return String(variant.id);
      }

      function imprintTypeRequiresSize(imprintType) {
        var value = String(imprintType || '').toLowerCase().trim();

        if (!value || value.indexOf('no imprint') !== -1) return false;

        return value.indexOf('full cover') !== -1 || value.indexOf('standard cover') !== -1;
      }

      function getImprintSizeSelect(picker) {
        return picker ? picker.querySelector('[data-imprint-size-select]') : null;
      }

      function getSelectedImprintType(picker) {
        var input = picker ? picker.querySelector('.variant-imprint-tab input[type="radio"]:checked') : null;

        return input ? input.value : '';
      }

      function ensureImprintSizePlaceholder(select) {
        if (!select) return null;

        var placeholder = select.querySelector('[data-imprint-size-placeholder]');

        if (!placeholder) {
          placeholder = document.createElement('option');
          placeholder.value = '';
          placeholder.disabled = true;
          placeholder.setAttribute('data-imprint-size-placeholder', '');
          placeholder.textContent = 'Select imprint size';
          select.insertBefore(placeholder, select.firstChild);
        }

        return placeholder;
      }

      function ensureImprintSizeDashOption(select) {
        if (!select) return null;

        var dashOption = select.querySelector('[data-imprint-size-dash]');

        if (!dashOption) {
          dashOption = document.createElement('option');
          dashOption.value = '-----';
          dashOption.disabled = true;
          dashOption.setAttribute('data-imprint-size-dash', '');
          dashOption.textContent = '-----';
          select.appendChild(dashOption);
        }

        return dashOption;
      }

      function isImprintSizePlaceholderSelected(select) {
        if (!select) return true;

        var option = select.options[select.selectedIndex];

        if (!option) return true;

        if (option.hasAttribute('data-imprint-size-dash')) return false;

        return option.hasAttribute('data-imprint-size-placeholder') || !String(option.value || '').trim();
      }

      function resetImprintSizeToPlaceholder(picker) {
        var select = getImprintSizeSelect(picker);
        var placeholder;

        if (!select) return;

        placeholder = ensureImprintSizePlaceholder(select);
        select.value = '';

        if (placeholder) {
          placeholder.selected = true;
        }
      }

      var IMPRINT_SIZE_ALERT_MESSAGE = 'Please select an imprint size first.';

      function isImprintAddToCartBlocked(picker) {
        if (!getImprintSizeSelect(picker)) return false;

        if (!imprintTypeRequiresSize(getSelectedImprintType(picker))) return false;

        return isImprintSizePlaceholderSelected(getImprintSizeSelect(picker));
      }

      function updateImprintSizeInlineAlert(picker, show) {
        var select = getImprintSizeSelect(picker);
        var optionRow;
        var alertEl;

        if (!select) return;

        optionRow = select.closest('.variant-option--imprint-size');
        if (!optionRow) return;

        alertEl = optionRow.querySelector('[data-imprint-size-alert]');

        if (!alertEl) {
          alertEl = document.createElement('p');
          alertEl.className = 'variant-imprint-size__alert';
          alertEl.setAttribute('data-imprint-size-alert', '');
          alertEl.setAttribute('role', 'alert');
          optionRow.appendChild(alertEl);
        }

        alertEl.textContent = IMPRINT_SIZE_ALERT_MESSAGE;
        alertEl.hidden = !show;

        select
          .closest('.variant-option__select-wrapper')
          ?.classList.toggle('variant-imprint-size__select-wrapper--error', show);
      }

      function notifyImprintSizeRequired(picker) {
        window.alert(IMPRINT_SIZE_ALERT_MESSAGE);

        var sizeSelect = getImprintSizeSelect(picker);
        if (sizeSelect) sizeSelect.focus();

        updateImprintSizeInlineAlert(picker, true);
      }

      function getAddToCartButtonsForPicker(picker) {
        var form = findProductFormFromElement(picker);
        var scope = form
          ? form.closest('section, .shopify-section, [data-section-id], product-info, .product')
          : null;
        var buttons = [];
        var seen = [];

        function addButton(button) {
          if (!button || seen.indexOf(button) !== -1) return;
          seen.push(button);
          buttons.push(button);
        }

        if (form) {
          form
            .querySelectorAll(
              'button[name="add"], [data-add-to-cart], .product-form__submit, add-to-cart-component button[type="submit"]'
            )
            .forEach(addButton);
        }

        if (scope) {
          scope
            .querySelectorAll('sticky-add-to-cart button, .sticky-add-to-cart__button')
            .forEach(addButton);
        }

        return buttons;
      }

      function updateImprintSizeFieldState(picker) {
        var select = getImprintSizeSelect(picker);
        var optionRow;
        var requiresSize = imprintTypeRequiresSize(getSelectedImprintType(picker));

        if (!select) return;

        optionRow = select.closest('.variant-option--imprint-size');

        select.disabled = !requiresSize;

        if (requiresSize) {
          select.removeAttribute('aria-disabled');
        } else {
          select.setAttribute('aria-disabled', 'true');
        }

        if (optionRow) {
          optionRow.classList.toggle('variant-option--imprint-size--disabled', !requiresSize);
        }

        if (!requiresSize) {
          updateImprintSizeInlineAlert(picker, false);
          select
            .closest('.variant-option__select-wrapper')
            ?.classList.remove('variant-imprint-size__select-wrapper--error');
          syncImprintSizeForNonRequiredType(picker);
        }
      }

      function syncImprintSizeForNonRequiredType(picker) {
        var select = getImprintSizeSelect(picker);
        var dashOption;

        if (!select || imprintTypeRequiresSize(getSelectedImprintType(picker))) return;

        dashOption = ensureImprintSizeDashOption(select);
        dashOption.selected = true;
        select.value = '-----';
      }

      function updateImprintAddToCartState(picker) {
        updateImprintSizeFieldState(picker);

        var blocked = isImprintAddToCartBlocked(picker);

        updateImprintSizeInlineAlert(picker, blocked);

        getAddToCartButtonsForPicker(picker).forEach(function(button) {
          if (blocked) {
            button.disabled = true;
            button.setAttribute('aria-disabled', 'true');
            button.dataset.imprintSizeRequired = 'true';
            return;
          }

          if (button.dataset.imprintSizeRequired === 'true') {
            button.disabled = false;
            button.removeAttribute('aria-disabled');
            delete button.dataset.imprintSizeRequired;
          }
        });
      }

      function restoreSavedImprintSize(picker) {
        var select = getImprintSizeSelect(picker);
        var savedSize = picker ? picker.dataset.lastImprintSize : '';
        var option;
        var index;

        if (!select || !savedSize) return false;

        for (index = 0; index < select.options.length; index += 1) {
          option = select.options[index];

          if (
            option.hasAttribute('data-imprint-size-placeholder') ||
            option.hasAttribute('data-imprint-size-dash')
          ) {
            continue;
          }

          if (option.value === savedSize) {
            select.selectedIndex = index;
            return true;
          }
        }

        return false;
      }

      function syncImprintPickerState(picker, options) {
        options = options || {};

        if (!picker || !getImprintSizeSelect(picker)) return;

        ensureImprintSizePlaceholder(getImprintSizeSelect(picker));

        updateImprintSizeFieldState(picker);

        if (imprintTypeRequiresSize(getSelectedImprintType(picker))) {
          if (options.resetSizeToPlaceholder) {
            delete picker.dataset.lastImprintSize;
            resetImprintSizeToPlaceholder(picker);
          } else {
            restoreSavedImprintSize(picker);
          }
        } else {
          syncImprintSizeForNonRequiredType(picker);
        }

        if (!isImprintAddToCartBlocked(picker)) {
          updateSelectedVariantIdForCart(picker);
        }

        updateImprintAddToCartState(picker);
      }

      function refreshImprintAddToCartButtons() {
        document.querySelectorAll('variant-picker').forEach(function(picker) {
          if (!getImprintSizeSelect(picker)) return;
          updateImprintAddToCartState(picker);
        });
      }

      function prepareVariantPicker(picker) {
        if (!picker) return;

        if (picker.dataset.customCartVariantFixReady !== 'true') {
          picker.dataset.customCartVariantFixReady = 'true';

          picker.updateSelectedVariantIdForCart = function() {
            return updateSelectedVariantIdForCart(picker);
          };

          syncImprintPickerState(picker, { resetSizeToPlaceholder: true });
          return;
        }

        updateImprintAddToCartState(picker);
      }

      function prepareAllVariantPickers() {
        document.querySelectorAll('variant-picker').forEach(prepareVariantPicker);
        refreshImprintAddToCartButtons();
      }

      function schedulePrepareAllVariantPickers() {
        prepareAllVariantPickers();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('readystatechange', function onReadyStateChange() {
          if (document.readyState === 'interactive' || document.readyState === 'complete') {
            document.removeEventListener('readystatechange', onReadyStateChange);
            schedulePrepareAllVariantPickers();
          }
        });
        document.addEventListener('DOMContentLoaded', schedulePrepareAllVariantPickers);
        window.addEventListener('load', refreshImprintAddToCartButtons);
      } else {
        schedulePrepareAllVariantPickers();
        refreshImprintAddToCartButtons();
      }

      document.addEventListener('shopify:section:load', function() {
        prepareAllVariantPickers();
        syncDiameterInputsInScope(document);
      });

      document.addEventListener('input', function(event) {
        var input = event.target.closest('[data-number-only-input][data-line-item-property-input]');
        if (!input) return;

        syncDiameterInput(input);
      }, true);

      document.addEventListener('change', function(event) {
        var diameterInput = event.target.closest('[data-number-only-input][data-line-item-property-input]');
        var picker = event.target.closest('variant-picker');
        var imprintTypeInput = event.target.closest('.variant-imprint-tab input[type="radio"]');
        var imprintSizeSelect = event.target.closest('[data-imprint-size-select]');

        if (diameterInput) {
          syncDiameterInput(diameterInput);
        }

        if (!picker) return;

        if (imprintTypeInput) {
          var requiresSize = imprintTypeRequiresSize(imprintTypeInput.value);

          if (requiresSize) {
            delete picker.dataset.lastImprintSize;
          }

          updateImprintAddToCartState(picker);

          syncImprintPickerState(picker, {
            resetSizeToPlaceholder: requiresSize,
          });
          return;
        }

        if (imprintSizeSelect) {
          if (imprintSizeSelect.value) {
            picker.dataset.lastImprintSize = imprintSizeSelect.value;
          } else {
            delete picker.dataset.lastImprintSize;
          }

          syncImprintPickerState(picker);
          return;
        }

        updateSelectedVariantIdForCart(picker);
        updateImprintAddToCartState(picker);
      }, true);

      document.addEventListener('variant:update', function() {
        document.querySelectorAll('variant-picker').forEach(function(picker) {
          if (!getImprintSizeSelect(picker)) return;

          syncImprintPickerState(picker);
        });

        refreshImprintAddToCartButtons();
      });

      ['pointerdown', 'mousedown', 'touchstart', 'click'].forEach(function(eventName) {
        document.addEventListener(eventName, function(event) {
          var button = event.target.closest('button[type="submit"], [name="add"], [data-add-to-cart], .product-form__submit');
          var form;
          var scope;
          var picker;

          if (!button) return;

          form = button.form || button.closest('form');
          if (!form || String(form.getAttribute('action') || '').indexOf('/cart/add') === -1) return;

          scope = form.closest('section, .shopify-section, [data-section-id], product-info, .product') || document;
          picker = scope.querySelector('variant-picker');

          if (picker) {
            if (isImprintAddToCartBlocked(picker)) {
              event.preventDefault();
              event.stopPropagation();

              if (eventName === 'click') {
                notifyImprintSizeRequired(picker);
              }

              return;
            }

            updateSelectedVariantIdForCart(picker);
          }

          syncDiameterInputsInScope(scope);
        }, true);
      });

      document.addEventListener('submit', function(event) {
        var form = event.target;
        var scope;
        var picker;

        if (!form || !form.matches('form[action*="/cart/add"]')) return;

        scope = form.closest('section, .shopify-section, [data-section-id], product-info, .product') || document;
        picker = scope.querySelector('variant-picker');

        if (picker && isImprintAddToCartBlocked(picker)) {
          event.preventDefault();
          event.stopPropagation();
          notifyImprintSizeRequired(picker);
          return;
        }

        if (picker) {
          updateSelectedVariantIdForCart(picker);
        }

        syncDiameterInputsInScope(scope);
      }, true);

      if (window.MutationObserver) {
        var imprintCartButtonObserverTimer;

        new MutationObserver(function() {
          window.clearTimeout(imprintCartButtonObserverTimer);
          imprintCartButtonObserverTimer = window.setTimeout(function() {
            document.querySelectorAll('variant-picker').forEach(function(picker) {
              if (picker.dataset.customCartVariantFixReady !== 'true') {
                prepareVariantPicker(picker);
              }
            });
            refreshImprintAddToCartButtons();
          }, 0);
        }).observe(document.documentElement, {
          childList: true,
          subtree: true
        });
      }
    }
  </script>
