    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .variant-size-guide-modal.is-active {
    display: flex;
  }

  .variant-size-guide-modal__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
  }

  .variant-size-guide-modal__dialog {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 790px;
    max-height: calc(100vh - 40px);
    overflow: auto;
    background: #ffffff;
    border-radius: 10px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.18);
  }

  .variant-size-guide-modal__close {
    position: absolute;
    top: 18px;
    right: 22px;
    width: 24px;
    height: 24px;
    border: 0;
    background: transparent;
    color: #1f1f1f;
    font-size: 30px;
    line-height: 1;
    cursor: pointer;
    z-index: 3;
  }

  .variant-size-guide-modal__content {
    padding: 38px 46px 34px;
  }

  .variant-size-guide-modal__content--printing-note {
    padding: 38px 46px 34px;
  }

  .variant-size-guide-modal__title {
    margin: 0 0 42px;
    color: #1f1f1f;
    text-align: center;
    font-family: Raleway, sans-serif;
    font-size: 20px;
    font-style: normal;
    font-weight: 800;
    line-height: 27px;
  }

  .variant-size-guide-modal__body {
    color: #1f1f1f;
    font-family: Lato, sans-serif;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: 18px;
  }

  .variant-size-guide-modal__body--printing-note {
    color: #1f1f1f;
    font-family: Lato, sans-serif;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: 18px;
  }

  .variant-size-guide-modal__intro {
    margin: 0 0 16px;
    color: #1f1f1f;
    font-family: Lato, sans-serif;
    font-size: 16px;
    font-style: normal;
    font-weight: 700;
    line-height: 24px;
  }

  .variant-size-guide-modal__intro strong {
    font: inherit;
    color: inherit;
  }

  .variant-size-guide-modal__list {
    margin: 0;
    padding-left: 20px;
    color: #1f1f1f;
    font-family: Lato, sans-serif;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: 18px;
  }

  .variant-size-guide-modal__list li {
    margin: 0 0 8px;
    padding-left: 0;
  }

  .variant-size-guide-modal__example {
    margin: 0 0 8px;
    color: #1f1f1f;
    font-family: Lato, sans-serif;
    font-size: 14px;
    font-style: italic;
    font-weight: 700;
    line-height: 18px;
  }

  .variant-size-guide-modal__body p:last-child,
  .variant-size-guide-modal__body li:last-child,
  .variant-size-guide-modal__body--printing-note p:last-child,
  .variant-size-guide-modal__body--printing-note li:last-child {
    margin-bottom: 0;
  }

  body.variant-size-guide-modal-open {
    overflow: hidden;
  }

  .variant-picker {
    width: 100%;
  }

  .variant-picker__form {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    max-width: 100%;
  }

  /* Imprint + Imprint Size: 75% column (half + half more) */
  .variant-imprint-group {
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: calc(75% - 8px);
    max-width: calc(75% - 8px);
    min-width: 0;
    align-self: flex-start;
    flex: 0 0 auto;
    box-sizing: border-box;
  }

  .variant-imprint-group > .variant-option {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }

  .variant-imprint-group > .variant-option + .variant-option {
    margin-block-start: 0;
  }

  .variant-imprint-group .variant-option--dropdowns {
    width: 100%;
    max-width: 100%;
  }

  .variant-picker .variant-option--buttons.variant-option--imprint-tabs {
    display: flex;
    flex-direction: column;
    gap: 0;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: none;
    box-sizing: border-box;
  }

  .variant-picker .variant-option--imprint-tabs legend.variant-imprint-tabs__legend {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 5px;
    width: 100%;
    margin: 0;
    padding: 0;
    float: none;
  }

  .variant-picker .variant-imprint-tabs__legend-label {
    color: #1f1f1f;
    font-family: Lato, sans-serif;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.3;
  }

  /* Tab strip: 8px inset, 8px rounded tabs */
  .variant-picker .variant-imprint-tabs__list {
    display: flex;
    flex-wrap: nowrap;
    align-items: stretch;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    margin-block-start: 5px;
    margin-inline: 0;
    margin-block-end: 0;
    padding: 4px;
    gap: 4px;
    list-style: none;
    border: 1px solid #d9dbdf;
    border-radius: 8px;
    overflow: visible;
    background: #fff;
    box-sizing: border-box;
  }

  .variant-picker .variant-imprint-tab {
    --variant-picker-stroke-color: transparent;

    position: relative;
    display: flex;
    flex: 1 1 0%;
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    min-width: 0;
    max-width: none;
    min-height: auto;
    margin: 0;
    padding: 6px 3px;
    border: 0;
    border-radius: 8px;
    background: #fff;
    color: #5f5f5f;
    font-family: Lato, sans-serif;
    font-size: 13px;
    font-weight: 400;
    line-height: 1.25;
    white-space: normal;
    text-align: center;
    cursor: pointer;
    overflow: visible;
    gap: 0;
  }

  .variant-picker .variant-imprint-tab::before,
  .variant-picker .variant-imprint-tab::after {
    content: none;
    display: none;
  }

  .variant-picker .variant-imprint-tab input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
    width: 1px;
    height: 1px;
  }

  .variant-picker .variant-imprint-tab .variant-option__button-label__text {
    position: relative;
    z-index: 1;
  }

  .variant-picker .variant-imprint-tab:has(:checked) {
    background: #0f2e53;
    color: #fff;
    font-weight: 600;
  }

  .variant-picker .variant-imprint-tab:hover:has(:not(:checked)) {
    background: #f5f6f8;
    color: #1f1f1f;
  }

  .variant-picker .variant-imprint-tab:has(:checked):hover {
    background: #0f2e53;
    color: #fff;
  }

  .variant-picker .variant-imprint-tab:has([data-option-available='false']) {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .variant-picker .variant-imprint-tab svg {
    display: none;
  }

  @media screen and (max-width: 767px) {
    .variant-imprint-group {
      width: 100%;
      max-width: 100%;
    }

    .variant-picker .variant-imprint-tabs__list {
      flex-wrap: nowrap;
    }

    .variant-picker .variant-imprint-tab {
      flex: 1 1 0%;
      min-width: 0;
      padding: 5px 3px;
      font-size: 10px;
      line-height: 1.2;
      white-space: nowrap;
    }
  }

  .variant-option--imprint-size .varian-option-container > label {
    flex: 1 1 auto;
    max-width: none;
    padding-right: 0;
    color: #1f1f1f;
    font-family: Lato, sans-serif;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.3;
  }

  .variant-imprint-size__alert {
    margin: 6px 0 0;
    color: #b42318;
    font-family: Lato, sans-serif;
    font-size: 13px;
    font-weight: 400;
    line-height: 1.3;
  }

  .variant-imprint-size__alert[hidden] {
    display: none;
  }

  .variant-option--imprint-size .variant-imprint-size__select-wrapper--error {
    border-color: #b42318;
  }

  .variant-option--imprint-size--disabled {
    opacity: 0.55;
  }

  .variant-option--imprint-size--disabled .variant-option__select-wrapper {
    pointer-events: none;
    background: #f5f6f8;
  }

  .variant-option--imprint-size--disabled .variant-option__select {
    cursor: not-allowed;
  }

  .variant-picker__form--single-option {
    display: block !important;
    width: 100% !important;
  }

  .variant-picker__form--single-option > .variant-option {
    width: 100% !important;
    max-width: none !important;
  }

  .variant-picker[data-shopify-visual-preview] {
    min-width: 300px;
    padding-inline-start: max(4px, var(--padding-inline-start));
  }

  .variant-option__select-wrapper {
    display: flex;
    position: relative;
    border: var(--style-border-width-inputs) solid var(--color-border);
    border-radius: var(--style-border-radius-inputs);
    align-items: center;
    margin-top: var(--margin-2xs);
    overflow: clip;
  }

  .variant-option__select-wrapper:has(.swatch) {
    --variant-picker-swatch-width: 20px;
    --variant-picker-swatch-height: 20px;
  }

  .variant-option__select-wrapper:hover {
    border-color: var(--color-variant-hover-border);
  }

  .variant-option__select:focus-visible {
    outline: var(--focus-outline-width) solid currentcolor;
    outline-offset: var(--focus-outline-offset);
  }

  .variant-option__select {
    padding-block: var(--padding-md);
    padding-inline: var(--padding-lg) calc(var(--padding-lg) + var(--icon-size-2xs));
    appearance: none;
    border: 0;
    width: 100%;
    margin: 0;
    cursor: pointer;
  }

  .variant-option__select-wrapper .icon {
    position: absolute;
    right: var(--padding-md);
    top: 50%;
    transform: translateY(-50%);
    width: var(--icon-size-2xs);
    height: var(--icon-size-2xs);
    pointer-events: none;
  }

  .variant-option__select--has-swatch {
    padding-inline-start: calc((2 * var(--padding-sm)) + var(--variant-picker-swatch-width));
  }

  .variant-option__select-wrapper .swatch {
    position: absolute;
    top: 50%;
    left: var(--padding-md);
    transform: translateY(-50%);
  }

  .variant-picker--center,
  .variant-picker--center .variant-option {
    text-align: center;
    align-items: center;
    justify-content: center;
    width: 100%;
  }

  .variant-picker--right,
  .variant-picker--right .variant-option {
    text-align: right;
    justify-content: right;
  }

  @media screen and (max-width: 767px) {
    .variant-option--text-mode {
      gap: 10px !important;
    }

    .variant-option--text-mode .varian-option-container--single {
      flex: 0 0 calc(50% - 5px) !important;
      width: calc(50% - 5px) !important;
      max-width: calc(50% - 5px) !important;
    }

    .variant-option--text-mode .variant-option__text-input-wrapper {
      flex: 0 0 calc(50% - 5px) !important;
      width: calc(50% - 5px) !important;
      max-width: calc(50% - 5px) !important;
    }

    .variant-color-swatch__legend {
      font-size: 16px;
    }

    .variant-color-swatch {
      width: 36px;
      height: 36px;
    }

    .variant-color-swatch__circle {
      width: 32px;
      height: 32px;
    }

    .variant-size-guide-modal {
      padding: 14px;
    }

    .variant-size-guide-modal__dialog {
      max-width: 365px;
      max-height: calc(100vh - 28px);
      border-radius: 8px;
    }

    .variant-size-guide-modal__close {
      top: 12px;
      right: 14px;
      width: 24px;
      height: 24px;
      font-size: 28px;
    }

    .variant-size-guide-modal__content,
    .variant-size-guide-modal__content--printing-note {
      padding: 38px 28px 32px;
    }

    .variant-size-guide-modal__title {
      margin-bottom: 42px;
      font-size: 20px;
      line-height: 27px;
    }

    .variant-size-guide-modal__intro {
      font-size: 16px;
      line-height: 24px;
    }

    .variant-size-guide-modal__body,
    .variant-size-guide-modal__body--printing-note,
    .variant-size-guide-modal__list,
    .variant-size-guide-modal__example {
      font-size: 14px;
      line-height: 18px;
    }

    .variant-size-guide-modal__list {
      padding-left: 20px;
    }

    .variant-size-guide-modal__list li {
      margin-bottom: 8px;
    }
  }
{% endstylesheet %}