                          </svg>
                        </span>
                      </summary>
                      <ul class="mobile-submenu-child">
                        {%- for grandchild_link in child_link.links -%}
                          <li class="mobile-submenu-child__item">
                            <a class="inside-mobile-submenu-child__item" href="{{ grandchild_link.url }}">{{ grandchild_link.title }}</a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    </details>
                  {%- else -%}
                    <a class="inside-mobile-submenu" href="{{ child_link.url }}">{{ child_link.title }}</a>
                  {%- endif -%}
                </li>
              {%- endfor -%}

              {%- if mobile_link_title == 'shop all' -%}
                {%- if secondary_menu != blank and secondary_menu.links != blank -%}
