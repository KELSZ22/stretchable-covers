{%- doc -%}
  Renders a price filter.

  @param {object} filter - The filter object to render.
  @param {string} filter_style - The filter style, can be 'horizontal' or 'vertical'.
  @param {boolean} [should_render_clear] - Whether to render the clear button.
  @param {string} [typography_facets_label_preset] - Optional typography preset class for the label.
  @param {string} [typography_facets_label_color] - Optional color for the label.

  @example
  {% render 'price-filter', filter: filter, filter_style: 'vertical' %}
{%- enddoc -%}

<accordion-custom
  class="facets__item"
  {% if filter_style == 'horizontal' %}
    data-disable-animation-on-desktop="true"
    data-close-with-escape="true"
  {% endif %}

  {% if filter_style == 'vertical' %}
    open
    open-by-default-on-mobile
    open-by-default-on-desktop
  {% endif %}
>
  <details
    class="facets__panel"
    {% if filter_style == 'horizontal' %}
      data-auto-close-details="desktop"
    {% endif %}
    {% if filter_style == 'vertical' %}
      open
    {% endif %}
  >
    <summary
      class="facets__summary"
      data-testid="price-filter"
    >
      <span
        class="facets__label {{ typography_facets_label_preset }}"
        style="{% if typography_facets_label_color %}--color: {{ typography_facets_label_color }};{% endif %}"
      >{{ filter.label }}</span>
      <facet-status-component class="facets__status">
        <template ref="moneyFormat">{{ shop.money_format }}</template>

        <span
          class="hide-when-empty"
          ref="facetStatus"
          data-currency="{{ localization.country.currency.iso_code }}"
          data-range-max="{{ filter.range_max | money_without_currency }}"
        >
          {%- if filter.min_value.value != null or filter.max_value.value != null %}
            {%- if filter.min_value.value != null and filter.max_value.value != null %}
              {{- filter.min_value.value | money | strip_html -}}
              –
              {{- filter.max_value.value | money | strip_html -}}
            {%- elsif filter.min_value.value != null -%}
              {{ filter.min_value.value | money | strip_html }}–{{ filter.range_max | money | strip_html }}

            {%- elsif filter.max_value.value != null -%}
              {{- 0 | money | strip_html -}}
              –
              {{- filter.max_value.value | money | strip_html -}}
            {%- endif -%}
          {%- endif -%}
        </span>
      </facet-status-component>
      <span class="svg-wrapper icon-caret icon-animated">
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </span>
    </summary>
    <floating-panel-component
      {% unless filter_style == 'vertical' %}
        data-close-on-resize
      {% endunless %}
      class="facets__panel-content details-content{% if filter_style == 'horizontal' %} color-{{ settings.popover_color_scheme }}{% endif %}"
    >
      {% assign min_input_max_value = filter.max_value.value | default: filter.range_max %}
      {% assign max_input_min_value = filter.min_value.value | default: 0 %}
      {% assign range_min = 0 %}
      {% assign range_max = filter.range_max | money_without_currency | times: 1 %}
      {% assign current_min = filter.min_value.value | money_without_currency | times: 1 | default: range_min %}
      {% assign current_max = filter.max_value.value | money_without_currency | times: 1 | default: range_max %}

      <price-facet-component
        class="
          price-facet
          {%- if filter_style == 'horizontal' %}
            price-facet--horizontal
          {%- endif %}
        "
        id="facet-inputs-{{ filter.param_name | escape | replace: '.', '-' }}"
        data-money-format="{{ shop.money_format | strip_html }}"
        data-currency="{{ localization.country.currency.iso_code }}"
        data-range-min="{{ range_min }}"
        data-range-max="{{ range_max }}"
        on:change="/updatePriceFilterAndResults"
      >
        <!-- Range Slider Triakl-->
        <div class="price-facet__slider-container">
          <div class="price-facet__slider-track"></div>
          <input
            type="range"
            class="price-facet__range-input price-facet__range-input--min"
            min="{{ range_min }}"
            max="{{ range_max }}"
            step="1"
            value="{{ current_min }}"
            ref="minSlider"
          >
          <input
            type="range"
            class="price-facet__range-input price-facet__range-input--max"
            min="{{ range_min }}"
            max="{{ range_max }}"
            step="1"
            value="{{ current_max }}"
            ref="maxSlider"
          >
        </div>

        <div class="facets__inputs-wrapper facets__inputs-wrapper--row">
          <div
            class="price-facet__inputs-wrapper"
          >
            <div class="field price-facet__field">
              <input
                class="field__input price-facet__input"
                name="{{ filter.min_value.param_name }}"
                id="{{ filter.label | escape }}-GTE"
                {%- if filter.min_value.value -%}
                  value="{{ filter.min_value.value | money_without_currency }}"
                {%- endif -%}
                type="text"
                inputmode="decimal"
                placeholder="0"
                data-min="0"
                data-max="{{ min_input_max_value | money_without_currency }}"
                ref="minInput"
                autocomplete="off"
              >

              <label
                class="field__label price-facet__label"
                for="{{ filter.label | escape }}-GTE"
              >
                {{ cart.currency.symbol }}
              </label>
            </div>

            <div class="price-facet__separator">{{ 'fields.separator' | t }}</div>

            <div class="field price-facet__field">
              <input
                class="field__input price-facet__input"
                name="{{ filter.max_value.param_name }}"
                id="{{ filter.label | escape }}-LTE"
                {%- if filter.max_value.value -%}
                  value="{{ filter.max_value.value | money_without_currency }}"
                {%- endif -%}
                type="text"
                inputmode="decimal"
                placeholder="{{ filter.range_max | money_without_currency }}"
                data-min="{{ max_input_min_value | money_without_currency }}"
                data-max="{{ filter.range_max | money_without_currency }}"
                ref="maxInput"
                autocomplete="off"
              >
              <label
                class="field__label price-facet__label"
                for="{{ filter.label | escape }}-LTE"
              >
                {{ cart.currency.symbol }}
              </label>
            </div>
          </div>
        </div>

        <div
          class="
            price-facet__highest-price
            {%- if filter_style == 'horizontal' %}
              price-facet__highest-price--horizontal
            {%- endif %}
          "
        >
          {%- assign formatted_highest_price = filter.range_max | money -%}
          {{ 'content.price_filter_html' | t: price: formatted_highest_price }}
        </div>

        {% if filter.min_value.value != null or filter.max_value.value != null %}
          {% assign has_active_values = true %}
        {% endif %}

        {% if should_render_clear %}
          <facet-clear-component
            class="clear-filter"
            tabindex="{% if has_active_values %}0{% else %}-1{% endif %}"
            on:click="/clearFilter"
            on:keydown="/clearFilter"
          >
            <div
              class="facets__clear {% if has_active_values %}facets__clear--active{% endif %}"
              ref="clearButton"
            >
              {{- 'actions.clear' | t -}}
            </div>
          </facet-clear-component>
        {% endif %}
      </price-facet-component>
    </floating-panel-component>
  </details>
</accordion-custom>

{% stylesheet %}
  .price-facet {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
  }
  .price-facet--horizontal {
    min-width: 360px;
  }

  .price-facet__slider-container {
    position: relative;
    height: 40px;
    margin: 0;
    display: flex;
    align-items: center;
  }
  .price-facet__slider-container input {
    background-color: #E6F4FC !important;
  }
  .price-facet__slider-track {
    position: absolute;
    height: 4px;
    background: #E6F4FC;
    width: 100%;
    border-radius: 4px;
  }

  .price-facet__range-input {
    position: absolute;
    width: 100%;
    height: 4px;
    background: none;
    pointer-events: none;
    -webkit-appearance: none;
    appearance: none;
  }

  .price-facet__range-input:focus {
    outline: none;
  }

  .price-facet__range-input::-webkit-slider-thumb {
    height: 16px;
    width: 16px;
    border-radius: 50%;
    background: #0F2E53;
    pointer-events: auto;
    -webkit-appearance: none;
    appearance: none;
    cursor: pointer;
    margin-top: -6px;
    z-index: 100;
    position: relative;
  }

  .price-facet__range-input::-moz-range-thumb {
    height: 16px;
    width: 16px;
    border-radius: 50%;
    background: #0F2E53;
    pointer-events: auto;
    cursor: pointer;
    margin-top: -6px;
    z-index: 100;
    position: relative;
  }

  .price-facet__range-input::-webkit-slider-runnable-track {
    height: 4px;
    background: transparent;
    border: none;
  }

  .price-facet__range-input::-moz-range-track {
    height: 4px;
    background: transparent;
    border: none;
  }

  .price-facet__inputs-wrapper {
    display: flex;
    flex-direction: row;
    padding: var(--style-border-width-inputs);
    gap: calc(var(--gap-sm) + (var(--style-border-width-inputs) * 2));
  }

  @container (max-width: 199px) {
    .price-facet__inputs-wrapper {
      flex-wrap: wrap;
    }
  }

  .price-facet__input {
    width: 100%;
    text-align: right;
    padding-left: calc(2.5 * var(--input-padding-x));
  }

  .price-facet__input::placeholder {
    color: var(--facets-input-label-color);
  }

  .price-facet__separator {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--font-paragraph--size);
  }

  .price-facet__highest-price {
    padding: var(--padding-xs) 0 var(--padding-sm);
  }

  .price-facet__highest-price--horizontal {
    padding: 0 var(--padding-md) var(--padding-xs);
  }

  .price-facet__label {
    top: 0;
    left: 0;
    color: var(--facets-input-label-color);
    padding: var(--input-padding-y) var(--input-padding-x);
    transform: none;
  }
{% endstylesheet %}

{% javascript %}
  class PriceFacetComponent extends HTMLElement {
    constructor() {
      super();
      this.minInput = this.querySelector('[ref="minInput"]');
      this.maxInput = this.querySelector('[ref="maxInput"]');
      this.minSlider = this.querySelector('[ref="minSlider"]');
      this.maxSlider = this.querySelector('[ref="maxSlider"]');
      this.rangeMin = parseFloat(this.dataset.rangeMin) || 0;
      this.rangeMax = parseFloat(this.dataset.rangeMax) || 100;
      
      this.init();
    }
    
    init() {
      if (this.minSlider && this.maxSlider) {
        this.updateSliderBackground();
        this.minSlider.addEventListener('input', this.handleSliderChange.bind(this));
        this.maxSlider.addEventListener('input', this.handleSliderChange.bind(this));
      }
      
      if (this.minInput) {
        this.minInput.addEventListener('input', this.handleInputChange.bind(this, 'min'));
        this.minInput.addEventListener('blur', this.validateInput.bind(this, 'min'));
      }
      
      if (this.maxInput) {
        this.maxInput.addEventListener('input', this.handleInputChange.bind(this, 'max'));
        this.maxInput.addEventListener('blur', this.validateInput.bind(this, 'max'));
      }
    }
    
    updateSliderBackground() {
      const min = parseFloat(this.minSlider.value);
      const max = parseFloat(this.maxSlider.value);
      const percentMin = ((min - this.rangeMin) / (this.rangeMax - this.rangeMin)) * 100;
      const percentMax = ((max - this.rangeMin) / (this.rangeMax - this.rangeMin)) * 100;
      
      const track = this.querySelector('.price-facet__slider-track');
      if (track) {
        track.style.background = `linear-gradient(to right, 
          var(--facets-border-color, #e5e5e5) 0%, 
          var(--facets-border-color, #e5e5e5) ${percentMin}%, 
          var( #0F2E53) ${percentMin}%, 
          var( #0F2E53) ${percentMax}%, 
          var(--facets-border-color, #e5e5e5) ${percentMax}%, 
          var(--facets-border-color, #e5e5e5) 100%)`;
      }
    }
    
    handleSliderChange() {
      let minVal = parseFloat(this.minSlider.value);
      let maxVal = parseFloat(this.maxSlider.value);
      
      if (minVal > maxVal) {
        [minVal, maxVal] = [maxVal, minVal];
        this.minSlider.value = minVal;
        this.maxSlider.value = maxVal;
      }
      
      this.minInput.value = Math.floor(minVal);
      this.maxInput.value = Math.floor(maxVal);
      
      this.updateSliderBackground();
      this.dispatchChangeEvent();
    }
    
    handleInputChange(type, event) {
      let value = parseFloat(event.target.value);
      
      if (isNaN(value)) {
        value = type === 'min' ? this.rangeMin : this.rangeMax;
      }
      
      if (type === 'min') {
        value = Math.min(value, this.rangeMax);
        value = Math.min(value, parseFloat(this.maxInput.value) || this.rangeMax);
        this.minSlider.value = value;
        this.minInput.value = Math.floor(value);
      } else {
        value = Math.max(value, this.rangeMin);
        value = Math.max(value, parseFloat(this.minInput.value) || this.rangeMin);
        this.maxSlider.value = value;
        this.maxInput.value = Math.floor(value);
      }
      
      this.updateSliderBackground();
      this.dispatchChangeEvent();
    }
    
    validateInput(type) {
      let value = parseFloat(this.querySelector(`[ref="${type}Input"]`).value);
      const otherValue = parseFloat(this.querySelector(`[ref="${type === 'min' ? 'max' : 'min'}Input"]`).value);
      
      if (isNaN(value)) {
        value = type === 'min' ? this.rangeMin : this.rangeMax;
      }
      
      if (type === 'min') {
        if (value < this.rangeMin) value = this.rangeMin;
        if (!isNaN(otherValue) && value > otherValue) value = otherValue;
        this.minSlider.value = value;
        this.minInput.value = Math.floor(value);
      } else {
        if (value > this.rangeMax) value = this.rangeMax;
        if (!isNaN(otherValue) && value < otherValue) value = otherValue;
        this.maxSlider.value = value;
        this.maxInput.value = Math.floor(value);
      }
      
      this.updateSliderBackground();
      this.dispatchChangeEvent();
    }
    
    dispatchChangeEvent() {
      const minValue = this.minInput.value;
      const maxValue = this.maxInput.value;
      
      const event = new CustomEvent('priceChange', {
        detail: { min: minValue, max: maxValue },
        bubbles: true
      });
      
      this.dispatchEvent(event);

      const changeEvent = new Event('change', { bubbles: true });
      this.dispatchEvent(changeEvent);
    }
  }
  
  customElements.define('price-facet-component', PriceFacetComponent);
{% endjavascript %}