<div class="header-search" data-search-dropdown>
  <form action="{{ routes.search_url }}" method="get" role="search" class="header-search__form">
    <input
      type="text"
      name="q"
      placeholder="{{ search_placeholder | default: 'Search Covers' }}"
      aria-label="Search"
      class="header-search__input"
      autocomplete="off"
    >
    <button type="submit" aria-label="Submit search" class="header-search__submit">
      <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 17 17" fill="none">
        <path d="M12.033 11.058L15.912 14.938" stroke="#1F1F1F" stroke-width="1.5" stroke-linecap="round"/>
        <circle cx="7.438" cy="7.438" r="5.438" stroke="#1F1F1F" stroke-width="1.5"/>
      </svg>
    </button>
  </form>

  <div class="custom-search-dropdown" hidden>
    <div class="custom-search-dropdown__body">
      <div class="custom-search-dropdown__col custom-search-dropdown__col--left">
        <h4 class="custom-search-dropdown__title">Top Searches</h4>

        <ul class="custom-search-dropdown__links">
          <li>
            <a href="{{ routes.search_url }}?q=Steering%20wheel%20cover&type=product">
              <span class="custom-search-dropdown__link-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="15" viewBox="0 0 14 15" fill="none">
                  <path d="M9.58984 0L13.3398 3.75L13.7695 4.19922L13.3398 4.64844L9.58984 8.39844L8.69141 7.5L11.3672 4.82422H10.625C5.43945 4.82422 1.25 9.01367 1.25 14.1992H0C0 8.3374 4.76318 3.57422 10.625 3.57422H11.3672L8.69141 0.898438L9.58984 0Z" fill="#1F1F1F"/>
                </svg>
              </span>
              <span>Steering wheel cover</span>
            </a>
          </li>

          <li>
            <a href="{{ routes.search_url }}?q=Sousaphone%20cover&type=product">
              <span class="custom-search-dropdown__link-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="15" viewBox="0 0 14 15" fill="none">
                  <path d="M9.58984 0L13.3398 3.75L13.7695 4.19922L13.3398 4.64844L9.58984 8.39844L8.69141 7.5L11.3672 4.82422H10.625C5.43945 4.82422 1.25 9.01367 1.25 14.1992H0C0 8.3374 4.76318 3.57422 10.625 3.57422H11.3672L8.69141 0.898438L9.58984 0Z" fill="#1F1F1F"/>
                </svg>
              </span>
              <span>Sousaphone cover</span>
            </a>
          </li>

          <li>
            <a href="{{ routes.search_url }}?q=Bar%20%26%20Exam%20stool%20cover&type=product">
              <span class="custom-search-dropdown__link-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="15" viewBox="0 0 14 15" fill="none">
                  <path d="M9.58984 0L13.3398 3.75L13.7695 4.19922L13.3398 4.64844L9.58984 8.39844L8.69141 7.5L11.3672 4.82422H10.625C5.43945 4.82422 1.25 9.01367 1.25 14.1992H0C0 8.3374 4.76318 3.57422 10.625 3.57422H11.3672L8.69141 0.898438L9.58984 0Z" fill="#1F1F1F"/>
                </svg>
              </span>
              <span>Bar &amp; Exam stool cover</span>
            </a>
          </li>
        </ul>
      </div>

      <div class="custom-search-dropdown__col custom-search-dropdown__col--middle">
        <h4 class="custom-search-dropdown__title" data-search-products-title>Recently Viewed Products</h4>

        <div class="custom-search-dropdown__products" data-search-results>
          {% if product_1 != blank %}
            <a href="{{ product_1.url }}" class="custom-search-dropdown__product">
              {% if product_1.featured_image != blank %}
                <img
                  src="{{ product_1.featured_image | image_url: width: 240 }}"
                  alt="{{ product_1.title | escape }}"
                  width="240"
                  height="240"
                >
              {% endif %}
              <span>{{ product_1.title }}</span>
            </a>
          {% endif %}

          {% if product_2 != blank %}
            <a href="{{ product_2.url }}" class="custom-search-dropdown__product">
              {% if product_2.featured_image != blank %}
                <img
                  src="{{ product_2.featured_image | image_url: width: 240 }}"
                  alt="{{ product_2.title | escape }}"
                  width="240"
                  height="240"
                >
              {% endif %}
              <span>{{ product_2.title }}</span>
            </a>
          {% endif %}
        </div>
      </div>

    </div>
  </div>
</div>

{% if template.name == 'product' and product != blank %}
  <script type="application/json" data-current-product-json>
    {
      "id": {{ product.id | json }},
      "title": {{ product.title | json }},
      "url": {{ product.url | json }},
      "image": {{ product.featured_image | image_url: width: 240 | json }},
      "price": {{ product.selected_or_first_available_variant.price | json }}
    }
  </script>
{% endif %}

{%- liquid
  assign search_fb_p1 = fallback_product_1
  assign search_fb_p2 = fallback_product_2
  assign search_fb_p3 = fallback_product_3
  assign search_fb_p4 = fallback_product_4

  if search_fb_p1 == blank
    assign search_fb_p1 = all_products['aa-stretchable-covers-xxlfc-jumbo-24-28-full-coverage-printing-on-white-material']
  endif
  if search_fb_p2 == blank
    assign search_fb_p2 = all_products['aaastretchable-covers-xxl-jumbo-24-28']
  endif
  if search_fb_p3 == blank
    assign search_fb_p3 = all_products['c-stretchable-covers-l-standard-18-20']
  endif
  if search_fb_p4 == blank
    assign search_fb_p4 = all_products['b-stretchable-covers-xl-21-23']
  endif

  if search_fb_p1 == blank or search_fb_p2 == blank or search_fb_p3 == blank or search_fb_p4 == blank
    for catalog_product in collections.all.products
      assign catalog_title = catalog_product.title | downcase | strip
      if search_fb_p1 == blank and catalog_title == 'size xxl (full color printing)'
        assign search_fb_p1 = catalog_product
      elsif search_fb_p2 == blank and catalog_title == 'size xxl (standard size printing)'
        assign search_fb_p2 = catalog_product
      elsif search_fb_p3 == blank and catalog_title == 'size l (large)'
        assign search_fb_p3 = catalog_product
      elsif search_fb_p4 == blank and catalog_title == 'size xl (x-large)'
        assign search_fb_p4 = catalog_product
      endif
    endfor
  endif
-%}

{%- capture search_fallback_products_json -%}
[
{%- assign search_fallback_first = true -%}
{%- if search_fb_p1 != blank -%}
  {%- unless search_fallback_first -%},{%- endunless -%}
  {"id":{{ search_fb_p1.id | json }},"title":{{ search_fb_p1.title | json }},"url":{{ search_fb_p1.url | json }},"image":{{ search_fb_p1.featured_image | image_url: width: 240 | json }}}
  {%- assign search_fallback_first = false -%}
{%- endif -%}
{%- if search_fb_p2 != blank -%}
  {%- unless search_fallback_first -%},{%- endunless -%}
  {"id":{{ search_fb_p2.id | json }},"title":{{ search_fb_p2.title | json }},"url":{{ search_fb_p2.url | json }},"image":{{ search_fb_p2.featured_image | image_url: width: 240 | json }}}
  {%- assign search_fallback_first = false -%}
{%- endif -%}
{%- if search_fb_p3 != blank -%}
  {%- unless search_fallback_first -%},{%- endunless -%}
  {"id":{{ search_fb_p3.id | json }},"title":{{ search_fb_p3.title | json }},"url":{{ search_fb_p3.url | json }},"image":{{ search_fb_p3.featured_image | image_url: width: 240 | json }}}
  {%- assign search_fallback_first = false -%}
{%- endif -%}
{%- if search_fb_p4 != blank -%}
  {%- unless search_fallback_first -%},{%- endunless -%}
  {"id":{{ search_fb_p4.id | json }},"title":{{ search_fb_p4.title | json }},"url":{{ search_fb_p4.url | json }},"image":{{ search_fb_p4.featured_image | image_url: width: 240 | json }}}
  {%- assign search_fallback_first = false -%}
{%- endif -%}
]
{%- endcapture -%}
<script type="application/json" data-search-fallback-products>{{ search_fallback_products_json | strip }}</script>

<style>
  .custom-search-dropdown__col.custom-search-dropdown__col--right .custom-search-dropdown__featured {
    align-items: flex-start;
  }

  .heading-search-featured {
    color: #1F1F1F;
    font-family: Lato, sans-serif;
    font-size: 14px;
    font-style: normal;
    font-weight: 700;
    line-height: 18px;
    text-align: left;
    margin-bottom: 5px;
    text-transform: uppercase;
  }

  .text-search-featured {
    color: #1F1F1F;
    font-family: Lato, sans-serif;
    font-size: 12px;
    font-style: normal;
    font-weight: 400;
    line-height: 14px;
    text-align: left;
    margin: 0;
  }

  .header-search[data-search-dropdown] {
    position: relative;
  }

  .header-search__form {
    display: flex;
    align-items: center;
    width: 100%;
  }

  .header-search__input {
    flex: 1;
    min-width: 0;
  }

  .header-search__submit {
    flex: 0 0 auto;
  }

  .custom-search-dropdown[hidden] {
    display: none !important;
  }

  .custom-search-dropdown {
    position: absolute;
    top: calc(100% + 14px);
    left: 0;
    width: 100%;
    background: #fff;
    border-radius: 18px;
    padding: 48px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.16);
    z-index: 99999;
  }

  .custom-search-dropdown__body {
    display: flex;
    gap: 48px;
  }

  .custom-search-dropdown__col {
    box-sizing: border-box;
  }

  .custom-search-dropdown__col:not(:last-child) {
    border-right: 1px solid rgba(0, 0, 0, 0.15);
    padding-right: 32px;
  }

  .custom-search-dropdown__col:not(:first-child) {
    padding-left: 0;
  }

  .custom-search-dropdown__col.custom-search-dropdown__col--left {
    width: 20%;
    position: relative;
  }

  .custom-search-dropdown__col.custom-search-dropdown__col--middle {
    width: 80%;
    position: relative;
  }

  .custom-search-dropdown__col.custom-search-dropdown__col--right {
    width: 20%;
  }

  .custom-search-dropdown__title {
    margin: 0 0 31px;
    color: #0F2E53;
    font-family: Lato, sans-serif;
    font-size: 24px;
    font-style: normal;
    font-weight: 700;
    line-height: 26px;
  }

  .custom-search-dropdown__links {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .custom-search-dropdown__links li + li {
    margin-top: 31px;
  }

  .custom-search-dropdown__links a {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: inherit;
  }

  .custom-search-dropdown__link-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 14px;
    width: 14px;
    height: 15px;
  }

  .custom-search-dropdown__links span:last-child {
    color: #1F1F1F;
    font-family: Lato, sans-serif;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: 18px;
  }

  .custom-search-dropdown__links a:hover span:last-child {
    color: #0F2E53;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .custom-search-dropdown__products {
    display: flex;
    gap: 14px;
  }

  .custom-search-dropdown__product,
  .custom-search-dropdown__featured {
    display: flex;
    text-decoration: none;
    color: inherit;
    flex-direction: column;
    align-items: center;
  }

  .custom-search-dropdown__product {
    flex: 1 1 0;
    min-width: 0;
  }

  .custom-search-dropdown__product img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    display: block;
    border-radius: 6px;
    margin-bottom: 8px;
  }

  .custom-search-dropdown__product span {
    color: #0F2E53;
    text-align: center;
    font-family: Lato, sans-serif;
    font-size: 12px;
    font-style: normal;
    font-weight: 400;
    line-height: 14px;
  }

  .custom-search-dropdown__featured-product {
    width: 100%;
    align-items: flex-start !important;
    text-decoration: none;
    color: inherit;
    background: #fff;
    border-radius: 8px;
    overflow: hidden;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .custom-search-dropdown__featured-product:hover {
    transform: translateY(-2px);
    border-color: rgba(15, 46, 83, 0.35);
    box-shadow: 0 10px 24px rgba(15, 46, 83, 0.12);
  }

  .custom-search-dropdown__featured-product--empty {
    pointer-events: none;
  }

  .custom-search-dropdown__featured-image-wrap {
    width: 100%;
    background: #f7f7f7;
    overflow: hidden;
  }

  .custom-search-dropdown__featured-product img,
  .custom-search-dropdown__featured-placeholder {
    width: 100%;
    display: block;
    margin: 0;
    border-radius: 0;
  }

  .custom-search-dropdown__featured-product img {
    object-fit: cover;
    transition: transform 0.25s ease;
  }

  .custom-search-dropdown__featured-product:hover img {
    transform: scale(1.04);
  }

  .custom-search-dropdown__featured-placeholder {
    background: #f2f2f2;
    color: #666;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: Lato, sans-serif;
    font-size: 13px;
    font-weight: 700;
    text-align: center;
    padding: 14px;
  }

  .custom-search-dropdown__featured-product .heading-search-featured,
  .custom-search-dropdown__featured-product .text-search-featured,
  .custom-search-dropdown__featured-product .custom-search-featured-price,
  .custom-search-dropdown__featured-product .custom-search-featured-btn {
    margin-left: 10px;
    margin-right: 10px;
  }

  .custom-search-dropdown__featured-product .heading-search-featured {
    margin-top: 10px;
  }

  .custom-search-featured-price {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 7px;
    margin-bottom: 9px;
  }

  .custom-search-featured-price-current {
    color: #0F2E53;
    font-family: Lato, sans-serif;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.2;
  }

  .custom-search-featured-price-compare {
    color: #8a8a8a;
    font-family: Lato, sans-serif;
    font-size: 12px;
    font-weight: 400;
    text-decoration: line-through;
    line-height: 1.2;
  }

  .custom-search-featured-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: max-content;
    max-width: calc(100% - 20px);
    margin-top: 0;
    margin-bottom: 12px;
    padding: 7px 12px;
    background: #0F2E53;
    color: #fff;
    border-radius: 999px;
    font-family: Lato, sans-serif;
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
  }

  .custom-search-dropdown__featured strong {
    display: block;
    margin-bottom: 6px;
    font-size: 14px;
    line-height: 1.3;
  }

  .custom-search-dropdown__featured p {
    margin: 0;
    font-size: 12px;
    line-height: 1.4;
  }

  .custom-search-dropdown__empty {
    font-size: 13px;
    line-height: 1.4;
    opacity: 0.7;
    font-family: Lato;
    font-size: 20px;
    font-style: normal;
    font-weight: 400;
    line-height: 28px;
  }

  @media (max-width: 1200px) {
    .custom-search-dropdown__col.custom-search-dropdown__col--right {
      display: none;
      border: 0;
    }

    .custom-search-dropdown__col.custom-search-dropdown__col--middle {
      width: 75% !important;
      border: 0;
    }
  }

  @media (max-width: 900px) {
    .header-search {
      display: none !important;
    }

    .mobile.header-search {
      display: flex !important;
    }
  }
</style>

<script>
  (function() {
    var wrappers = document.querySelectorAll('[data-search-dropdown]');
    var RECENT_KEY = 'custom_recent_viewed_products';
    var SEARCH_PRODUCT_LIMIT = 4;
    var fallbackProductsCache = null;

    function escapeHtml(str) {
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function moneyFromCents(cents) {
      if (typeof cents !== 'number') return '';
      return '$' + (cents / 100).toFixed(2);
    }

    function getRecentProducts() {
      try {
        var parsed = JSON.parse(localStorage.getItem(RECENT_KEY) || '[]');
        return Array.isArray(parsed) ? parsed : [];
      } catch (e) {
        return [];
      }
    }

    function saveRecentProducts(items) {
      localStorage.setItem(RECENT_KEY, JSON.stringify(items.slice(0, SEARCH_PRODUCT_LIMIT)));
    }

    function getFallbackProducts() {
      if (fallbackProductsCache) {
        return fallbackProductsCache;
      }

      var source = document.querySelector('[data-search-fallback-products]');
      if (!source) {
        fallbackProductsCache = [];
        return fallbackProductsCache;
      }

      try {
        var parsed = JSON.parse(source.textContent || '[]');
        fallbackProductsCache = Array.isArray(parsed)
          ? parsed.slice(0, SEARCH_PRODUCT_LIMIT)
          : [];
      } catch (e) {
        fallbackProductsCache = [];
      }

      return fallbackProductsCache;
    }

    function renderSearchProductCards(products) {
      return products.slice(0, SEARCH_PRODUCT_LIMIT).map(function(product) {
        var imageHtml = product.image
          ? '<img src="' + escapeHtml(product.image) + '" alt="' + escapeHtml(product.title) + '">'
          : '';

        return (
          '<a href="' + escapeHtml(product.url) + '" class="custom-search-dropdown__product">' +
            imageHtml +
            '<span>' + escapeHtml(product.title) + '</span>' +
          '</a>'
        );
      }).join('');
    }

    function addCurrentProductToRecent() {
      var productJson = document.querySelector('[data-current-product-json]');
      if (!productJson) return;

      try {
        var currentProduct = JSON.parse(productJson.textContent);
        if (!currentProduct || !currentProduct.id) return;

        var items = getRecentProducts().filter(function(item) {
          return item.id !== currentProduct.id;
        });

        items.unshift(currentProduct);
        saveRecentProducts(items);
      } catch (e) {}
    }

    addCurrentProductToRecent();

    wrappers.forEach(function(wrapper) {
      var form = wrapper.querySelector('.header-search__form');
      var input = wrapper.querySelector('.header-search__input');
      var dropdown = wrapper.querySelector('.custom-search-dropdown');
      var resultsContainer = wrapper.querySelector('[data-search-results]');
      var featuredPanel = wrapper.querySelector('[data-featured-panel]');
      var productsTitle = wrapper.querySelector('[data-search-products-title]');
      var featuredTitle = wrapper.querySelector('[data-featured-title]');
      var debounceTimer = null;
      var activeController = null;
      var defaultFeaturedHtml = featuredPanel ? featuredPanel.innerHTML : '';

      if (!form || !input || !dropdown || !resultsContainer || !productsTitle) return;

      function openDropdown() {
        dropdown.hidden = false;
      }

      function closeDropdown() {
        dropdown.hidden = true;
      }

      function renderRecentProducts() {
        var items = getRecentProducts();
        var usingFallback = false;

        if (!items.length) {
          items = getFallbackProducts();
          usingFallback = items.length > 0;
        }

        productsTitle.textContent = usingFallback
          ? 'Featured Products'
          : 'Recently Viewed Products';

        if (featuredTitle) {
          featuredTitle.textContent = 'Featured Product';
        }

        if (!items.length) {
          resultsContainer.innerHTML = '<div class="custom-search-dropdown__empty">No recently viewed products yet.</div>';
          if (featuredPanel) featuredPanel.innerHTML = defaultFeaturedHtml;
          return;
        }

        resultsContainer.innerHTML = renderSearchProductCards(items);

        if (featuredPanel) {
          featuredPanel.innerHTML = defaultFeaturedHtml;
        }
      }

      function renderProducts(products, query) {
        productsTitle.textContent = 'Products';

        if (featuredTitle) {
          featuredTitle.textContent = 'Featured Product';
        }

        if (!products || !products.length) {
          resultsContainer.innerHTML = '<div class="custom-search-dropdown__empty">No products found for "' + escapeHtml(query) + '".</div>';
          if (featuredPanel) featuredPanel.innerHTML = '';
          return;
        }

        resultsContainer.innerHTML = products.slice(0, SEARCH_PRODUCT_LIMIT).map(function(product) {
          var imageHtml = '';
          if (product.featured_image && product.featured_image.url) {
            imageHtml = '<img src="' + escapeHtml(product.featured_image.url) + '&width=240" alt="' + escapeHtml(product.title) + '">';
          }

          return (
            '<a href="' + escapeHtml(product.url) + '" class="custom-search-dropdown__product">' +
              imageHtml +
              '<span>' + escapeHtml(product.title) + '</span>' +
            '</a>'
          );
        }).join('');

        if (featuredPanel) {
          var featured = products[0];
          var featuredImage = '';
          var featuredPrice = '';

          if (featured.featured_image && featured.featured_image.url) {
            featuredImage = '<img src="' + escapeHtml(featured.featured_image.url) + '&width=400" alt="' + escapeHtml(featured.title) + '">';
          }

          if (typeof featured.price === 'number') {
            featuredPrice = '<div class="custom-search-featured-price"><span class="custom-search-featured-price-current">' + moneyFromCents(featured.price) + '</span></div>';
          }

          featuredPanel.innerHTML =
            '<a href="' + escapeHtml(featured.url) + '" class="custom-search-dropdown__featured custom-search-dropdown__featured-product">' +
              '<div class="custom-search-dropdown__featured-image-wrap">' +
                featuredImage +
              '</div>' +
              '<span class="heading-search-featured">' + escapeHtml(featured.title) + '</span>' +
              featuredPrice +
              '<span class="custom-search-featured-btn">View Product</span>' +
            '</a>';
        }
      }

      function fetchPredictiveResults(query) {
        if (!query.trim()) {
          renderRecentProducts();
          return;
        }

        if (activeController) {
          activeController.abort();
        }

        activeController = new AbortController();

        var url = '/search/suggest.json?q=' + encodeURIComponent(query) +
          '&resources[type]=product' +
          '&resources[limit]=6';

        fetch(url, {
          signal: activeController.signal,
          headers: {
            'Accept': 'application/json'
          }
        })
          .then(function(response) {
            if (!response.ok) {
              throw new Error('Predictive search failed');
            }
            return response.json();
          })
          .then(function(data) {
            var products = (data.resources && data.resources.results && data.resources.results.products) ? data.resources.results.products : [];
            renderProducts(products, query);
          })
          .catch(function(error) {
            if (error.name === 'AbortError') return;
            console.error(error);
          });
      }

      input.addEventListener('focus', function() {
        openDropdown();
        if (!input.value.trim()) {
          renderRecentProducts();
        }
      });

      input.addEventListener('click', function(e) {
        e.stopPropagation();
        openDropdown();
        if (!input.value.trim()) {
          renderRecentProducts();
        }
      });

      input.addEventListener('input', function() {
        var query = input.value;

        openDropdown();
        clearTimeout(debounceTimer);

        debounceTimer = setTimeout(function() {
          fetchPredictiveResults(query);
        }, 220);
      });

      form.addEventListener('click', function(e) {
        e.stopPropagation();
      });

      dropdown.addEventListener('click', function(e) {
        e.stopPropagation();
      });

      document.addEventListener('click', function(e) {
        if (!wrapper.contains(e.target)) {
          closeDropdown();
        }
      });

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          closeDropdown();
        }
      });

      renderRecentProducts();
    });
  })();
</script>