<div class="header-search" data-search-dropdown>
  <form action="{{ routes.search_url }}" method="get" role="search" class="header-search__form">
    <input
      type="text"
      name="q"
      placeholder="{{ search_placeholder | default: 'Search Covers' }}"
      aria-label="Search"
      class="header-search__input"
      autocomplete="off"
    >
    <button type="submit" aria-label="Submit search" class="header-search__submit">
      <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 17 17" fill="none">
        <path d="M12.033 11.058L15.912 14.938" stroke="#1F1F1F" stroke-width="1.5" stroke-linecap="round"/>
        <circle cx="7.438" cy="7.438" r="5.438" stroke="#1F1F1F" stroke-width="1.5"/>
      </svg>
    </button>
  </form>

  <div class="custom-search-dropdown" hidden>
    <div class="custom-search-dropdown__body">
      <div class="custom-search-dropdown__col custom-search-dropdown__col--left">
        <h4 class="custom-search-dropdown__title">Top Searches</h4>
        <ul class="custom-search-dropdown__links">
          <li>
            <a href="/search?q=steering+wheel+cover">
              <span class="custom-search-dropdown__link-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="15" viewBox="0 0 14 15" fill="none">
                  <path d="M9.58984 0L13.3398 3.75L13.7695 4.19922L13.3398 4.64844L9.58984 8.39844L8.69141 7.5L11.3672 4.82422H10.625C5.43945 4.82422 1.25 9.01367 1.25 14.1992H0C0 8.3374 4.76318 3.57422 10.625 3.57422H11.3672L8.69141 0.898438L9.58984 0Z" fill="#1F1F1F"/>
                </svg>
              </span>
              <span>Steering wheel cover</span>
            </a>
          </li>
          <li>
            <a href="/search?q=sousaphone+cover">
              <span class="custom-search-dropdown__link-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="15" viewBox="0 0 14 15" fill="none">
                  <path d="M9.58984 0L13.3398 3.75L13.7695 4.19922L13.3398 4.64844L9.58984 8.39844L8.69141 7.5L11.3672 4.82422H10.625C5.43945 4.82422 1.25 9.01367 1.25 14.1992H0C0 8.3374 4.76318 3.57422 10.625 3.57422H11.3672L8.69141 0.898438L9.58984 0Z" fill="#1F1F1F"/>
                </svg>
              </span>
              <span>Sousaphone cover</span>
            </a>
          </li>
          <li>
            <a href="/search?q=bar+exam+stool+cover">
              <span class="custom-search-dropdown__link-icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="15" viewBox="0 0 14 15" fill="none">
                  <path d="M9.58984 0L13.3398 3.75L13.7695 4.19922L13.3398 4.64844L9.58984 8.39844L8.69141 7.5L11.3672 4.82422H10.625C5.43945 4.82422 1.25 9.01367 1.25 14.1992H0C0 8.3374 4.76318 3.57422 10.625 3.57422H11.3672L8.69141 0.898438L9.58984 0Z" fill="#1F1F1F"/>
                </svg>
              </span>
              <span>Bar &amp; Exam stool cover</span>
            </a>
          </li>
        </ul>
      </div>

      <div class="custom-search-dropdown__col custom-search-dropdown__col--middle">
        <h4 class="custom-search-dropdown__title" data-search-products-title>Recently Viewed Products</h4>
        <div class="custom-search-dropdown__products" data-search-results>
          {% if product_1 != blank %}
            <a href="{{ product_1.url }}" class="custom-search-dropdown__product">
              {% if product_1.featured_image != blank %}
                <img src="{{ product_1.featured_image | image_url: width: 240 }}" alt="{{ product_1.title | escape }}">
              {% endif %}
              <span>{{ product_1.title }}</span>
            </a>
          {% endif %}

          {% if product_2 != blank %}
            <a href="{{ product_2.url }}" class="custom-search-dropdown__product">
              {% if product_2.featured_image != blank %}
                <img src="{{ product_2.featured_image | image_url: width: 240 }}" alt="{{ product_2.title | escape }}">
              {% endif %}
              <span>{{ product_2.title }}</span>
            </a>
          {% endif %}
        </div>
      </div>

      <div class="custom-search-dropdown__col custom-search-dropdown__col--right">
        <h4 class="custom-search-dropdown__title" data-featured-title>ㅤ</h4>
        <div data-featured-panel>
          {% if featured_image != blank or featured_heading != blank or featured_text != blank %}
            <div class="custom-search-dropdown__featured">
              {% if featured_image != blank %}
                <img src="{{ featured_image | image_url: width: 400 }}" alt="{{ featured_heading | escape }}">
              {% endif %}

              {% if featured_heading != blank %}
                <span class="heading-search-featured">{{ featured_heading }}</span>
              {% endif %}

              {% if featured_text != blank %}
                <p class="text-search-featured">{{ featured_text }}</p>
              {% endif %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{% if template.name == 'product' and product != blank %}
  <script type="application/json" data-current-product-json>
    {
      "id": {{ product.id | json }},
      "title": {{ product.title | json }},
      "url": {{ product.url | json }},
      "image": {{ product.featured_image | image_url: width: 240 | json }},
      "price": {{ product.selected_or_first_available_variant.price | json }}
    }
  </script>
{% endif %}

<style>
  .custom-search-dropdown__col.custom-search-dropdown__col--right .custom-search-dropdown__featured {
    align-items: self-start;
  }

  .heading-search-featured {
    color: #1F1F1F;
    font-family: Lato;
    font-size: 14px;
    font-style: normal;
    font-weight: 700;
    line-height: 18px;
    text-align: left;
    margin-bottom: 5px;
    text-transform: uppercase;
  }

  .text-search-featured {
    color: #1F1F1F;
    font-family: Lato;
    font-size: 12px;
    font-style: normal;
    font-weight: 400;
    line-height: 14px;
    text-align: left;
  }

  .header-search[data-search-dropdown] {
    position: relative;
  }

  .header-search__form {
    display: flex;
    align-items: center;
    width: 100%;
  }

  .header-search__input {
    flex: 1;
    min-width: 0;
  }

  .header-search__submit {
    flex: 0 0 auto;
  }

  .custom-search-dropdown[hidden] {
    display: none !important;
  }

  .custom-search-dropdown {
    position: absolute;
    top: calc(100% + 14px);
    left: 0;
    width: 100%;
    background: #fff;
    border-radius: 18px;
    padding: 48px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.16);
    z-index: 99999;
  }

  .custom-search-dropdown__body {
    display: flex;
    gap: 48px;
  }

  .custom-search-dropdown__col.custom-search-dropdown__col--left {
    width: 20%;
    position: relative;
  }

  .custom-search-dropdown__col.custom-search-dropdown__col--middle {
    width: 60%;
    position: relative;
  }


  .custom-search-dropdown__col.custom-search-dropdown__col--right {
    width: 20%;
  }

  .custom-search-dropdown__title {
    margin: 0 0 31px;
    color: #0F2E53;
    font-family: Lato;
    font-size: 24px;
    font-style: normal;
    font-weight: 700;
    line-height: 26px;
  }

  .custom-search-dropdown__links {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .custom-search-dropdown__links li + li {
    margin-top: 31px;
  }

  .custom-search-dropdown__links a {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: inherit;
  }

  .custom-search-dropdown__link-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 14px;
    width: 14px;
    height: 15px;
  }

  .custom-search-dropdown__links span:last-child {
    color: #1F1F1F;
    font-family: Lato;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: 18px;
  }

  .custom-search-dropdown__products {
    display: flex;
    gap: 14px;
  }

  .custom-search-dropdown__product,
  .custom-search-dropdown__featured {
    display: flex;
    text-decoration: none;
    color: inherit;
    flex-direction: column;
    align-items: center;
  }

  .custom-search-dropdown__product img,
  .custom-search-dropdown__featured img {
    width: 100%;
    display: block;
    border-radius: 6px;
    margin-bottom: 8px;
  }

  .custom-search-dropdown__product span {
    color: #0F2E53;
    text-align: center;
    font-family: Lato;
    font-size: 12px;
    font-style: normal;
    font-weight: 400;
    line-height: 14px;
  }

  .custom-search-dropdown__featured strong {
    display: block;
    margin-bottom: 6px;
    font-size: 14px;
    line-height: 1.3;
  }

  .custom-search-dropdown__featured p {
    margin: 0;
    font-size: 12px;
    line-height: 1.4;
  }

  .custom-search-dropdown__empty {
    font-size: 13px;
    line-height: 1.4;
    opacity: 0.7;
  }

  @media (max-width: 900px) {
  .header-search {
    display: none !important;
  }
  .mobile.header-search {
    display: flex !important;
  }
}
</style>

<script>
  (function() {
    var wrappers = document.querySelectorAll('[data-search-dropdown]');
    var RECENT_KEY = 'custom_recent_viewed_products';

    function escapeHtml(str) {
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function moneyFromCents(cents) {
      if (typeof cents !== 'number') return '';
      return '$' + (cents / 100).toFixed(2);
    }

    function getRecentProducts() {
      try {
        var parsed = JSON.parse(localStorage.getItem(RECENT_KEY) || '[]');
        return Array.isArray(parsed) ? parsed : [];
      } catch (e) {
        return [];
      }
    }

    function saveRecentProducts(items) {
      localStorage.setItem(RECENT_KEY, JSON.stringify(items.slice(0, 4)));
    }

    function addCurrentProductToRecent() {
      var productJson = document.querySelector('[data-current-product-json]');
      if (!productJson) return;

      try {
        var currentProduct = JSON.parse(productJson.textContent);
        if (!currentProduct || !currentProduct.id) return;

        var items = getRecentProducts().filter(function(item) {
          return item.id !== currentProduct.id;
        });

        items.unshift(currentProduct);
        saveRecentProducts(items);
      } catch (e) {}
    }

    addCurrentProductToRecent();

    wrappers.forEach(function(wrapper) {
      var form = wrapper.querySelector('.header-search__form');
      var input = wrapper.querySelector('.header-search__input');
      var dropdown = wrapper.querySelector('.custom-search-dropdown');
      var resultsContainer = wrapper.querySelector('[data-search-results]');
      var featuredPanel = wrapper.querySelector('[data-featured-panel]');
      var productsTitle = wrapper.querySelector('[data-search-products-title]');
      var featuredTitle = wrapper.querySelector('[data-featured-title]');
      var debounceTimer = null;
      var activeController = null;
      var defaultFeaturedHtml = featuredPanel ? featuredPanel.innerHTML : '';

      if (!form || !input || !dropdown || !resultsContainer || !productsTitle) return;

      function openDropdown() {
        dropdown.hidden = false;
      }

      function closeDropdown() {
        dropdown.hidden = true;
      }

      function renderRecentProducts() {
        var items = getRecentProducts();

        productsTitle.textContent = 'Recently Viewed Products';

        if (featuredTitle) {
          featuredTitle.textContent = 'ㅤ';
        }

        if (!items.length) {
          resultsContainer.innerHTML = '<div class="custom-search-dropdown__empty">No recently viewed products yet.</div>';
          if (featuredPanel) featuredPanel.innerHTML = defaultFeaturedHtml;
          return;
        }

        resultsContainer.innerHTML = items.map(function(product) {
          var imageHtml = product.image
            ? '<img src="' + escapeHtml(product.image) + '" alt="' + escapeHtml(product.title) + '">'
            : '';

          return (
            '<a href="' + escapeHtml(product.url) + '" class="custom-search-dropdown__product">' +
              imageHtml +
              '<span>' + escapeHtml(product.title) + '</span>' +
            '</a>'
          );
        }).join('');

        if (featuredPanel) {
          featuredPanel.innerHTML = defaultFeaturedHtml;
        }
      }

      function renderProducts(products, query) {
        productsTitle.textContent = 'Products';

        if (featuredTitle) {
          featuredTitle.textContent = 'Featured Product';
        }

        if (!products || !products.length) {
          resultsContainer.innerHTML = '<div class="custom-search-dropdown__empty">No products found for "' + escapeHtml(query) + '".</div>';
          if (featuredPanel) featuredPanel.innerHTML = '';
          return;
        }

        resultsContainer.innerHTML = products.slice(0, 4).map(function(product) {
          var imageHtml = '';
          if (product.featured_image && product.featured_image.url) {
            imageHtml = '<img src="' + escapeHtml(product.featured_image.url) + '&width=240" alt="' + escapeHtml(product.title) + '">';
          }

          return (
            '<a href="' + escapeHtml(product.url) + '" class="custom-search-dropdown__product">' +
              imageHtml +
              '<span>' + escapeHtml(product.title) + '</span>' +
            '</a>'
          );
        }).join('');

        if (featuredPanel) {
          var featured = products[0];
          var featuredImage = '';
          var featuredPrice = '';

          if (featured.featured_image && featured.featured_image.url) {
            featuredImage = '<img src="' + escapeHtml(featured.featured_image.url) + '&width=400" alt="' + escapeHtml(featured.title) + '">';
          }

          if (typeof featured.price === 'number') {
            featuredPrice = '<p>' + moneyFromCents(featured.price) + '</p>';
          }

          featuredPanel.innerHTML =
            '<a href="' + escapeHtml(featured.url) + '" class="custom-search-dropdown__featured">' +
              featuredImage +
              '<strong>' + escapeHtml(featured.title) + '</strong>' +
              featuredPrice +
            '</a>';
        }
      }

      function fetchPredictiveResults(query) {
        if (!query.trim()) {
          renderRecentProducts();
          return;
        }

        if (activeController) {
          activeController.abort();
        }

        activeController = new AbortController();

        var url = '/search/suggest.json?q=' + encodeURIComponent(query) +
          '&resources[type]=product' +
          '&resources[limit]=6';

        fetch(url, {
          signal: activeController.signal,
          headers: {
            'Accept': 'application/json'
          }
        })
          .then(function(response) {
            if (!response.ok) {
              throw new Error('Predictive search failed');
            }
            return response.json();
          })
          .then(function(data) {
            var products = (data.resources && data.resources.results && data.resources.results.products) ? data.resources.results.products : [];
            renderProducts(products, query);
          })
          .catch(function(error) {
            if (error.name === 'AbortError') return;
            console.error(error);
          });
      }

      input.addEventListener('focus', function() {
        openDropdown();
        if (!input.value.trim()) {
          renderRecentProducts();
        }
      });

      input.addEventListener('click', function(e) {
        e.stopPropagation();
        openDropdown();
        if (!input.value.trim()) {
          renderRecentProducts();
        }
      });

      input.addEventListener('input', function() {
        var query = input.value;

        openDropdown();
        clearTimeout(debounceTimer);

        debounceTimer = setTimeout(function() {
          fetchPredictiveResults(query);
        }, 220);
      });

      form.addEventListener('click', function(e) {
        e.stopPropagation();
      });

      dropdown.addEventListener('click', function(e) {
        e.stopPropagation();
      });

      document.addEventListener('click', function(e) {
        if (!wrapper.contains(e.target)) {
          closeDropdown();
        }
      });

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          closeDropdown();
        }
      });

      renderRecentProducts();
    });
  })();
</script>