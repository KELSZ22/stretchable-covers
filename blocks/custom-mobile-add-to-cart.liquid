{% liquid
  assign product = closest.product
%}

<button
  type="submit"
  name="add"
  class="custom-mobile-add-to-cart-button"
  {% unless can_add_to_cart %}
    disabled
  {% endunless %}
>
  {{ add_to_cart_text }}
</button>

{% stylesheet %}
  .custom-mobile-add-to-cart-button {
    width: 100%;
    height: 60px;
    min-height: 60px;
    border: 0;
    border-radius: 9999px;
    background: #123A6B;
    color: #FFFFFF;
    font-family: Lato;
    font-size: 20px;
    font-weight: 400;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    text-transform: none;
    cursor: pointer;
  }

  .custom-mobile-add-to-cart-button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Custom Mobile Add to Cart",
  "tag": null,
  "settings": []
}
{% endschema %}