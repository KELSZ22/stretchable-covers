
<div
  class="
    custom-contact-details
    spacing-style size-style
    {% if block.settings.inherit_color_scheme == false %}color-{{ block.settings.color_scheme }}{% endif %}
  "
  style="
    {% render 'spacing-style', settings: block.settings %}
    {% render 'size-style', settings: block.settings %}
  "
  {{ block.shopify_attributes }}
>
  {%- if block.settings.heading != blank -%}
    <h2 class="custom-contact-details__heading">{{ block.settings.heading | escape }}</h2>
  {%- endif -%}
  {%- if block.settings.subheading != blank -%}
    <p class="custom-contact-details__subheading">{{ block.settings.subheading | escape }}</p>
  {%- endif -%}

  <ul class="custom-contact-details__list" role="list">
    <li class="custom-contact-details__row">
      <div
        class="custom-contact-details__icon"
        style="--custom-contact-details-icon-bg: {{ block.settings.icon_background }};"
        aria-hidden="true"
      >
        {{- 'icon-contact-address.svg' | inline_asset_content -}}
      </div>
      <div class="custom-contact-details__body">
        {%- if block.settings.row_1_label != blank -%}
          <span class="custom-contact-details__label">{{ block.settings.row_1_label | escape }}</span>
        {%- endif -%}
        {%- if block.settings.row_1_text != blank -%}
          <span class="custom-contact-details__value">{{ block.settings.row_1_text | escape }}</span>
        {%- endif -%}
      </div>
    </li>

    <li class="custom-contact-details__row">
      <div
        class="custom-contact-details__icon"
        style="--custom-contact-details-icon-bg: {{ block.settings.icon_background }};"
        aria-hidden="true"
      >
        {{- 'icon-contact-phone.svg' | inline_asset_content -}}
      </div>
      <div class="custom-contact-details__body">
        {%- if block.settings.row_2_label != blank -%}
          <span class="custom-contact-details__label">{{ block.settings.row_2_label | escape }}</span>
        {%- endif -%}
        {%- if block.settings.row_2_text != blank -%}
          <span class="custom-contact-details__value">
            {%- if block.settings.link_telephone -%}
              {%- assign tel_href = block.settings.row_2_text | strip | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', '' | replace: '.', '' -%}
              <a href="tel:{{ tel_href | escape }}" class="custom-contact-details__link">{{ block.settings.row_2_text | escape }}</a>
            {%- else -%}
              {{ block.settings.row_2_text | escape }}
            {%- endif -%}
          </span>
        {%- endif -%}
      </div>
    </li>

    <li class="custom-contact-details__row custom-contact-details__row--last">
      <div
        class="custom-contact-details__icon"
        style="--custom-contact-details-icon-bg: {{ block.settings.icon_background }};"
        aria-hidden="true"
      >
        {{- 'icon-contact-clock.svg' | inline_asset_content -}}
      </div>
      <div class="custom-contact-details__body">
        {%- if block.settings.row_3_label != blank -%}
          <span class="custom-contact-details__label">{{ block.settings.row_3_label | escape }}</span>
        {%- endif -%}
        {%- if block.settings.row_3_text != blank -%}
          <span class="custom-contact-details__value">{{ block.settings.row_3_text | escape }}</span>
        {%- endif -%}
      </div>
    </li>
  </ul>
</div>

{% stylesheet %}
  .custom-contact-details {
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg);
    width: var(--size-style-width, 100%);
    max-width: 100%;
    min-width: 0;
  }

  .section-content-wrapper.layout-panel-flex--row:has(.custom-contact-details):has(.contact-form-container) > * {
    min-width: 0;
    flex: 1 1 calc((100% - var(--gap, 0px)) / 2);
    max-width: calc((100% - var(--gap, 0px)) / 2);
  }

  .section-content-wrapper.layout-panel-flex--row:has(.custom-contact-details):has(.contact-form-container)
    :is(.custom-contact-details, .contact-form-container) {
    width: 100%;
    max-width: 100%;
  }

  @media screen and (max-width: 749px) {
    .section-content-wrapper.mobile-column:has(.custom-contact-details):has(.contact-form-container) > * {
      flex: 1 1 100%;
      max-width: 100%;
      width: 100%;
    }
    .custom-contact-heading {
      font-size: 24px;
    }
    .custom-contact-subheading {
      font-size: 14px;
    }
  }
  

  .custom-contact-details__heading {
    font-family: Raleway;
    font-size: 32px;
    font-weight: 800;
    line-height: 36px;
    letter-spacing: var(--font-h2--letter-spacing);
    color: rgb(var(--color-foreground-rgb));
    margin: 0;
  }

  .custom-contact-details__subheading {
    font-family: var(--font-paragraph--family);
    font-size:16px;
    line-height: var(--font-paragraph--line-height);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
    margin: calc(var(--gap-xs) * -1) 0 0;
  }

  .custom-contact-details__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .custom-contact-details__row {
    display: flex;
    align-items: center;
    gap: var(--gap-lg);
    padding-block: var(--padding-lg);
    border-bottom: 1px solid #3C404329;
  }

  .custom-contact-details__row--last {
    border-bottom: none;
    padding-bottom: 0;
  }

  .custom-contact-details__icon {
    padding: 15px;
    flex-shrink: 0;
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--custom-contact-details-icon-bg,#0F2E53);
  }

  .custom-contact-details__icon svg {
    width: 1.75rem;
    height: 1.75rem;
    display: block;
  }

  .custom-contact-details__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  .custom-contact-details__label {
    font-family: var(--font-paragraph--family);
    font-size: 14px;
    line-height: var(--line-height--body-tight);
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }

  .custom-contact-details__value {
    font-family: var(--font-paragraph--family);
    font-size: 16px;
    font-weight: 400;
    line-height: var(--line-height--body-normal);
    color: rgb(var(--color-foreground-rgb));
  }

  .custom-contact-details__link {
    color: inherit;
    text-decoration: none;
  }

  .custom-contact-details__link:hover {
    text-decoration: underline;
  }
    @media screen and (max-width: 749px) {
    .custom-contact-details__heading {
      font-size: 24px;
      text-align: center;
    }
    .custom-contact-details__subheading {
      font-size: 14px;
      text-align: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact details",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:content.heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:names.heading",
      "default": "Reach Us today!"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:names.subheading",
      "default": "We're here to help you every step of the way."
    },
    {
      "type": "header",
      "content": "Address"
    },
    {
      "type": "text",
      "id": "row_1_label",
      "label": "t:settings.label",
      "default": "Address"
    },
    {
      "type": "textarea",
      "id": "row_1_text",
      "label": "t:settings.text",
      "default": "12508 Dover Road, Reisterstown, MD 21136 USA"
    },
    {
      "type": "header",
      "content": "Telephone"
    },
    {
      "type": "text",
      "id": "row_2_label",
      "label": "t:settings.label",
      "default": "Telephone"
    },
    {
      "type": "text",
      "id": "row_2_text",
      "label": "t:settings.text",
      "default": "(01) 410-561-0800"
    },
    {
      "type": "checkbox",
      "id": "link_telephone",
      "label": "Link telephone number",
      "default": true
    },
    {
      "type": "header",
      "content": "Store hours"
    },
    {
      "type": "text",
      "id": "row_3_label",
      "label": "t:settings.label",
      "default": "Store Hours"
    },
    {
      "type": "text",
      "id": "row_3_text",
      "label": "t:settings.text",
      "default": "10AM-6PM USA Eastern Time"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "icon_background",
      "label": "t:settings.icon_background",
      "default": "#0A1F44"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width_desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Contact details"
    }
  ]
}
{% endschema %}
