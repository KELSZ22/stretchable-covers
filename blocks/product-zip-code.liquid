<div class="zip-code-field" {{ block.shopify_attributes }}>
    <div class="zip-label">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M11.6667 15V4.99998C11.6667 4.55795 11.4912 4.13403 11.1786 3.82147C10.866 3.50891 10.4421 3.33331 10.0001 3.33331H3.33341C2.89139 3.33331 2.46746 3.50891 2.1549 3.82147C1.84234 4.13403 1.66675 4.55795 1.66675 4.99998V14.1666C1.66675 14.3877 1.75455 14.5996 1.91083 14.7559C2.06711 14.9122 2.27907 15 2.50008 15H4.16675" stroke="#1F1F1F" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M12.5 15H7.5" stroke="#1F1F1F" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M15.8334 15H17.5001C17.7211 15 17.9331 14.9122 18.0893 14.7559C18.2456 14.5997 18.3334 14.3877 18.3334 14.1667V11.125C18.3331 10.9359 18.2684 10.7525 18.1501 10.605L15.2501 6.98002C15.1721 6.88242 15.0733 6.80359 14.9608 6.74935C14.8482 6.69512 14.725 6.66687 14.6001 6.66669H11.6667" stroke="#1F1F1F" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M14.1667 16.6666C15.0871 16.6666 15.8333 15.9205 15.8333 15C15.8333 14.0795 15.0871 13.3333 14.1667 13.3333C13.2462 13.3333 12.5 14.0795 12.5 15C12.5 15.9205 13.2462 16.6666 14.1667 16.6666Z" stroke="#1F1F1F" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M5.83341 16.6666C6.75389 16.6666 7.50008 15.9205 7.50008 15C7.50008 14.0795 6.75389 13.3333 5.83341 13.3333C4.91294 13.3333 4.16675 14.0795 4.16675 15C4.16675 15.9205 4.91294 16.6666 5.83341 16.6666Z" stroke="#1F1F1F" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <strong>Know exactly when it arrives!</strong>
    </div>
    <input
        id="zip-code-{{ section.id }}"
        class="zip-code-input"
        type="number"
        name="properties[ZIP]"
        placeholder="Enter ZIP Code"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
        pattern="^(?(^00000(|-0000))|(\d{5}(|-\d{4})))$"
    >
    <div>
        <p>Production time is <strong>15 to 20 WORKING DAYS</strong>.</p>
    </div>
</div>

{% style %}
    .zip-label {
        display: flex; 
        gap: 5px;
        align-items: center;
    }
    .zip-label>* {
        margin: 0;
    }
    .zip-code-field>* {
        margin-bottom: 10px;
    }
    .zip-code-field {
        margin-top: 20px;
    }
    .zip-code-field p {
    font-size: 12px;
    font-family: Lato !important;
}
.zip-label strong {
    font-size: 14px;
    font-family: Lato !important;
}
    .zip-code-input {
        width: auto;
        padding: 10px;
        background: none;
        outline: none;
        box-shadow: none;
        border: 1px solid #C5C5C5;
        border-radius: 8px;
    }
    .zip-code-input::placeholder {
        color: #C5C5C5;
        opacity: 1;
    }
    .zip-code-input:focus,
    .zip-code-input:focus-visible {
        background: none;
        outline: none;
        box-shadow: none;
    }
{% endstyle %}

{% schema %}
{
  "name": "ZIP Code",
  "tag": null,
  "settings": [],
  "presets": [
    {
        "name": "ZIP Code",
    }
  ]
}
{% endschema %}