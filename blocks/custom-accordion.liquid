<style>
  #CustomAccordion-{{ block.id }} {
    width: 100%;
    margin-top: -13px;
  }

  #CustomAccordion-{{ block.id }} .custom-faq-accordion__toggle {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 0 0 12px;
    border: 0;
    border-bottom: 1px solid #cfcfcf;
    background: transparent;
    color: inherit;
    cursor: pointer;
    text-align: left;
    box-shadow: none;
  }

  #CustomAccordion-{{ block.id }} .custom-faq-accordion__heading {
    display: block;
    margin: 0;
    font-size: 16px;
    line-height: 1.2;
    font-weight: 600;
    color: #111111;
  }

  #CustomAccordion-{{ block.id }} .custom-faq-accordion__header-icon {
    position: relative;
    width: 24px;
    min-width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
    border-radius: 50%;
    flex: 0 0 24px;
    border: 1px solid transparent;
    transition: background 0.25s ease, border-color 0.25s ease;
  }

  #CustomAccordion-{{ block.id }}.is-open .custom-faq-accordion__header-icon {
    background: transparent;

  }

  #CustomAccordion-{{ block.id }} .custom-faq__icon {
    position: relative;
    width: 24px;
    min-width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
    border-radius: 50%;
    flex: 0 0 24px;
    border: 1px solid transparent;
    transition: background 0.25s ease, border-color 0.25s ease;
  }

  #CustomAccordion-{{ block.id }} .custom-faq__item.is-open .custom-faq__icon {
    background: transparent;
    border-color: #5F5F5F;
  }

  #CustomAccordion-{{ block.id }} .custom-faq-accordion__icon-svg,
  #CustomAccordion-{{ block.id }} .custom-faq__icon-svg {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transform: translate(-50%, -50%);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  #CustomAccordion-{{ block.id }} .custom-faq-accordion__icon-svg svg,
  #CustomAccordion-{{ block.id }} .custom-faq__icon-svg svg {
    display: block;
  }

  #CustomAccordion-{{ block.id }} .custom-faq-accordion__icon-svg--open,
  #CustomAccordion-{{ block.id }} .custom-faq__icon-svg--open {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.9);
  }

  #CustomAccordion-{{ block.id }} .custom-faq-accordion__icon-svg--closed,
  #CustomAccordion-{{ block.id }} .custom-faq__icon-svg--closed {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  #CustomAccordion-{{ block.id }}.is-open .custom-faq-accordion__icon-svg--closed,
  #CustomAccordion-{{ block.id }} .custom-faq__item.is-open .custom-faq__icon-svg--closed {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.9);
  }

  #CustomAccordion-{{ block.id }}.is-open .custom-faq-accordion__icon-svg--open,
  #CustomAccordion-{{ block.id }} .custom-faq__item.is-open .custom-faq__icon-svg--open {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  #CustomAccordion-{{ block.id }} .custom-faq-accordion__body {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    visibility: hidden;
    transition:
      grid-template-rows 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.35s ease,
      visibility 0.35s ease;
  }

  #CustomAccordion-{{ block.id }}.is-open .custom-faq-accordion__body {
    grid-template-rows: 1fr;
    opacity: 1;
    visibility: visible;
  }

  #CustomAccordion-{{ block.id }} .custom-faq-accordion__body-inner {
    overflow: hidden;
    transform: translateY(-10px);
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  #CustomAccordion-{{ block.id }}.is-open .custom-faq-accordion__body-inner {
    transform: translateY(0);
  }

  #CustomAccordion-{{ block.id }} .custom-faq-accordion__items {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-top: 20px;
  }

  #CustomAccordion-{{ block.id }} .custom-faq__item {
    border-radius: 4px;
    overflow: hidden;
    background: #0F2E53;
    transition: background 0.35s ease;
  }

  #CustomAccordion-{{ block.id }} .custom-faq__item.is-open {
    background: #F3F4F5;
  }

  #CustomAccordion-{{ block.id }} .custom-faq__trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 16px;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    text-align: left;
    box-shadow: none;
  }

  #CustomAccordion-{{ block.id }} .custom-faq__question {
    display: block;
    font-size: 16px;
    line-height: 1.4;
    font-weight: 600;
    color: #ffffff;
    transition: color 0.35s ease;
  }

  #CustomAccordion-{{ block.id }} .custom-faq__item.is-open .custom-faq__question {
    color: #1c1c1c;
  }

  #CustomAccordion-{{ block.id }} .custom-faq__content {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    visibility: hidden;
    transition:
      grid-template-rows 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.3s ease,
      visibility 0.3s ease;
  }

  #CustomAccordion-{{ block.id }} .custom-faq__item.is-open .custom-faq__content {
    grid-template-rows: 1fr;
    opacity: 1;
    visibility: visible;
  }

  #CustomAccordion-{{ block.id }} .custom-faq__panel {
    overflow: hidden;
  }

  #CustomAccordion-{{ block.id }} .custom-faq__panel-inner {
    padding: 0 16px 18px;
    color: #5F5F5F;
    font-size: 14px;
    line-height: 1.6;
    transform: translateY(-8px);
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  #CustomAccordion-{{ block.id }} .custom-faq__item.is-open .custom-faq__panel-inner {
    transform: translateY(0);
  }

  #CustomAccordion-{{ block.id }} .custom-faq__panel p {
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    #CustomAccordion-{{ block.id }} .custom-faq__trigger {
      padding: 16px 14px;
    }

    #CustomAccordion-{{ block.id }} .custom-faq__panel-inner {
      padding: 0 14px 16px;
    }
  }
</style>

<script>
  (function () {
    function initCustomFaqAccordion(scope) {
      var accordions = (scope || document).querySelectorAll('[data-custom-accordion]');

      accordions.forEach(function (accordion) {
        if (accordion.dataset.accordionReady === 'true') return;
        accordion.dataset.accordionReady = 'true';

        var groupToggle = accordion.querySelector('.custom-faq-accordion__toggle');
        var items = accordion.querySelectorAll('.custom-faq__item');

        if (groupToggle) {
          groupToggle.addEventListener('click', function () {
            var isGroupOpen = accordion.classList.contains('is-open');

            if (isGroupOpen) {
              accordion.classList.remove('is-open');
              groupToggle.setAttribute('aria-expanded', 'false');
            } else {
              accordion.classList.add('is-open');
              groupToggle.setAttribute('aria-expanded', 'true');
            }
          });
        }

        items.forEach(function (item) {
          var trigger = item.querySelector('.custom-faq__trigger');
          if (!trigger) return;

          trigger.addEventListener('click', function (event) {
            event.stopPropagation();

            var isOpen = item.classList.contains('is-open');

            items.forEach(function (accordionItem) {
              var accordionTrigger = accordionItem.querySelector('.custom-faq__trigger');
              accordionItem.classList.remove('is-open');

              if (accordionTrigger) {
                accordionTrigger.setAttribute('aria-expanded', 'false');
              }
            });

            if (!isOpen) {
              item.classList.add('is-open');
              trigger.setAttribute('aria-expanded', 'true');
            }
          });
        });
      });
    }

    document.addEventListener('DOMContentLoaded', function () {
      initCustomFaqAccordion(document);
    });

    document.addEventListener('shopify:section:load', function (event) {
      initCustomFaqAccordion(event.target);
    });

    document.addEventListener('shopify:block:select', function (event) {
      initCustomFaqAccordion(event.target);
    });
  })();
</script>

