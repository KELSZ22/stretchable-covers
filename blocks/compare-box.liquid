{% liquid
  assign product = closest.product
  assign current_variant = product.selected_or_first_available_variant
  assign current_image = product.featured_image | default: product.images.first
  assign testimonial_count = 0

  assign current_compare_title = block.settings.current_product_value
  if current_compare_title == blank
    if current_variant.title != blank and current_variant.title != 'Default Title'
      assign current_compare_title = current_variant.title
    else
      assign current_compare_title = product.title
    endif
  endif

  assign current_table_price = block.settings.table_price_value
  if current_table_price == blank
    assign current_table_price = current_variant.price | default: product.price | money
  endif

  if block.settings.quote != blank
    assign testimonial_count = testimonial_count | plus: 1
  endif

  if block.settings.quote_2 != blank
    assign testimonial_count = testimonial_count | plus: 1
  endif

  if block.settings.quote_3 != blank
    assign testimonial_count = testimonial_count | plus: 1
  endif

  if block.settings.compare_collection != blank
    assign compare_catalog = block.settings.compare_collection
  else
    assign compare_catalog = collections.all
  endif
%}

<div
  id="CompareBox-{{ block.id }}"
  class="product-compare-box"
  data-compare-box
  {{ block.shopify_attributes }}
>
  <script type="application/json" data-current-product-json>
    {
      "handle": {{ product.handle | json }},
      "title": {{ product.title | json }},
      "url": {{ product.url | json }},
      "vendor": {{ product.vendor | json }},
      "type": {{ product.type | json }},
      "available": {{ current_variant.available | default: product.available | json }},
      "sku": {{ current_variant.sku | default: '' | json }},
      "variant_title": {{ current_variant.title | default: '' | json }},
      "price": {{ current_variant.price | default: product.price | json }},
      "description": {{ product.description | strip_html | strip_newlines | truncate: 180 | json }},
      "image": {% if current_image != blank %}{{ current_image | image_url: width: 720 | json }}{% else %}""{% endif %},
      "image_alt": {% if current_image != blank %}{{ current_image.alt | default: product.title | json }}{% else %}{{ product.title | json }}{% endif %}
    }
  </script>

  <script type="application/json" data-compare-defaults-json>
    {
      "product_value": {{ current_compare_title | json }},
      "table_price_value": {{ current_table_price | json }},
      "colors": {{ block.settings.colors_value | json }},
      "imprint": {{ block.settings.imprint_value | json }},
      "imprint_sizes": {{ block.settings.imprint_sizes_value | json }},
      "materials": {{ block.settings.materials_value | json }},
      "country_origin": {{ block.settings.country_origin_value | json }},
      "product_badge": {{ block.settings.product_badge | json }},
      "modal_rating_text": {{ block.settings.modal_rating_text | json }},
      "dimension_label": {{ block.settings.dimension_label | json }},
      "dimension_value": {{ block.settings.dimension_value | json }}
    }
  </script>

  <div class="product-compare-box__top">
    {% if block.settings.heading != blank %}
      <div class="product-compare-box__heading">
        {{ block.settings.heading }}
      </div>
    {% endif %}

    <button
      type="button"
      class="product-compare-box__button"
      data-compare-modal-open
      aria-controls="CompareModal-{{ block.id }}"
      aria-expanded="false"
    >
      <span class="product-compare-box__button-icon" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M14 8C14 6.4087 13.3679 4.88258 12.2426 3.75736C11.1174 2.63214 9.5913 2 8 2C6.32263 2.00631 4.71265 2.66082 3.50667 3.82667L2 5.33333" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M2 2V5.33333H5.33333" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M2 8C2 9.5913 2.63214 11.1174 3.75736 12.2426C4.88258 13.3679 6.4087 14 8 14C9.67737 13.9937 11.2874 13.3392 12.4933 12.1733L14 10.6667" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M10.6667 10.6666H14.0001V14" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <span>{{ block.settings.button_label }}</span>
    </button>
  </div>

  {% if testimonial_count > 0 %}
    <div
      class="product-compare-box__slider"
      data-compare-slider
      data-autoplay="{{ block.settings.autoplay }}"
      data-autoplay-speed="{{ block.settings.autoplay_speed | times: 1000 }}"
    >
      <div class="product-compare-box__viewport">
        <div class="product-compare-box__track" data-compare-track>
          {% if block.settings.quote != blank %}
            <div class="product-compare-box__slide" aria-hidden="false">
              <div class="product-compare-box__quote">
                "{{ block.settings.quote }}"
              </div>

              <div class="product-compare-box__meta">
                {% if block.settings.author != blank %}
                  <span class="product-compare-box__author">{{ block.settings.author }}</span>
                {% endif %}

                <div class="product-compare-box__reviews">
                  <div class="product-compare-box__stars" aria-label="{{ block.settings.star_count }} out of 5 stars">
                    {% for i in (1..5) %}
                      <svg class="product-compare-box__star {% if i <= block.settings.star_count %}is-filled{% endif %}" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 14 14" fill="none">
                        <path d="M7 1.16699L8.80166 4.81765L12.8333 5.40515L9.91666 8.24683L10.605 12.2618L7 10.3668L3.395 12.2618L4.08333 8.24683L1.16666 5.40515L5.19833 4.81765L7 1.16699Z" fill="currentColor"/>
                      </svg>
                    {% endfor %}
                  </div>

                  {% if block.settings.review_label != blank %}
                    <span class="product-compare-box__review-label">{{ block.settings.review_label }}</span>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endif %}

          {% if block.settings.quote_2 != blank %}
            <div class="product-compare-box__slide" aria-hidden="true">
              <div class="product-compare-box__quote">
                "{{ block.settings.quote_2 }}"
              </div>

              <div class="product-compare-box__meta">
                {% if block.settings.author_2 != blank %}
                  <span class="product-compare-box__author">{{ block.settings.author_2 }}</span>
                {% endif %}

                <div class="product-compare-box__reviews">
                  <div class="product-compare-box__stars" aria-label="{{ block.settings.star_count_2 }} out of 5 stars">
                    {% for i in (1..5) %}
                      <svg class="product-compare-box__star {% if i <= block.settings.star_count_2 %}is-filled{% endif %}" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 14 14" fill="none">
                        <path d="M7 1.16699L8.80166 4.81765L12.8333 5.40515L9.91666 8.24683L10.605 12.2618L7 10.3668L3.395 12.2618L4.08333 8.24683L1.16666 5.40515L5.19833 4.81765L7 1.16699Z" fill="currentColor"/>
                      </svg>
                    {% endfor %}
                  </div>

                  {% if block.settings.review_label_2 != blank %}
                    <span class="product-compare-box__review-label">{{ block.settings.review_label_2 }}</span>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endif %}

          {% if block.settings.quote_3 != blank %}
            <div class="product-compare-box__slide" aria-hidden="true">
              <div class="product-compare-box__quote">
                "{{ block.settings.quote_3 }}"
              </div>

              <div class="product-compare-box__meta">
                {% if block.settings.author_3 != blank %}
                  <span class="product-compare-box__author">{{ block.settings.author_3 }}</span>
                {% endif %}

                <div class="product-compare-box__reviews">
                  <div class="product-compare-box__stars" aria-label="{{ block.settings.star_count_3 }} out of 5 stars">
                    {% for i in (1..5) %}
                      <svg class="product-compare-box__star {% if i <= block.settings.star_count_3 %}is-filled{% endif %}" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 14 14" fill="none">
                        <path d="M7 1.16699L8.80166 4.81765L12.8333 5.40515L9.91666 8.24683L10.605 12.2618L7 10.3668L3.395 12.2618L4.08333 8.24683L1.16666 5.40515L5.19833 4.81765L7 1.16699Z" fill="currentColor"/>
                      </svg>
                    {% endfor %}
                  </div>

                  {% if block.settings.review_label_3 != blank %}
                    <span class="product-compare-box__review-label">{{ block.settings.review_label_3 }}</span>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endif %}
        </div>
      </div>

      {% if testimonial_count > 1 %}
        <button type="button" class="product-compare-box__nav product-compare-box__nav--prev" data-compare-prev aria-label="Previous testimonial">
          <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 10 10" fill="none">
            <path d="M6.5 1.5L3 5L6.5 8.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        <button type="button" class="product-compare-box__nav product-compare-box__nav--next" data-compare-next aria-label="Next testimonial">
          <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 10 10" fill="none">
            <path d="M3.5 1.5L7 5L3.5 8.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      {% endif %}
    </div>
  {% endif %}

  <dialog
    id="CompareModal-{{ block.id }}"
    class="product-compare-modal"
    data-compare-modal
    aria-labelledby="CompareModalTitle-{{ block.id }}"
  >
    <button
      type="button"
      class="product-compare-modal__dismiss-sheet"
      data-compare-modal-close
      aria-label="Close compare modal"
      tabindex="-1"
    ></button>

    <div class="product-compare-modal__dialog" tabindex="-1">
      <div class="product-compare-modal__header">
        <h3 id="CompareModalTitle-{{ block.id }}" class="product-compare-modal__title">
          {{ block.settings.modal_heading }}
        </h3>

        <button
          type="button"
          class="product-compare-modal__close"
          data-compare-modal-close
          aria-label="Close compare modal"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 22 22" fill="none">
            <path d="M5.5 5.5L16.5 16.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
            <path d="M16.5 5.5L5.5 16.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
          </svg>
        </button>
      </div>

      <div class="product-compare-modal__body">
        <div class="product-compare-modal__hero" data-compare-hero>
          <div class="product-compare-modal__product-hero product-compare-modal__product-hero--current">
            <div class="product-compare-modal__current-media">
              {% if current_image != blank %}
                <img
                  src="{{ current_image | image_url: width: 360 }}"
                  alt="{{ current_image.alt | default: product.title | escape }}"
                  loading="lazy"
                  width="180"
                  height="180"
                >
              {% else %}
                <div class="product-compare-modal__image-placeholder">No image</div>
              {% endif %}

              {% if block.settings.product_badge != blank %}
                <span class="product-compare-modal__badge">{{ block.settings.product_badge }}</span>
              {% endif %}
            </div>

            <div class="product-compare-modal__current-info">
              <div class="product-compare-modal__rating-row">
                <div class="product-compare-modal__stars" aria-label="{{ block.settings.modal_star_count }} out of 5 stars">
                  {% for i in (1..5) %}
                    <svg class="product-compare-modal__star {% if i <= block.settings.modal_star_count %}is-filled{% endif %}" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 14 14" fill="none">
                      <path d="M7 1.16699L8.80166 4.81765L12.8333 5.40515L9.91666 8.24683L10.605 12.2618L7 10.3668L3.395 12.2618L4.08333 8.24683L1.16666 5.40515L5.19833 4.81765L7 1.16699Z" fill="currentColor"/>
                    </svg>
                  {% endfor %}
                </div>

                {% if block.settings.modal_rating_text != blank %}
                  <span class="product-compare-modal__rating-text">{{ block.settings.modal_rating_text }}</span>
                {% endif %}
              </div>

              <div class="product-compare-modal__product-title">
                {{ product.title }}
              </div>

              {% if block.settings.dimension_value != blank %}
                <div class="product-compare-modal__dimension">
                  <span>{{ block.settings.dimension_label }}</span>

                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                    <circle cx="9" cy="9" r="7.25" stroke="currentColor" stroke-width="1.3"/>
                    <path d="M5.75 12.25L12.25 5.75" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                  </svg>

                  <span>{{ block.settings.dimension_value }}</span>
                </div>
              {% endif %}

              <div class="product-compare-modal__current-price">
                {{ current_variant.price | default: product.price | money }}
              </div>
            </div>
          </div>

          <div class="product-compare-modal__right-slot" data-compare-right-slot>
            <div class="product-compare-modal__search-card" data-compare-search-card>
              <div class="product-compare-modal__search-title">
                {{ block.settings.search_title }}
              </div>

              <div class="product-compare-modal__search-wrap">
                <label class="visually-hidden" for="CompareSelect-{{ block.id }}">
                  Select product to compare
                </label>

                <select
                  id="CompareSelect-{{ block.id }}"
                  class="product-compare-modal__select"
                  data-compare-product-select
                >
                  <option value="" disabled selected>
                    {{ block.settings.search_placeholder }}
                  </option>

                  {% paginate compare_catalog.products by 250 %}
                    {% for compare_product in compare_catalog.products %}
                      {% if compare_product.handle != product.handle %}
                        <option value="{{ compare_product.handle }}">
                          {{ compare_product.title }}
                        </option>
                      {% endif %}
                    {% endfor %}
                  {% endpaginate %}
                </select>
              </div>

              <div class="product-compare-modal__selected-preview" data-compare-selected-preview hidden></div>
            </div>
          </div>
        </div>

        <div class="product-compare-modal__table-wrap">
          <table class="product-compare-modal__table">
            <colgroup>
              <col class="product-compare-modal__table-col product-compare-modal__table-col--label">
              <col class="product-compare-modal__table-col product-compare-modal__table-col--current">
              <col class="product-compare-modal__table-col product-compare-modal__table-col--compare">
            </colgroup>

            <thead class="product-compare-modal__thead-hidden">
              <tr>
                <th scope="col">Field</th>
                <th scope="col">Current product</th>
                <th scope="col">Selected product</th>
              </tr>
            </thead>

            <tbody>
              <tr>
                <th scope="row">Product</th>
                <td>{{ current_compare_title }}</td>
                <td data-compare-field="title">-</td>
              </tr>

              <tr>
                <th scope="row">Price</th>
                <td>{{ current_table_price }}</td>
                <td data-compare-field="price">-</td>
              </tr>

              <tr>
                <th scope="row">Colors</th>
                <td>{{ block.settings.colors_value }}</td>
                <td data-compare-field="colors">-</td>
              </tr>

              <tr>
                <th scope="row">Imprint</th>
                <td>{{ block.settings.imprint_value }}</td>
                <td data-compare-field="imprint">-</td>
              </tr>

              <tr>
                <th scope="row">Imprint Sizes</th>
                <td>{{ block.settings.imprint_sizes_value }}</td>
                <td data-compare-field="imprint_sizes">-</td>
              </tr>

              <tr>
                <th scope="row">Materials</th>
                <td>{{ block.settings.materials_value }}</td>
                <td data-compare-field="materials">-</td>
              </tr>

              <tr>
                <th scope="row">Country of Origin</th>
                <td>{{ block.settings.country_origin_value }}</td>
                <td data-compare-field="country_origin">-</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </dialog>
</div>

{% stylesheet %}
  body.compare-modal-open {
    overflow: hidden;
  }

  .product-compare-box,
  .product-compare-box * {
    box-sizing: border-box;
  }

  .product-compare-box .visually-hidden,
  .product-compare-modal .visually-hidden {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  .product-compare-box {
    background: #F3F4F5;
    border-radius: 12px;
    padding: 18px;
    margin-top: 16px;
    position: relative;
  }

  .product-compare-box__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 14px;
    border-bottom: 1px solid #C5C5C5;
    padding-bottom: 16px;
  }

  .product-compare-box__heading {
    font-size: 13px;
    line-height: 18px;
    color: #222222;
    font-weight: 500;
  }

  .product-compare-box__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 38px;
    padding: 10px 16px;
    border-radius: 999px;
    background: #0F2E53;
    color: #ffffff;
    text-decoration: none;
    border: 1px solid #0F2E53;
    font-size: 12px;
    line-height: 12px;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    transition: 0.25s ease;
    font-family: Lato, sans-serif;
  }

  .product-compare-box__button:hover {
    background: #0f3158;
    border-color: #0f3158;
    color: #ffffff;
  }

  .product-compare-box__button-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .product-compare-box__slider {
    position: relative;
  }

  .product-compare-box__viewport {
    overflow: hidden;
  }

  .product-compare-box__track {
    display: flex;
    transition: transform 0.35s ease;
    will-change: transform;
  }

  .product-compare-box__slide {
    min-width: 100%;
    width: 100%;
    padding: 4px 50px 0;
    box-sizing: border-box;
  }

  .product-compare-box__quote {
    font-size: 14px;
    line-height: 18px;
    color: #222222;
    margin-bottom: 10px;
    font-family: Lato, sans-serif;
    font-style: italic;
    font-weight: 700;
  }

  .product-compare-box__meta {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
  }

  .product-compare-box__author {
    font-size: 14px;
    line-height: 16px;
    font-weight: 400;
    font-family: Lato, sans-serif;
  }

  .product-compare-box__reviews {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .product-compare-box__stars {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    color: #d0d0d0;
  }

  .product-compare-box__star.is-filled {
    color: #f5b301;
  }

  .product-compare-box__review-label {
    font-size: 12px;
    line-height: 16px;
    color: #444444;
  }

  .product-compare-box__nav {
    position: absolute;
    top: 42%;
    transform: translateY(-50%);
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid #0F2E53;
    background: #ffffff;
    color: #0F2E53;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: 0.25s ease;
    padding: 0;
    z-index: 2;
  }

  .product-compare-box__nav:hover {
    background: #0F2E53;
    color: #ffffff;
  }

  .product-compare-box__nav--prev {
    left: 0;
  }

  .product-compare-box__nav--next {
    right: 0;
  }

  dialog.product-compare-modal {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 16px;
    border: none;
    background: transparent;
    color: inherit;
    box-sizing: border-box;
    overflow: hidden;
    z-index: 999999;
  }

  dialog.product-compare-modal::backdrop {
    background: rgba(0, 0, 0, 0.78);
  }

  dialog.product-compare-modal[open] {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
    place-items: center;
  }

  dialog.product-compare-modal:not([open]) {
    display: none;
  }

  .product-compare-modal__dismiss-sheet {
    grid-column: 1;
    grid-row: 1;
    z-index: 0;
    place-self: stretch;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    cursor: pointer;
  }

  .product-compare-modal__dialog {
    grid-column: 1;
    grid-row: 1;
    z-index: 1;
    position: relative;
    width: min(1050px, calc(100vw - 32px));
    height: min(628px, calc(100vh - 32px));
    margin: 0;
    background: #ffffff;
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 0;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.22);
    font-family: Lato, Arial, sans-serif;
  }

  .product-compare-modal__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 24px 24px 0;
    flex-shrink: 0;
  }

  .product-compare-modal__title {
    margin: 0;
    color: #0F2E53;
    font-family: Lato, sans-serif;
    font-size: 24px;
    font-style: normal;
    font-weight: 800;
    line-height: 28px;
    letter-spacing: -0.02em;
    text-transform: none;
  }

  .product-compare-modal__close {
    width: 34px;
    height: 34px;
    border: 1px solid #d5dbe2;
    background: #ffffff;
    color: #555555;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: 0.25s ease;
    padding: 0;
    flex-shrink: 0;
  }

  .product-compare-modal__close svg {
    width: 17px;
    height: 17px;
  }

  .product-compare-modal__close:hover {
    background: #0F2E53;
    border-color: #0F2E53;
    color: #ffffff;
  }

  .product-compare-modal__body {
    padding: 0 24px 28px;
    flex: 1 1 auto;
    min-height: 0;
    overflow: auto;
    -webkit-overflow-scrolling: touch;
  }

  .product-compare-modal__hero {
