{% endstylesheet %}

<script>
  (function () {
    function initCompareBoxSliders(root) {
      const scope = root || document;

      scope.querySelectorAll('[data-compare-slider]').forEach((slider) => {
        if (slider.dataset.initialized === 'true') {
          return;
        }

        const track = slider.querySelector('[data-compare-track]');

        if (!track) {
          return;
        }

        const slides = Array.from(track.children);
        const prevButton = slider.querySelector('[data-compare-prev]');
        const nextButton = slider.querySelector('[data-compare-next]');
        const autoplayEnabled = slider.dataset.autoplay === 'true';
        const autoplaySpeed = parseInt(slider.dataset.autoplaySpeed, 10) || 5000;

        let currentIndex = 0;
        let autoplayInterval = null;

        function updateSlider() {
          track.style.transform = 'translateX(-' + (currentIndex * 100) + '%)';

          slides.forEach((slide, index) => {
            slide.setAttribute('aria-hidden', index === currentIndex ? 'false' : 'true');
          });
        }

        function goToSlide(index) {
          if (!slides.length) {
            return;
          }

          currentIndex = (index + slides.length) % slides.length;
          updateSlider();
        }

        function startAutoplay() {
          if (!autoplayEnabled || slides.length <= 1) {
            return;
          }

          stopAutoplay();

          autoplayInterval = window.setInterval(() => {
            goToSlide(currentIndex + 1);
          }, autoplaySpeed);
        }

        function stopAutoplay() {
          if (autoplayInterval) {
            window.clearInterval(autoplayInterval);
            autoplayInterval = null;
          }
        }

        if (prevButton) {
          prevButton.addEventListener('click', () => {
            goToSlide(currentIndex - 1);
            startAutoplay();
          });
        }

        if (nextButton) {
          nextButton.addEventListener('click', () => {
            goToSlide(currentIndex + 1);
            startAutoplay();
          });
        }

        slider.addEventListener('mouseenter', stopAutoplay);
        slider.addEventListener('mouseleave', startAutoplay);
        slider.addEventListener('focusin', stopAutoplay);
        slider.addEventListener('focusout', startAutoplay);

        updateSlider();
        startAutoplay();

        slider.dataset.initialized = 'true';
      });
    }

    function initCompareModals(root) {
      const scope = root || document;
      const shopCurrency = {{ cart.currency.iso_code | default: localization.country.currency.iso_code | default: shop.currency | json }};

      scope.querySelectorAll('[data-compare-box]').forEach((box) => {
        if (box.dataset.compareModalInit === 'true') {
          return;
        }

        const modal = box.querySelector('[data-compare-modal]');
        const openButton = box.querySelector('[data-compare-modal-open]');
        const closeButtons = box.querySelectorAll('[data-compare-modal-close]');
        const dialog = modal ? modal.querySelector('.product-compare-modal__dialog') : null;
        const rightSlot = modal ? modal.querySelector('[data-compare-right-slot]') : null;
        const rightSlotInitialHtml = rightSlot ? rightSlot.innerHTML : '';
        let selectedPreview = rightSlot ? rightSlot.querySelector('[data-compare-selected-preview]') : null;
        const currentProductScript = box.querySelector('[data-current-product-json]');
        const defaultsScript = box.querySelector('[data-compare-defaults-json]');
        const currentProduct = currentProductScript ? JSON.parse(currentProductScript.textContent) : null;
        const compareDefaults = defaultsScript ? JSON.parse(defaultsScript.textContent) : {};
        const compareFields = modal ? modal.querySelectorAll('[data-compare-field]') : [];

        let lastFocusedElement = null;
        let productSelect = rightSlot ? rightSlot.querySelector('[data-compare-product-select]') : null;

        if (!modal || !openButton || !dialog || !productSelect || !rightSlot || !currentProduct) {
          return;
        }

        function escapeHtml(value) {
          return String(value || '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
        }

        function stripHtml(value) {
          const temp = document.createElement('div');
          temp.innerHTML = value || '';
          return (temp.textContent || temp.innerText || '').replace(/\s+/g, ' ').trim();
        }

        function normalizeVariantTitle(value) {
          if (!value || value === 'Default Title') {
            return '';
          }

          return value;
        }

        function formatMoney(cents) {
          const numeric = Number(cents || 0);

          try {
            return new Intl.NumberFormat(undefined, {
              style: 'currency',
              currency: shopCurrency
            }).format(numeric / 100);
          } catch (error) {
            return '$' + (numeric / 100).toFixed(2);
          }
        }

        function productUrl(product) {
          if (product.url) {
            return product.url;
          }

          return (window.Shopify && window.Shopify.routes && window.Shopify.routes.root ? window.Shopify.routes.root : '/') + 'products/' + product.handle;
        }

        function normalizeAjaxProduct(product) {
          const firstAvailableVariant = Array.isArray(product.variants)
            ? product.variants.find((variant) => variant.available) || product.variants[0]
            : null;

          const image = product.featured_image || (Array.isArray(product.images) && product.images.length ? product.images[0] : '');

          return {
            handle: product.handle || '',
            title: product.title || '',
            url: productUrl(product),
            vendor: product.vendor || '',
            type: product.type || '',
            available: firstAvailableVariant ? !!firstAvailableVariant.available : !!product.available,
            sku: firstAvailableVariant && firstAvailableVariant.sku ? firstAvailableVariant.sku : '',
            variant_title: firstAvailableVariant && firstAvailableVariant.title ? firstAvailableVariant.title : '',
            price: firstAvailableVariant && typeof firstAvailableVariant.price !== 'undefined'
              ? firstAvailableVariant.price
              : (typeof product.price_min !== 'undefined' ? product.price_min : product.price || 0),
            description: stripHtml(product.description || '').slice(0, 180) || '',
            image: image || '',
            image_alt: product.title || ''
          };
        }

        function resetComparisonTable() {
          compareFields.forEach((field) => {
            field.textContent = '-';
          });
        }

        function resetRightSlot() {
          rightSlot.innerHTML = rightSlotInitialHtml;
          productSelect = rightSlot.querySelector('[data-compare-product-select]');
          selectedPreview = rightSlot.querySelector('[data-compare-selected-preview]');
        }

        function clearSelectedPreview() {
          if (!selectedPreview) {
            return;
          }

          selectedPreview.innerHTML = '';
          selectedPreview.hidden = true;
        }

        function renderStars() {
          let stars = '';

          for (let i = 1; i <= 5; i++) {
            stars += '<svg class="product-compare-modal__star is-filled" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 14 14" fill="none"><path d="M7 1.16699L8.80166 4.81765L12.8333 5.40515L9.91666 8.24683L10.605 12.2618L7 10.3668L3.395 12.2618L4.08333 8.24683L1.16666 5.40515L5.19833 4.81765L7 1.16699Z" fill="currentColor"/></svg>';
          }

          return stars;
        }

        function renderSelectedHero(product) {
          if (!selectedPreview) {
            return;
          }

          const imageMarkup = product.image
            ? '<img src="' + escapeHtml(product.image) + '" alt="' + escapeHtml(product.image_alt || product.title) + '" loading="lazy" width="180" height="180">'
            : '<div class="product-compare-modal__image-placeholder">No image</div>';

          selectedPreview.innerHTML =
            '<div class="product-compare-modal__selected-hero">' +
              '<div class="product-compare-modal__current-media">' +
                imageMarkup +
                (compareDefaults.product_badge ? '<span class="product-compare-modal__badge">' + escapeHtml(compareDefaults.product_badge) + '</span>' : '') +
              '</div>' +
              '<div class="product-compare-modal__current-info">' +
                '<div class="product-compare-modal__rating-row">' +
                  '<div class="product-compare-modal__stars" aria-label="5 out of 5 stars">' + renderStars() + '</div>' +
                  (compareDefaults.modal_rating_text ? '<span class="product-compare-modal__rating-text">' + escapeHtml(compareDefaults.modal_rating_text) + '</span>' : '') +
                '</div>' +
                '<div class="product-compare-modal__product-title">' + escapeHtml(product.title || 'Untitled product') + '</div>' +
                '<div class="product-compare-modal__dimension">' +
                  '<span>' + escapeHtml(compareDefaults.dimension_label || 'Diameter') + '</span>' +
                  '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><circle cx="9" cy="9" r="7.25" stroke="currentColor" stroke-width="1.3"/><path d="M5.75 12.25L12.25 5.75" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>' +
                  '<span>' + escapeHtml(compareDefaults.dimension_value || '') + '</span>' +
                '</div>' +
                '<div class="product-compare-modal__current-price">' + escapeHtml(formatMoney(product.price)) + '</div>' +
              '</div>' +
            '</div>';

          selectedPreview.hidden = false;

          const searchTitle = rightSlot.querySelector('.product-compare-modal__search-title');
          const searchWrap = rightSlot.querySelector('.product-compare-modal__search-wrap');

          if (searchTitle) {
            searchTitle.remove();
          }

          if (searchWrap) {
            searchWrap.remove();
          }
        }

        function updateComparison(product) {
          const productDisplayName = compareDefaults.product_value || normalizeVariantTitle(product.variant_title) || product.title || '-';

          const map = {
            title: productDisplayName,
            price: compareDefaults.table_price_value || formatMoney(product.price),
            colors: compareDefaults.colors || '-',
            imprint: compareDefaults.imprint || '-',
            imprint_sizes: compareDefaults.imprint_sizes || '-',
            materials: compareDefaults.materials || '-',
            country_origin: compareDefaults.country_origin || '-'
          };

          compareFields.forEach((field) => {
            const key = field.dataset.compareField;
            field.textContent = typeof map[key] !== 'undefined' ? map[key] : '-';
          });
        }

        async function loadCompareProduct(handle) {
          const response = await fetch((window.Shopify && window.Shopify.routes && window.Shopify.routes.root ? window.Shopify.routes.root : '/') + 'products/' + encodeURIComponent(handle) + '.js', {
            headers: {
              Accept: 'application/json'
            }
          });

          if (!response.ok) {
            throw new Error('Unable to load product.');
          }

          const ajaxProduct = await response.json();
          const normalized = normalizeAjaxProduct(ajaxProduct);

          renderSelectedHero(normalized);
          updateComparison(normalized);
        }

        async function onProductSelect(event) {
          const select = event && event.target
            ? event.target.closest('[data-compare-product-select]')
            : productSelect;
          const handle = select ? select.value : '';

          if (!handle) {
            return;
          }

          try {
            await loadCompareProduct(handle);

            if (select) {
              select.value = handle;
            }
          } catch (error) {
            if (select) {
              select.value = '';
            }

            clearSelectedPreview();
            resetComparisonTable();
          }
        }

        function openModal() {
          if (modal.open) {
            return;
          }

          lastFocusedElement = document.activeElement;

          if (typeof modal.showModal !== 'function') {
            return;
          }

          try {
            modal.showModal();
          } catch (e) {
            return;
          }

          document.body.classList.add('compare-modal-open');
          openButton.setAttribute('aria-expanded', 'true');
          dialog.focus();
        }

        function closeModal() {
          if (!modal.open) {
            return;
          }

          if (typeof modal.close === 'function') {
            modal.close();
          }
        }

        modal.addEventListener('close', function () {
          document.body.classList.remove('compare-modal-open');
          openButton.setAttribute('aria-expanded', 'false');
          resetRightSlot();
          clearSelectedPreview();
          resetComparisonTable();

          if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
            lastFocusedElement.focus();
          }
        });

        openButton.addEventListener('click', openModal);

        closeButtons.forEach((button) => {
          button.addEventListener('click', closeModal);
        });

        rightSlot.addEventListener('change', onProductSelect);

        box.dataset.compareModalInit = 'true';
      });
    }

    document.addEventListener('DOMContentLoaded', function () {
      initCompareBoxSliders(document);
      initCompareModals(document);
    });

    document.addEventListener('shopify:section:load', function (event) {
      initCompareBoxSliders(event.target);
      initCompareModals(event.target);
    });

    document.addEventListener('shopify:block:select', function (event) {
      const section = event.target.closest('.shopify-section');
      initCompareBoxSliders(section || document);
      initCompareModals(section || document);
    });
  })();
</script>

