/* custom css */
@media screen and (min-width: 590px) {
    .variant-picker__form {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }
    .variant-option+.variant-option {
        margin-top: 0;
    }
}
