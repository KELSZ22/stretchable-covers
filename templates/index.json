    "custom_hero_slider_7GLFPm": {
      "type": "custom-hero-slider",
      "blocks": {
        "testimonial_mWeM96": {
          "type": "testimonial",
          "settings": {
            "testimonial_text": "WOW!!  You guys are awesome!  I'm so glad I found you.  You're at the very top of my list of excellent companies. The bell covers arrived and are perfect!  Just what we needed for our community band's 100th anniversary.  Will send photos after the celebration.  Thanks again",
            "testimonial_author": "Cathy Powell",
            "testimonial_role": "",
            "testimonial_verified": "Verified Buyer"
          }
        },
        "testimonial_WXAMpW": {
          "type": "testimonial",
          "settings": {
            "testimonial_text": "Love the waterproof exam stool covers! Just got them today from shipping and receiving. Thank you so much for your patience with me as me moved through this process! We'll be ordering many more.",
            "testimonial_author": "Marilyn Thomas",
            "testimonial_role": "University Health Care System",
            "testimonial_verified": "Verified Buyer"
          }
        },
        "testimonial_cU3Adb": {
          "type": "testimonial",
          "settings": {
            "testimonial_text": "The FANTASTIC covers arrived today, and I couldn't be happier with them. They are brilliant. Good quality fabric, stitching, and printing. Thank you for a quality product! And I am glad to see you promoting 'Made in the USA.' Here in Australia, my family and many of my friends and colleagues are attempting to support Made in Australia. How else do we keep jobs in our own country?\n\nI know I will be the centre of attention with these covers. When I end up with other bands, I will contact you again to get more covers!!",
            "testimonial_author": "Sue Bradley",
            "testimonial_role": "",
            "testimonial_verified": "Verified Buyer"
          }
        },
        "testimonial_3BxgcC": {
          "type": "testimonial",
          "settings": {
            "testimonial_text": "I just wanted to send a quick email about my order - I received the shipment today with my printed sousaphone covers and wanted to provide you with some positive feedback:\n\nI was blown away by how good they look! I put one of them on my sousaphone, and it looks fantastic. I wasn't sure how well the artwork I provided would look once it was actually printed, but the artwork came out great.\n\nI can't believe how fast y'all got them printed, shipped, and delivered to me.  I will definitely recommend you to the other sousa players in our band and to players in the Austin community.\n\nThanks again for providing fantastic customer service!",
            "testimonial_author": "Gary Cox",
            "testimonial_role": "",
            "testimonial_verified": "Verified Buyer"
          }
        },
        "testimonial_xinTAX": {
          "type": "testimonial",
          "settings": {
            "testimonial_text": "You totally blew me away! Thank you so much for getting that done and to me in time for our event!! Definitely such a pleasure buying from you and I am so happy with the final product!! Keep up the amazing work! And thank you again for everything! You’re a great guy! Have a fantastic holiday weekend!!\nThanks a million!",
            "testimonial_author": "SheenaRodebaugh",
            "testimonial_role": "",
            "testimonial_verified": "Verified Buyer"
          }
        },
