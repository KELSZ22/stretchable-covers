    "custom_section_testimonial_aGKFWw": {
      "type": "custom-section-testimonial",
      "blocks": {
        "testimonial_EqBHXC": {
          "type": "testimonial",
          "settings": {
            "quote": "WOW!! You guys are awesome! I'm so glad I found you. You are the very top of my list of excellent companies. The bell covers arrived and are perfect! Just what we needed for our community band's 100th anniversary. We can't put to words the celebration. Thanks again!",
            "author": "Cathy Powell",
            "role": "University Health Care System"
          }
        },
        "testimonial_jTHrrp": {
          "type": "testimonial",
          "settings": {
            "quote": "Love the waterproof exam stool covers! Just got them today from shipping and receiving. Thank you so much for your patience with me as me moved through this process! We'll be ordering many more.",
            "author": "Marilyn Thomas",
            "role": "University Health Care System"
          }
        },
        "testimonial_7iNcqG": {
          "type": "testimonial",
          "settings": {
            "quote": "The FANTASTIC covers arrived today, and I couldn't be happier with them. They are brilliant. Good quality fabric, stitching, and printing. Thank you for a quality product! And I am glad to see you promoting 'Made in the USA.' Here in Australia, my family and many of my friends and colleagues are attempting to support Made in Australia. How else do we keep jobs in our own country?\n\nI know I will be the centre of attention with these covers. When I end up with other bands, I will contact you again to get more covers!!",
            "author": "Sue Bradley",
            "role": ""
          }
        },
        "testimonial_Ti9dRe": {
          "type": "testimonial",
          "settings": {
            "quote": "I just wanted to send a quick email about my order - I received the shipment today with my printed sousaphone covers and wanted to provide you with some positive feedback:\n\nI was blown away by how good they look! I put one of them on my sousaphone, and it looks fantastic. I wasn't sure how well the artwork I provided would look once it was actually printed, but the artwork came out great.\n\nI can't believe how fast y'all got them printed, shipped, and delivered to me.  I will definitely recommend you to the other sousa players in our band and to players in the Austin community.\n\nThanks again for providing fantastic customer service!",
            "author": "Gary Cox",
            "role": ""
          }
        },
        "testimonial_DwA6yg": {
          "type": "testimonial",
          "settings": {
            "quote": "You totally blew me away! Thank you so much for getting that done and to me in time for our event!! Definitely such a pleasure buying from you and I am so happy with the final product!! Keep up the amazing work! And thank you again for everything! You’re a great guy! Have a fantastic holiday weekend!!\nThanks a million!",
            "author": "Sheena Rodebaugh",
            "role": ""
          }
        },
        "testimonial_Rxx3k9": {
          "type": "testimonial",
          "settings": {
            "quote": "OMG!! Are you a magician?! That's amazing, and they're GORGEOUS! THANK YOU!!!",
            "author": "Cynthia Stanton",
            "role": ""
          }
        },
        "testimonial_ga8gYW": {
          "type": "testimonial",
          "settings": {
            "quote": "Thank you so much.  I received my Sousaphone covers today and they are PERFECT. Absolutely what I was looking for.\nThe material is great and goes on the instruments so easily. I just love them.\nI will be sure to tell other bands about Stretchable Covers. I can't wait to show them off.\nSuper job. Thanks!",
            "author": "Melita Quesada",
            "role": ""
          }
        },
        "testimonial_7NLLUM": {
          "type": "testimonial",
          "settings": {
            "quote": "Received the covers yesterday and they are wonderful. Thank you for all of your help. \nAs a retired band director, I appreciate your fast service and the ability to order less than 10. \nHopefully we can work together with another cash strapped program in the future. Again, we really appreciate you.",
            "author": "Sue Cechal",
            "role": ""
          }
        },
        "testimonial_NzgwM3": {
          "type": "testimonial",
          "settings": {
            "quote": "The cover looks great as usual. I appreciate the quick turnaround.",
            "author": "Kayla Bright",
            "role": "Knox County Middle School, Cheerleading StateChampions"
          }
        },
        "testimonial_TXLmGN": {
          "type": "testimonial",
          "settings": {
            "quote": "Ordered 2 bell covers to see how they were in both printing and sizing. They were perfect and the kids loved them. \nNeeded 3 more and wanted them before our next game so I placed my order on Sunday. I emailed the company and got a response before they opened Monday morning. I was told it'll be handled. They weren't lying. Within a few hours I had order confirmation and shipping confirmation with upgraded shipping to get them to me a day early. \nTo say that they prioritize customer service and satisfaction over anything else is an understatement. My order was pretty small but it still mattered and that is awesome. \nI wish more businesses operated like this these days. Will definitely be ordering from this company next time. Thank you!",
            "author": "Joe Stevenson",
            "role": ""
          }
        },
        "testimonial_Ka8xLf": {
          "type": "testimonial",
          "settings": {
            "quote": "I love working with you guys!",
            "author": "Shawn Tretter",
            "role": "(Brass Animals)"
          }
        },
        "testimonial_HWHNNm": {
          "type": "testimonial",
          "settings": {
            "quote": "Paul, I do believe I’ve already said to you that you ROCK!  \nIs there another word equally expressive that connotes something like “you’re the best” or “gee whiz, you are SOOOO responsive”?\nI’m thinking that “thank you, Paul” truly expresses my admiration for your skills, so . . . .\n . . .  thank you!",
            "author": "Lee Urban",
            "role": ""
          }
        },
        "testimonial_4zPTxk": {
          "type": "testimonial",
          "settings": {
            "quote": "Thank you Paul! I really appreciate your great customer service!  I am very excited about these covers.  It was a pleasure talking with you today. Thanks so much for your help. Many Thanks",
            "author": "Joyce Leonard",
            "role": ""
          }
        },
        "testimonial_zYhntm": {
          "type": "testimonial",
          "settings": {
            "quote": "Hey Paul,\n\nThanks for the emails and keeping me up to date. Seriously, awesome efficiency! \nBig thank you!",
            "author": "Dan Di Marzo",
            "role": ""
          }
        },
        "testimonial_PET4aJ": {
          "type": "testimonial",
          "settings": {
            "quote": "WOW!! You guys are awesome! I'm so glad I found you. You are the very top of my list of excellent companies. The bell covers arrived and are perfect! Just what we needed for our community band's 100th anniversary. We can't put to words the celebration. Thanks again!",
            "author": "Cathy Powell",
            "role": "University Health Care System"
          }
        },
        "testimonial_V4Lr7r": {
          "type": "testimonial",
          "settings": {
            "quote": "The cover looks great as usual. I appreciate the quick turnaround.",
            "author": "Chris Bonura",
            "role": ""
          }
        },
        "testimonial_78mTBN": {
          "type": "testimonial",
          "settings": {
            "quote": "We received the covers today and they look great! Thank you!!",
            "author": "Lizzie Steele - Washington Commanders",
            "role": ""
          }
        },
        "testimonial_dVXhDf": {
          "type": "testimonial",
          "settings": {
            "quote": "Hey Paul,  \n\nThought I'd follow up on the covers we received today. \n\nWe are so absolutely satisfied! Thanks so much for these, great service top to bottom. Pat yourself on the back. \n\nThanks again, we'll be in touch when we need more products. \n\nMany thanks.",
            "author": "Antony Stevens - Strayhorns",
            "role": ""
          }
        },
        "testimonial_HREk3z": {
          "type": "testimonial",
          "settings": {
            "quote": "The new covers have arrived and they look great!!\n\nWhat a legend.  Thanks so much!\"",
            "author": "Simon Czestochowski",
            "role": "Back Chat Brass"
          }
        },
        "testimonial_QbKqqM": {
